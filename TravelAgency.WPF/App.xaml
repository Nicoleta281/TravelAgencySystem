<Application x:Class="TravelAgency.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TravelAgency.WPF.Converters">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:BookingStatusToRomanianConverter x:Key="BookingStatusRoConverter"/>

        <!-- Line up/down: small caps -->
        <Style x:Key="TravelScrollLineButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Delay" Value="300"/>
            <Setter Property="Interval" Value="100"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="Cap"
                                Background="#E2E8F0"
                                CornerRadius="6"
                                Margin="1,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cap" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Cap" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Cap" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Page up/down: invisible hit targets (Track handles layout) -->
        <Style x:Key="TravelScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Avion minimal (profil, nas la dreapta); +90° pe bara verticală = nas în jos -->
        <Geometry x:Key="TravelPlaneSimpleGeometry">M2,16 L34,9 L42,9 L36,17 L28,15 L2,19 Z</Geometry>

        <!-- Vertical thumb: formă simplă + plutire discretă -->
        <Style x:Key="TravelScrollThumbVertical" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBg"
                                MinHeight="34"
                                Width="20"
                                CornerRadius="10"
                                HorizontalAlignment="Center"
                                BorderBrush="#1E40AF"
                                BorderThickness="1"
                                Padding="1,4,1,4">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#38BDF8" Offset="0"/>
                                    <GradientStop Color="#2563EB" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.2" Color="#0F172A"/>
                            </Border.Effect>
                            <Grid>
                                <Rectangle Width="1.5"
                                           Fill="#E0F2FE"
                                           Opacity="0.5"
                                           HorizontalAlignment="Center"
                                           Margin="0,3,0,3"/>
                                <Viewbox x:Name="PlaneBoxV"
                                         Stretch="Uniform"
                                         MaxWidth="16"
                                         MaxHeight="26"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Viewbox.RenderTransform>
                                        <TransformGroup>
                                            <RotateTransform Angle="90"/>
                                            <TranslateTransform Y="0"/>
                                        </TransformGroup>
                                    </Viewbox.RenderTransform>
                                    <Path Data="{StaticResource TravelPlaneSimpleGeometry}"
                                          Fill="#F8FAFC"
                                          Stroke="#0F172A"
                                          StrokeThickness="0.9"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          Width="44"
                                          Height="28"/>
                                </Viewbox>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded" SourceName="ThumbBg">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="PlaneBoxV"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                         From="0"
                                                         To="-2.2"
                                                         Duration="0:0:1.65"
                                                         AutoReverse="True">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBg" Property="BorderBrush" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBg" Property="BorderBrush" Value="#172554"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Horizontal thumb -->
        <Style x:Key="TravelScrollThumbHorizontal" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBg"
                                MinWidth="48"
                                Height="20"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                BorderBrush="#1E40AF"
                                BorderThickness="1"
                                Padding="5,1,5,1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#38BDF8" Offset="0"/>
                                    <GradientStop Color="#2563EB" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.2" Color="#0F172A"/>
                            </Border.Effect>
                            <Viewbox x:Name="PlaneBoxH"
                                     Stretch="Uniform"
                                     MaxHeight="14"
                                     MaxWidth="34"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     RenderTransformOrigin="0.5,0.5">
                                <Viewbox.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform Angle="90"/>
                                        <TranslateTransform Y="0"/>
                                    </TransformGroup>
                                </Viewbox.RenderTransform>
                                <Path Data="{StaticResource TravelPlaneSimpleGeometry}"
                                      Fill="#F8FAFC"
                                      Stroke="#0F172A"
                                      StrokeThickness="0.9"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform"
                                      Width="44"
                                      Height="28"/>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded" SourceName="ThumbBg">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="PlaneBoxH"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                         From="0"
                                                         To="1.6"
                                                         Duration="0:0:1.65"
                                                         AutoReverse="True">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBg" Property="BorderBrush" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBg" Property="BorderBrush" Value="#172554"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="TravelVerticalScrollBarTemplate" TargetType="ScrollBar">
            <Grid SnapsToDevicePixels="True" Width="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="20"/>
                </Grid.RowDefinitions>
                <!-- Pista -->
                <Border Grid.Row="1"
                        Width="8"
                        HorizontalAlignment="Center"
                        Margin="0,3"
                        CornerRadius="4"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Panel.ZIndex="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#F1F5F9" Offset="0"/>
                            <GradientStop Color="#E2E8F0" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <RepeatButton Grid.Row="0"
                              Style="{StaticResource TravelScrollLineButton}"
                              Command="{x:Static ScrollBar.LineUpCommand}">
                    <Path Data="M 4 7 L 7 4 L 10 7"
                          Stroke="#475569"
                          StrokeThickness="1.2"
                          StrokeLineJoin="Round"
                          Fill="Transparent"
                          Stretch="Uniform"
                          Width="10"
                          Height="8"/>
                </RepeatButton>
                <Track x:Name="PART_Track"
                       Grid.Row="1"
                       IsDirectionReversed="True"
                       Focusable="False"
                       Panel.ZIndex="1">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource TravelScrollPageButton}"
                                      Command="{x:Static ScrollBar.PageUpCommand}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource TravelScrollPageButton}"
                                      Command="{x:Static ScrollBar.PageDownCommand}"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource TravelScrollThumbVertical}"/>
                    </Track.Thumb>
                </Track>
                <RepeatButton Grid.Row="2"
                              Style="{StaticResource TravelScrollLineButton}"
                              Command="{x:Static ScrollBar.LineDownCommand}">
                    <Path Data="M 4 4 L 7 7 L 10 4"
                          Stroke="#475569"
                          StrokeThickness="1.2"
                          StrokeLineJoin="Round"
                          Fill="Transparent"
                          Stretch="Uniform"
                          Width="10"
                          Height="8"/>
                </RepeatButton>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="TravelHorizontalScrollBarTemplate" TargetType="ScrollBar">
            <Grid SnapsToDevicePixels="True" Height="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="1"
                        Height="8"
                        VerticalAlignment="Center"
                        Margin="3,0"
                        CornerRadius="4"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Panel.ZIndex="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#F1F5F9" Offset="0"/>
                            <GradientStop Color="#E2E8F0" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <RepeatButton Grid.Column="0"
                              Style="{StaticResource TravelScrollLineButton}"
                              Command="{x:Static ScrollBar.LineLeftCommand}">
                    <Path Data="M 7 4 L 4 7 L 7 10"
                          Stroke="#475569"
                          StrokeThickness="1.2"
                          StrokeLineJoin="Round"
                          Fill="Transparent"
                          Stretch="Uniform"
                          Width="8"
                          Height="10"/>
                </RepeatButton>
                <Track x:Name="PART_Track"
                       Grid.Column="1"
                       IsDirectionReversed="False"
                       Focusable="False"
                       Panel.ZIndex="1">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource TravelScrollPageButton}"
                                      Command="{x:Static ScrollBar.PageLeftCommand}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource TravelScrollPageButton}"
                                      Command="{x:Static ScrollBar.PageRightCommand}"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource TravelScrollThumbHorizontal}"/>
                    </Track.Thumb>
                </Track>
                <RepeatButton Grid.Column="2"
                              Style="{StaticResource TravelScrollLineButton}"
                              Command="{x:Static ScrollBar.LineRightCommand}">
                    <Path Data="M 4 4 L 7 7 L 4 10"
                          Stroke="#475569"
                          StrokeThickness="1.2"
                          StrokeLineJoin="Round"
                          Fill="Transparent"
                          Stretch="Uniform"
                          Width="8"
                          Height="10"/>
                </RepeatButton>
            </Grid>
        </ControlTemplate>

        <!-- Stil implicit pentru toate ScrollBar-urile din aplicație -->
        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="Template" Value="{StaticResource TravelVerticalScrollBarTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="24"/>
                    <Setter Property="MinHeight" Value="24"/>
                    <Setter Property="Template" Value="{StaticResource TravelHorizontalScrollBarTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
