                                        Command="{Binding RejectBookingCommand}"
                                        Style="{StaticResource DangerPillButton}"
                                        Margin="0,0,8,0"/>
                                <Button Content="Cancel booking"
                                        Command="{Binding CancelBookingCommand}"
                                        Style="{StaticResource ChromePillButton}"
                                        Margin="0,0,8,0"/>
                                <Button Content="Refresh"
                                        Command="{Binding RefreshBookingsCommand}"
                                        Style="{StaticResource ChromePillButton}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- FINANCIAL SETTINGS -->
        <ScrollViewer Visibility="{Binding IsFinancialSection, Converter={StaticResource BoolToVisibilityConverter}}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource AdminScrollBarStyle}"/>
            </ScrollViewer.Resources>
            <Grid Margin="24,24,24,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
