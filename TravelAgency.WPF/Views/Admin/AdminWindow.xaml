                                       Margin="0,4,0,0"/>
                            <TextBlock Text="VAT, global discount and default currency for reports and displays."
                                       FontSize="13"
                                       Foreground="#64748B"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                Content="Back to dashboard"
                                Command="{Binding ShowDashboardCommand}"
                                Style="{StaticResource ChromePillButton}"
                                VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource StereoSheet}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="Parameters"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"/>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="VAT rate (%):"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           Margin="0,0,0,12"/>

                                <TextBox Grid.Row="0"
                                         Grid.Column="1"
                                         Text="{Binding VatRate, UpdateSourceTrigger=PropertyChanged}"
                                         Height="34"
                                         Margin="0,0,0,12"/>

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="Global discount (%):"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           Margin="0,0,0,12"/>

                                <TextBox Grid.Row="1"
                                         Grid.Column="1"
                                         Text="{Binding GlobalDiscount, UpdateSourceTrigger=PropertyChanged}"
                                         Height="34"
                                         Margin="0,0,0,12"/>

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Text="Currency:"
                                           VerticalAlignment="Center"
                                           FontSize="15"/>

                                <ComboBox Grid.Row="2"
                                          Grid.Column="1"
                                          Height="34"
                                          ItemsSource="{Binding AvailableCurrencies}"
                                          SelectedItem="{Binding SelectedCurrency}"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Actions"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#1F2937"
                                       Margin="0,0,0,12"/>

                            <Border Style="{StaticResource CardActionBar}">
                                <StackPanel>
                                    <Button Content="Save financial settings"
                                            Command="{Binding SaveFinancialSettingsCommand}"
                                            Style="{StaticResource PrimarySolidButton}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,0,0,10"/>

                                    <Button Content="Export report"
                                            Style="{StaticResource ChromePillButton}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,0,0,10"/>

                                    <Button Content="View detailed analytics"
                                            Command="{Binding ShowAnalyticsCommand}"
                                            Style="{StaticResource ChromePillButton}"
                                            HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- PACKAGE MODERATION -->
        <ScrollViewer Visibility="{Binding IsPackageModerationSection, Converter={StaticResource BoolToVisibilityConverter}}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource AdminScrollBarStyle}"/>
            </ScrollViewer.Resources>
            <Grid Margin="24,24,24,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,18"
                        Padding="20,14"
                        Background="#FDFEFE"
                        CornerRadius="18"
                        BorderBrush="#E8EDF4"
                        BorderThickness="1"
                        Effect="{StaticResource MagpieCardFloat}">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Travel Agency"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#64748B"/>
                            <TextBlock Text="Package moderation"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="Review packages submitted by agents. Select an item, then approve or reject."
                                       FontSize="13"
                                       Foreground="#64748B"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                Content="Back to dashboard"
                                Command="{Binding ShowDashboardCommand}"
                                Style="{StaticResource ChromePillButton}"
                                VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource StereoSheet}">
                    <StackPanel>
                        <TextBlock Text="Pending packages"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"/>

                        <ListBox ItemsSource="{Binding PendingPackages}"
                                 SelectedItem="{Binding SelectedPackage}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Margin="0,14,0,0"
                                 MinHeight="380"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource AdminScrollBarStyle}"/>
                            </ListBox.Resources>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,12"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12"
                                            CornerRadius="14"
                                            Background="#F9FBFD"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       Foreground="#111827"/>

                                            <TextBlock Text="{Binding Destination, StringFormat=Destination: {0}}"
                                                       Foreground="#6B7280"
                                                       Margin="0,6,0,0"/>

                                            <TextBlock Text="{Binding PeriodText, StringFormat=Period: {0}}"
                                                       Foreground="#6B7280"
                                                       Margin="0,4,0,0"/>

                                            <TextBlock Text="{Binding CreatedByAgent, StringFormat=Created by: {0}}"
                                                       Foreground="#6B7280"
                                                       Margin="0,4,0,0"/>

                                            <TextBlock Text="{Binding Status, StringFormat=Status: {0}}"
                                                       Foreground="#0D9488"
                                                       FontWeight="SemiBold"
                                                       Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Style="{StaticResource CardActionBar}" Margin="0,14,0,0">
                            <StackPanel>
                                <Button Content="Approve"
                                        Command="{Binding ApprovePackageCommand}"
                                        Style="{StaticResource SuccessPillButton}"
                                        HorizontalAlignment="Stretch"
                                        ToolTipService.ToolTip="Approve selected package"/>

                                <Button Content="Reject"
                                        Command="{Binding RejectPackageCommand}"
                                        Style="{StaticResource DangerPillButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,8,0,0"
                                        ToolTipService.ToolTip="Reject selected package"/>

                                <Button Content="Refresh list"
                                        Command="{Binding RefreshDashboardCommand}"
                                        Style="{StaticResource ChromePillButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <ScrollViewer Visibility="{Binding IsAnalyticsSection, Converter={StaticResource BoolToVisibilityConverter}}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource AdminScrollBarStyle}"/>
            </ScrollViewer.Resources>
            <Grid Margin="24,24,24,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,20" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Analytics Reports"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                        <TextBlock Text="Snapshots and live analytics overview"
                                   FontSize="16"
                                   Foreground="#64748B"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right"
                            Content="Back to dashboard"
                            Command="{Binding ShowDashboardCommand}"
                            Style="{StaticResource ChromePillButton}"
                            VerticalAlignment="Top"/>
                </DockPanel>

        <Border Grid.Row="1"
                Style="{StaticResource StereoSheet}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,20" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
               Text="Analytics Overview"
               FontSize="24"
               FontWeight="Bold"
               Foreground="#1F2937"
               VerticalAlignment="Center"/>

                        <Button DockPanel.Dock="Right"
                                Content="Save snapshot"
                                Command="{Binding SaveAnalyticsSnapshotCommand}"
                                Style="{StaticResource PrimarySolidButton}"
                                MinWidth="156"/>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.45*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT SIDE -->
                        <Grid Grid.Column="0" Margin="0,0,18,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1.2*"/>
                                <RowDefinition Height="0.9*"/>
                            </Grid.RowDefinitions>

                            <!-- SNAPSHOT LIST -->
                            <ListBox ItemsSource="{Binding AnalyticsSnapshots}"
                                     SelectedItem="{Binding SelectedSnapshot}"
                                     Height="250"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource AdminScrollBarStyle}"/>
                                </ListBox.Resources>

                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,10"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">

                                            <StackPanel>
                                                <TextBlock Text="{Binding SavedAt, StringFormat=Snapshot - {0:dd.MM.yyyy HH:mm}}"
                               FontWeight="Bold"/>

                                                <TextBlock Text="{Binding TotalRevenue, StringFormat=Revenue: {0:F2} €}"
                               Foreground="Green"/>

                                                <TextBlock Text="{Binding TotalBookings, StringFormat=Bookings: {0}}"/>

                                                <TextBlock Text="{Binding TopDestination, StringFormat=Top destination: {0}}"/>
                                            </StackPanel>

                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>

                            </ListBox>

                            <!-- SELECTED SNAPSHOT DETAILS -->
                            <Border Grid.Row="1"
                Background="#F8FAFC"
                CornerRadius="14"
                Padding="16"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Selected Snapshot"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#334155"/>

                                    <TextBlock Text="Snapshot details preview"
                           FontSize="13"
                           Foreground="#64748B"
                           Margin="0,4,0,14"/>

                                    <Grid Visibility="{Binding HasSelectedSnapshot, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedSnapshot.SavedAtLocal, StringFormat=Saved at: {0:dd.MM.yyyy HH:mm}}"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"/>

                                            <TextBlock Text="{Binding SelectedSnapshot.TotalRevenue, StringFormat=Revenue: {0:F2} €}"
                                   Margin="0,12,0,0"
                                   Foreground="#16A34A"
                                   FontWeight="SemiBold"/>

                                            <TextBlock Text="{Binding SelectedSnapshot.TotalBookings, StringFormat=Bookings: {0}}"
                                   Margin="0,6,0,0"
                                   Foreground="#64748B"/>

                                            <TextBlock Text="{Binding SelectedSnapshot.ConfirmedBookings, StringFormat=Confirmed: {0}}"
                                   Margin="0,6,0,0"
                                   Foreground="#15803D"/>

                                            <TextBlock Text="{Binding SelectedSnapshot.RejectedBookings, StringFormat=Rejected: {0}}"
                                   Margin="0,6,0,0"
                                   Foreground="#DC2626"/>

                                            <TextBlock Text="{Binding SelectedSnapshot.TotalUsers, StringFormat=Users: {0}}"
                                   Margin="0,6,0,0"
                                   Foreground="#64748B"/>

                                            <TextBlock Text="{Binding SelectedSnapshot.TopDestination, StringFormat=Top destination: {0}}"
                                   Margin="0,6,0,0"
                                   Foreground="#0D9488"
                                   FontWeight="SemiBold"/>

                                            <Button Content="Restore snapshot"
                                                    Command="{Binding RestoreAnalyticsSnapshotCommand}"
                                                    Style="{StaticResource InfoPillButton}"
                                                    Margin="0,16,0,0"
                                                    HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Select a snapshot to see details."
                           Foreground="#94A3B8"
                           FontStyle="Italic">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                   
                                                    <DataTrigger Binding="{Binding SelectedSnapshot}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- RIGHT SIDE: LIVE ANALYTICS -->
                        <Border Grid.Column="1"
            Background="#FFFFFF"
            CornerRadius="14"
            Padding="16"
            BorderBrush="#E5E7EB"
            BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Live Analytics"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#334155"/>

                                <TextBlock Text="Current values from the system"
                       FontSize="13"
                       Foreground="#64748B"
                       Margin="0,4,0,12"/>

                                <UniformGrid Columns="3" Margin="0,0,0,12">
                                    <Border Background="#EEF4FF"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="Bookings" Foreground="#6B7280"/>
                                            <TextBlock Text="{Binding LiveAnalytics.TotalBookings}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#ECFDF5"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="Confirmed" Foreground="#6B7280"/>
                                            <TextBlock Text="{Binding LiveAnalytics.ConfirmedBookings}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#15803D"
                                   Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#FEF2F2"
                        CornerRadius="12"
                        Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="Rejected" Foreground="#6B7280"/>
                                            <TextBlock Text="{Binding LiveAnalytics.RejectedBookings}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#DC2626"
                                   Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Background="#F8FAFC"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Revenue"
                               FontWeight="SemiBold"
                               Foreground="#334155"/>
                                        <TextBlock Text="{Binding LiveAnalytics.TotalRevenue, StringFormat={}{0:F2} €}"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#16A34A"
                               Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F8FAFC"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Users"
                               FontWeight="SemiBold"
                               Foreground="#334155"/>
                                        <TextBlock Text="{Binding LiveAnalytics.TotalUsers, StringFormat=Total users: {0}}"
                               Margin="0,8,0,0"/>
                                        <TextBlock Text="{Binding ActiveUsersCount, StringFormat=Active users: {0}}"
                               Margin="0,4,0,0"
                               Foreground="#15803D"/>
                                        <TextBlock Text="{Binding BlockedUsersCount, StringFormat=Blocked users: {0}}"
                               Margin="0,4,0,0"
                               Foreground="#DC2626"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F8FAFC"
                    CornerRadius="12"
                    Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Top Destination"
                               FontWeight="SemiBold"
                               Foreground="#334155"/>
                                        <TextBlock Text="{Binding LiveAnalytics.TopDestination}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#0D9488"
                               Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Grafic comparativ: snapshot selectat vs date live -->
                    <Border Grid.Row="2"
                            Margin="0,22,0,0"
                            Padding="18,16"
                            Background="#F8FAFC"
                            CornerRadius="14"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            Visibility="{Binding HasSelectedSnapshot, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Comparație vizuală: snapshot vs live"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#334155"/>
                            <TextBlock Text="Selectezi un snapshot din listă; barele gri = valori salvate, teal = situația curentă. Scala e separată pentru fiecare metrică."
                                       FontSize="12"
                                       Foreground="#64748B"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,14"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="14" Height="14" CornerRadius="3" Background="#94A3B8" VerticalAlignment="Center"/>
                                <TextBlock Text="Snapshot" Margin="6,0,18,0" VerticalAlignment="Center" FontSize="12" Foreground="#64748B"/>
                                <Border Width="14" Height="14" CornerRadius="3" Background="#0D9488" VerticalAlignment="Center"/>
                                <TextBlock Text="Live" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#64748B"/>
                            </StackPanel>

                            <!-- Bookings -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Rezervări" VerticalAlignment="Bottom" Margin="0,0,8,10" FontWeight="SemiBold" Foreground="#475569"/>
                                <Border Grid.Column="1" Height="124" Background="#EEF2F7" CornerRadius="8" Padding="16,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <Grid Height="120" Width="52">
                                                <Border Width="40" Background="#94A3B8" CornerRadius="6,6,0,0"
                                                        VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                        Height="{Binding AnalyticsBarBookingsSnapshot}"/>
                                            </Grid>
                                            <TextBlock Text="Snapshot" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                            <Grid Height="120" Width="52">
                                                <Border Width="40" Background="#0D9488" CornerRadius="6,6,0,0"
                                                        VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                        Height="{Binding AnalyticsBarBookingsLive}"/>
                                            </Grid>
                                            <TextBlock Text="Live" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Confirmed -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Confirmate" VerticalAlignment="Bottom" Margin="0,0,8,10" FontWeight="SemiBold" Foreground="#15803D"/>
                                <Border Grid.Column="1" Height="124" Background="#ECFDF5" CornerRadius="8" Padding="16,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <Grid Height="120" Width="52">
                                                <Border Width="40" Background="#94A3B8" CornerRadius="6,6,0,0"
                                                        VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                        Height="{Binding AnalyticsBarConfirmedSnapshot}"/>
                                            </Grid>
                                            <TextBlock Text="Snapshot" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                            <Grid Height="120" Width="52">
                                                <Border Width="40" Background="#0D9488" CornerRadius="6,6,0,0"
                                                        VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                        Height="{Binding AnalyticsBarConfirmedLive}"/>
                                            </Grid>
                                            <TextBlock Text="Live" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Rejected -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Respinse" VerticalAlignment="Bottom" Margin="0,0,8,10" FontWeight="SemiBold" Foreground="#DC2626"/>
                                <Border Grid.Column="1" Height="124" Background="#FEF2F2" CornerRadius="8" Padding="16,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <Grid Height="120" Width="52">
                                                <Border Width="40" Background="#94A3B8" CornerRadius="6,6,0,0"
                                                        VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                        Height="{Binding AnalyticsBarRejectedSnapshot}"/>
                                            </Grid>
                                            <TextBlock Text="Snapshot" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                            <Grid Height="120" Width="52">
                                                <Border Width="40" Background="#0D9488" CornerRadius="6,6,0,0"
                                                        VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                        Height="{Binding AnalyticsBarRejectedLive}"/>
                                            </Grid>
                                            <TextBlock Text="Live" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Revenue -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Venit" VerticalAlignment="Bottom" Margin="0,0,8,10" FontWeight="SemiBold" Foreground="#334155"/>
                                <Border Grid.Column="1" Height="124" Background="#F0FDFA" CornerRadius="8" Padding="16,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <Grid Height="120" Width="52">
                                                <Border Width="40" Background="#94A3B8" CornerRadius="6,6,0,0"
