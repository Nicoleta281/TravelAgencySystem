<Window x:Class="TravelAgency.WPF.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:TravelAgency.WPF.Converters"
        mc:Ignorable="d"
        Title="Admin Dashboard"
        Height="800"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Display, Segoe UI, SystemFonts.MessageFontFamily"
        Background="#0B1220">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:CancellationRatePieGeometryConverter x:Key="CancellationRatePieGeometryConverter"/>

        <DrawingBrush x:Key="AdminHexMeshBrush"
                      TileMode="Tile"
                      Viewport="0,0,52,46"
                      ViewportUnits="Absolute"
                      Opacity="0.12">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#5EEAD4" Thickness="0.65"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 26,3 L45,14 L45,34 L26,45 L7,34 L7,14 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B1220" Offset="0"/>
            <GradientStop Color="#0F1B33" Offset="0.55"/>
            <GradientStop Color="#111C35" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0C1929" Offset="0"/>
            <GradientStop Color="#0F2847" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="ElevatedShadow"
                          BlurRadius="28"
                          ShadowDepth="14"
                          Opacity="0.22"
                          Color="#000000"/>

        <!-- Card „floating” ca în mockup-uri dashboard moderne -->
        <DropShadowEffect x:Key="MagpieCardFloat"
                          BlurRadius="26"
                          ShadowDepth="10"
                          Opacity="0.09"
                          Color="#0C4A6E"
                          Direction="270"/>

        <DropShadowEffect x:Key="PillAmbientShadow"
                          BlurRadius="12"
                          ShadowDepth="3"
                          Opacity="0.09"
                          Color="#134E4A"
                          Direction="270"/>

        <LinearGradientBrush x:Key="ChromePillFaceBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F1F5F9" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryButtonFaceBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2DD4BF" Offset="0"/>
            <GradientStop Color="#0D9488" Offset="1"/>
        </LinearGradientBrush>

        <ControlTemplate x:Key="AdminStereoPillTemplate" TargetType="Button">
            <Border x:Name="ShadowHost"
                    Background="Transparent"
                    CornerRadius="13"
                    Padding="0,1,0,2"
                    Effect="{StaticResource PillAmbientShadow}">
                <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="12">
                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True"/>
                </Border>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="ShadowHost" Property="Opacity" Value="0.55"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <LinearGradientBrush x:Key="MainSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F0F9FF" Offset="0"/>
            <GradientStop Color="#E0F2FE" Offset="0.5"/>
            <GradientStop Color="#ECFEFF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="StereoKpiFaceBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F0FDFA" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="StereoSheetFaceBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F8FAFC" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="StereoShelfInsetBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F1F5F9" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="StereoKpiCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Background" Value="{StaticResource StereoKpiFaceBrush}"/>
            <Setter Property="Effect" Value="{StaticResource MagpieCardFloat}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ClipToBounds" Value="False"/>
        </Style>

        <Style x:Key="StereoSheet" TargetType="Border">
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Background" Value="{StaticResource StereoSheetFaceBrush}"/>
            <Setter Property="Effect" Value="{StaticResource MagpieCardFloat}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ClipToBounds" Value="False"/>
        </Style>

        <Style x:Key="CardActionBar" TargetType="Border">
            <Setter Property="Background" Value="#F0FDFA"/>
            <Setter Property="BorderBrush" Value="#CCFBF1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="NavSidebarButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#22FFFFFF"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#3AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#10FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavSidebarButtonActive" TargetType="Button" BasedOn="{StaticResource NavSidebarButton}">
            <Setter Property="Background" Value="#0D9488"/>
            <Setter Property="BorderBrush" Value="#5EEAD4"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#14B8A6"/>
                    <Setter Property="BorderBrush" Value="#99F6E4"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0F766E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChromePillButton" TargetType="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="{StaticResource ChromePillFaceBrush}"/>
            <Setter Property="BorderBrush" Value="#C8D4E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template" Value="{StaticResource AdminStereoPillTemplate}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#94A3B8"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E8EDF5"/>
                    <Setter Property="BorderBrush" Value="#64748B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerPillButton" TargetType="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template" Value="{StaticResource AdminStereoPillTemplate}"/>
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFF1F2" Offset="0"/>
                        <GradientStop Color="#FECACA" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#F87171"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FEE2E2" Offset="0"/>
                                <GradientStop Color="#FCA5A5" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="BorderBrush" Value="#EF4444"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FECACA"/>
                    <Setter Property="BorderBrush" Value="#DC2626"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessPillButton" TargetType="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template" Value="{StaticResource AdminStereoPillTemplate}"/>
            <Setter Property="Foreground" Value="#15803D"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F0FDF4" Offset="0"/>
                        <GradientStop Color="#BBF7D0" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#4ADE80"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#DCFCE7" Offset="0"/>
                                <GradientStop Color="#86EFAC" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="BorderBrush" Value="#22C55E"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#BBF7D0"/>
                    <Setter Property="BorderBrush" Value="#15803D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InfoPillButton" TargetType="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template" Value="{StaticResource AdminStereoPillTemplate}"/>
            <Setter Property="Foreground" Value="#1D4ED8"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F8FAFF" Offset="0"/>
                        <GradientStop Color="#BFDBFE" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#60A5FA"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#EFF6FF" Offset="0"/>
                                <GradientStop Color="#93C5FD" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#93C5FD"/>
                    <Setter Property="BorderBrush" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimarySolidButton" TargetType="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryButtonFaceBrush}"/>
            <Setter Property="BorderBrush" Value="#0F766E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template" Value="{StaticResource AdminStereoPillTemplate}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#14B8A6"/>
                    <Setter Property="BorderBrush" Value="#0D9488"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0F766E"/>
                    <Setter Property="BorderBrush" Value="#134E4A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AdminScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AdminScrollThumbVertical" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="T"
                                MinHeight="28"
                                Width="6"
                                CornerRadius="3"
                                HorizontalAlignment="Center"
                                Background="#94A3B8"
                                Opacity="0.85"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="T" Property="Background" Value="#64748B"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="T" Property="Background" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="AdminVerticalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Width="10" SnapsToDevicePixels="True">
                <Border Width="6"
                        HorizontalAlignment="Center"
                        CornerRadius="3"
                        Background="#1A0F172A"
                        Margin="0,4"/>
                <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource AdminScrollPageButton}"
                                      Command="{x:Static ScrollBar.PageUpCommand}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource AdminScrollPageButton}"
                                      Command="{x:Static ScrollBar.PageDownCommand}"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource AdminScrollThumbVertical}"/>
                    </Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style x:Key="AdminScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template" Value="{StaticResource AdminVerticalScrollBarTemplate}"/>
        </Style>

        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="Background" Value="#CCFFFFFF"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Effect" Value="{StaticResource ElevatedShadow}"/>
        </Style>

        <Style x:Key="AdminDataGridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F0FDFA"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <Style x:Key="ModernDataGridRow" TargetType="DataGridRow">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsSelected" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#ECFEFF"/>
                </MultiTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0F766E"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AdminDataGridTextElement" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}"
                             Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="RowHeight" Value="42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource AdminDataGridColumnHeader}"/>
            <Setter Property="RowStyle" Value="{StaticResource ModernDataGridRow}"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="278"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="#22FFFFFF"
                BorderThickness="0,0,1,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.35" Color="#000000" Direction="270"/>
            </Border.Effect>
            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Top" Margin="22,26,22,8">
                    <TextBlock Text="Travel Agency"
                               Foreground="#94A3B8"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Admin"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,2,0,0"/>
                    <TextBlock Text="Control panel"
                               Foreground="#94A3B8"
                               FontSize="13"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="14,8,14,0">
                    <Button Content="Dashboard"
                            Command="{Binding ShowDashboardCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavSidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDashboardSection}" Value="True">
                                        <Setter Property="Background" Value="#0D9488"/>
                                        <Setter Property="BorderBrush" Value="#5EEAD4"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="User Management"
                            Command="{Binding ShowUserManagementCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavSidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUserManagementSection}" Value="True">
                                        <Setter Property="Background" Value="#0D9488"/>
                                        <Setter Property="BorderBrush" Value="#5EEAD4"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Bookings Control"
                            Command="{Binding ShowBookingsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavSidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBookingsSection}" Value="True">
                                        <Setter Property="Background" Value="#0D9488"/>
                                        <Setter Property="BorderBrush" Value="#5EEAD4"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Analytics Reports"
                            Command="{Binding ShowAnalyticsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavSidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAnalyticsSection}" Value="True">
                                        <Setter Property="Background" Value="#0D9488"/>
                                        <Setter Property="BorderBrush" Value="#5EEAD4"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Financial Settings"
                            Command="{Binding ShowFinancialSettingsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavSidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFinancialSection}" Value="True">
                                        <Setter Property="Background" Value="#0D9488"/>
                                        <Setter Property="BorderBrush" Value="#5EEAD4"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Package Moderation"
                            Command="{Binding ShowPackageModerationCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavSidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPackageModerationSection}" Value="True">
                                        <Setter Property="Background" Value="#0D9488"/>
                                        <Setter Property="BorderBrush" Value="#5EEAD4"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Border DockPanel.Dock="Bottom"
                        Margin="14,16,14,18"
                        Padding="14"
                        CornerRadius="16"
                        Background="#18FFFFFF"
                        BorderBrush="#28FFFFFF"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="46" Height="46">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#E2E8F0" Offset="0"/>
                                    <GradientStop Color="#CBD5E1" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Admin"
                                       Foreground="White"
                                       FontSize="15"
                                       FontWeight="Bold"/>
                            <TextBlock Text="System Administrator"
                                       Foreground="#94A3B8"
                                       FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Main workspace: fundal + pattern hex discret + conținut -->
        <Grid Grid.Column="1">
            <Border Background="{StaticResource MainSurfaceBrush}"/>
