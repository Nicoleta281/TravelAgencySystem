                <Border Grid.Row="0"
                        Margin="0,0,0,18"
                        Padding="20,14"
                        Background="#FDFEFE"
                        CornerRadius="18"
                        BorderBrush="#E8EDF4"
                        BorderThickness="1"
                        Effect="{StaticResource MagpieCardFloat}">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Travel Agency"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#64748B"/>
                            <TextBlock Text="Admin Dashboard"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="Users, revenue, moderation &amp; finance"
                                       FontSize="13"
                                       Foreground="#64748B"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Content="Refresh"
                                    Command="{Binding RefreshDashboardCommand}"
                                    Style="{StaticResource ChromePillButton}"
                                    Margin="0,0,10,0"/>
                            <Button Content="Settings"
                                    Style="{StaticResource ChromePillButton}"
                                    Margin="0,0,10,0"/>
                            <Button Content="Logout"
                                    Command="{Binding LogoutCommand}"
                                    Style="{StaticResource DangerPillButton}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- KPI: raft ancorat + coloane fixe (fără UniformGrid) -->
                <Border Grid.Row="1"
                        Margin="0,0,0,22"
                        CornerRadius="26"
                        Padding="14,12"
                        BorderThickness="1"
                        BorderBrush="#D1D5DB"
                        Background="{StaticResource StereoShelfInsetBrush}"
                        Effect="{StaticResource MagpieCardFloat}"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource StereoKpiCard}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Total users" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TotalUsersCount}"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Margin="0,6,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource StereoKpiCard}" Margin="6,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Pending bookings" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding PendingBookingsCount}"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Margin="0,6,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource StereoKpiCard}" Margin="6,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Monthly revenue" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding MonthlyRevenueText}"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Margin="0,6,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Style="{StaticResource StereoKpiCard}" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Cancellation rate" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CancellationRateText}"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="#DC2626"
                                           Margin="0,6,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- MAIN GRID -->
                <Grid Grid.Row="2" Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- REVENUE / REPORTS -->
                    <Border Grid.Row="0"
                            Style="{StaticResource StereoSheet}"
                            Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Revenue and Reports"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#1F2937"/>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Revenue Trend"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#374151"/>

                                    <Border Height="180"
                                            Margin="0,12,0,0"
                                            CornerRadius="16"
                                            BorderThickness="1"
                                            BorderBrush="#B8C9EC">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#F8FAFF" Offset="0"/>
                                                <GradientStop Color="#E1E9FB" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid ClipToBounds="True">
                                            <Path Data="M 0,120 L 48,72 L 96,96 L 144,40 L 192,64 L 240,48 L 288,80 L 336,56 L 384,88 L 432,52 L 480,70 L 528,45 L 576,78 L 624,50 L 672,68 L 720,42 L 768,75 L 816,55 L 864,82 L 912,48 L 960,65 L 1008,38 L 1056,72"
                                                  Stroke="#0D9488"
                                                  StrokeThickness="3"
                                                  StrokeLineJoin="Round"
                                                  Stretch="Fill"
                                                  VerticalAlignment="Bottom"
                                                  Height="110"
                                                  Margin="12,0,12,18"
                                                  Opacity="0.85"/>
                                            <Path Data="M 0,135 L 60,100 L 120,118 L 180,78 L 240,105 L 300,88 L 360,112 L 420,95 L 480,125 L 540,98 L 600,118 L 660,92 L 720,108 L 780,85 L 840,115 L 900,90 L 960,105 L 1020,82 L 1080,100"
                                                  Stroke="#93C5FD"
                                                  StrokeThickness="2"
                                                  Stretch="Fill"
                                                  VerticalAlignment="Bottom"
                                                  Height="95"
                                                  Margin="12,0,12,12"
                                                  Opacity="0.55"/>
                                            <TextBlock Text="Revenue trend (preview)"
                                                       Foreground="#64748B"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Top"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Margin="0,14,0,0"/>
                                        </Grid>
                                    </Border>

                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Grid.Column="0"
                                                 Width="120"
                                                 Height="120"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center">
                                            <Grid Width="100" Height="100">
                                                <Ellipse Fill="#E0F2FE"
                                                         Stroke="#38BDF8"
                                                         StrokeThickness="1"/>
                                                <Path Stroke="#E11D48"
                                                      StrokeThickness="0.5"
                                                      Fill="#FB7185"
                                                      Data="{Binding CancellationRate, Converter={StaticResource CancellationRatePieGeometryConverter}}"/>
                                                <Ellipse Width="36"
                                                         Height="36"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Fill="{StaticResource StereoSheetFaceBrush}"
                                                         Stroke="#CBD5E1"
                                                         StrokeThickness="1"/>
                                            </Grid>
                                        </Viewbox>
                                        <StackPanel Grid.Column="1"
                                                    Margin="14,0,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="Distribuție risc (anulări)"
                                                       FontWeight="SemiBold"
                                                       Foreground="#334155"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding CancellationRateText}"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       Foreground="#DC2626"
                                                       Margin="0,6,0,0"/>
                                            <TextBlock Text="Felie colorată proporțională cu rata de anulare; restul = volum estimat."
                                                       FontSize="11"
                                                       Foreground="#64748B"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="20,0,0,0" MinWidth="176">
                                    <Border Background="#F9FAFB" CornerRadius="14" Padding="16" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Current Revenue"
                                                       FontSize="14"
                                                       Foreground="#6B7280"/>
                                            <TextBlock Text="{Binding MonthlyRevenueText}"
                                                       FontSize="24"
                                                       FontWeight="Bold"
                                                       Foreground="#16A34A"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#F9FAFB" CornerRadius="14" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="Cancellation Rate"
                                                       FontSize="14"
                                                       Foreground="#6B7280"/>
                                            <TextBlock Text="{Binding CancellationRateText}"
                                                       FontSize="24"
                                                       FontWeight="Bold"
                                                       Foreground="#DC2626"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- USER MANAGEMENT (pagină dedicată: rezumat, căutare, tabel, acțiuni) -->
        <ScrollViewer Visibility="{Binding IsUserManagementSection, Converter={StaticResource BoolToVisibilityConverter}}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource AdminScrollBarStyle}"/>
            </ScrollViewer.Resources>
            <Grid Margin="24,24,24,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,18"
                        Padding="20,14"
                        Background="#FDFEFE"
                        CornerRadius="18"
                        BorderBrush="#E8EDF4"
                        BorderThickness="1"
                        Effect="{StaticResource MagpieCardFloat}">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Travel Agency"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#64748B"/>
                            <TextBlock Text="User management"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="Search accounts, then block, unblock or change role for the selected user."
                                       FontSize="13"
                                       Foreground="#64748B"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                Content="Back to dashboard"
                                Command="{Binding ShowDashboardCommand}"
                                Style="{StaticResource ChromePillButton}"
                                VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1"
                        Margin="0,0,0,18"
                        CornerRadius="26"
                        Padding="14,12"
                        BorderThickness="1"
                        BorderBrush="#D1D5DB"
                        Background="{StaticResource StereoShelfInsetBrush}"
                        Effect="{StaticResource MagpieCardFloat}"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource StereoKpiCard}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Total accounts" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TotalUsersCount}"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource StereoKpiCard}" Margin="6,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Active" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ActiveUsersCount}"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="#15803D"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource StereoKpiCard}" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Blocked" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding BlockedUsersCount}"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="#DC2626"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Style="{StaticResource StereoSheet}">
                    <StackPanel>
                        <TextBlock Text="Directory"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"/>
                        <TextBox Text="{Binding UserFilterText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,10,0,14"
                                 Padding="12,10"
                                 FontSize="14"
                                 BorderBrush="#CBD5E1"
                                 BorderThickness="1"
                                 Background="#FFFFFF"
                                 ToolTipService.ToolTip="Filter by username, email, role or status (live)"/>

                        <DataGrid Style="{StaticResource ModernDataGrid}"
                                  ItemsSource="{Binding UsersView}"
                                  SelectedItem="{Binding SelectedUser}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  MinHeight="420"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="User" Width="*" Binding="{Binding Username}"
                                                    ElementStyle="{StaticResource AdminDataGridTextElement}"/>
                                <DataGridTextColumn Header="Email" Width="1.4*" Binding="{Binding Email}"
                                                    ElementStyle="{StaticResource AdminDataGridTextElement}"/>
                                <DataGridTextColumn Header="Role" Width="*" Binding="{Binding Role}"
                                                    ElementStyle="{StaticResource AdminDataGridTextElement}"/>
                                <DataGridTextColumn Header="Status" Width="*" Binding="{Binding Status}"
                                                    ElementStyle="{StaticResource AdminDataGridTextElement}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Style="{StaticResource CardActionBar}" Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Block selected user"
                                        Command="{Binding BlockUserCommand}"
                                        Style="{StaticResource DangerPillButton}"
                                        Margin="0,0,8,0"/>
                                <Button Content="Unblock selected user"
                                        Command="{Binding UnblockUserCommand}"
                                        Style="{StaticResource SuccessPillButton}"
                                        Margin="0,0,8,0"/>
                                <Button Content="Change role"
                                        Command="{Binding ChangeRoleCommand}"
                                        Style="{StaticResource InfoPillButton}"/>
                                <Button Content="Refresh list"
                                        Command="{Binding RefreshDashboardCommand}"
                                        Style="{StaticResource ChromePillButton}"
                                        Margin="12,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- BOOKINGS CONTROL -->
        <ScrollViewer Visibility="{Binding IsBookingsSection, Converter={StaticResource BoolToVisibilityConverter}}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource AdminScrollBarStyle}"/>
            </ScrollViewer.Resources>
            <Grid Margin="24,24,24,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,18"
                        Padding="20,14"
                        Background="#FDFEFE"
                        CornerRadius="18"
                        BorderBrush="#E8EDF4"
                        BorderThickness="1"
                        Effect="{StaticResource MagpieCardFloat}">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Travel Agency"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#64748B"/>
                            <TextBlock Text="Bookings control"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="All reservations: filter, confirm pending requests, reject or cancel."
                                       FontSize="13"
                                       Foreground="#64748B"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                Content="Back to dashboard"
                                Command="{Binding ShowDashboardCommand}"
                                Style="{StaticResource ChromePillButton}"
                                VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1"
                        Margin="0,0,0,18"
                        CornerRadius="26"
                        Padding="14,12"
                        BorderThickness="1"
                        BorderBrush="#D1D5DB"
                        Background="{StaticResource StereoShelfInsetBrush}"
                        Effect="{StaticResource MagpieCardFloat}"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource StereoKpiCard}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Total" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding AdminBookingsTotalCount}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource StereoKpiCard}" Margin="6,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Pending" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding AdminBookingsPendingCount}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#CA8A04"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource StereoKpiCard}" Margin="6,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Confirmed" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding AdminBookingsConfirmedCount}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#15803D"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource StereoKpiCard}" Margin="6,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Rejected" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding AdminBookingsRejectedCount}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#DC2626"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource StereoKpiCard}" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Cancelled" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding AdminBookingsCancelledCount}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#64748B"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource StereoSheet}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Reservations"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding BookingStatusFilters}"
                                      SelectedItem="{Binding SelectedBookingStatusFilter, Mode=TwoWay}"
                                      Height="36"
                                      VerticalContentAlignment="Center"
                                      Margin="12,0,0,0"/>
                        </Grid>

                        <TextBox Text="{Binding BookingFilterText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,12,0,14"
                                 Padding="12,10"
                                 FontSize="14"
                                 BorderBrush="#CBD5E1"
                                 BorderThickness="1"
                                 Background="#FFFFFF"
                                 ToolTipService.ToolTip="Search by client, package, status or booking id"/>

                        <DataGrid Style="{StaticResource ModernDataGrid}"
                                  ItemsSource="{Binding BookingsView}"
                                  SelectedItem="{Binding SelectedBooking}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  MinHeight="420"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Width="56" Binding="{Binding Id}"
                                                    ElementStyle="{StaticResource AdminDataGridTextElement}"/>
                                <DataGridTextColumn Header="Date" Width="140"
                                                    Binding="{Binding BookingDate, StringFormat=dd.MM.yyyy HH:mm}"
                                                    ElementStyle="{StaticResource AdminDataGridTextElement}"/>
                                <DataGridTextColumn Header="Client" Width="*" Binding="{Binding Client.Username}"
                                                    ElementStyle="{StaticResource AdminDataGridTextElement}"/>
                                <DataGridTextColumn Header="Package" Width="1.2*" Binding="{Binding TripPackage.Name}"
                                                    ElementStyle="{StaticResource AdminDataGridTextElement}"/>
                                <DataGridTextColumn Header="Status" Width="100" Binding="{Binding StatusName}"
                                                    ElementStyle="{StaticResource AdminDataGridTextElement}"/>
                                <DataGridTextColumn Header="Total" Width="100"
                                                    Binding="{Binding TotalPrice, StringFormat=F2}"
                                                    ElementStyle="{StaticResource AdminDataGridTextElement}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Style="{StaticResource CardActionBar}" Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Confirm"
                                        Command="{Binding ConfirmBookingCommand}"
                                        Style="{StaticResource SuccessPillButton}"
