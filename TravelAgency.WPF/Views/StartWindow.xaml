<Window x:Class="TravelAgency.WPF.Views.StartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Travel Agency"
        Height="520"
        Width="980"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F7FB"
        Loaded="Window_Loaded"
        Opacity="0">

    <Window.Resources>
        <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="26" ShadowDepth="8" Opacity="0.18" Color="#0F172A"/>

        <Style x:Key="PillButtonBase" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="22"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.84"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryPill" TargetType="Button" BasedOn="{StaticResource PillButtonBase}">
            <Setter Property="Background" Value="#0EA5E9"/>
            <Setter Property="BorderBrush" Value="#0EA5E9"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="SecondaryPill" TargetType="Button" BasedOn="{StaticResource PillButtonBase}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <Style x:Key="GhostLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniCardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="MiniCardMeta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Storyboard x:Key="EnterStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.35"/>
            <DoubleAnimation Storyboard.TargetName="Card"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="16" To="0" Duration="0:0:0.55"
                             EasingFunction="{StaticResource EaseOut}"/>
        </Storyboard>

        <!-- Subtle background motion so hero doesn't feel like a static image -->
        <Storyboard x:Key="HeroMotionStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="HeroScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1.02" To="1.08" Duration="0:0:8"
                             EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="HeroScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1.02" To="1.08" Duration="0:0:8"
                             EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="HeroTranslate"
                             Storyboard.TargetProperty="X"
                             From="-0.02" To="0.02" Duration="0:0:8"
                             EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="HeroTranslate"
                             Storyboard.TargetProperty="Y"
                             From="0.01" To="-0.02" Duration="0:0:8"
                             EasingFunction="{StaticResource EaseOut}"/>

            <DoubleAnimation Storyboard.TargetName="HeroSweep"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="-520" To="520" Duration="0:0:6.5"
                             EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="HeroSweep"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="0.22" Duration="0:0:1.2" />
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F8FAFC" Offset="0"/>
                <GradientStop Color="#EEF2FF" Offset="0.45"/>
                <GradientStop Color="#ECFEFF" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border x:Name="Card"
                Width="920"
                Height="440"
                CornerRadius="28"
                Background="White"
                Effect="{StaticResource CardShadow}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                SnapsToDevicePixels="True"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform Y="0"/>
            </Border.RenderTransform>

            <Grid ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left hero panel -->
                <Border x:Name="LeftHero"
                        Grid.Column="0"
                        CornerRadius="28,0,0,28"
                        ClipToBounds="True"
                        SizeChanged="LeftHero_SizeChanged">
                    <Border.Background>
                        <ImageBrush ImageSource="pack://application:,,,/Assets/start-hero.png"
                                    Stretch="UniformToFill"
                                    AlignmentX="Center"
                                    AlignmentY="Center"
                                    x:Name="HeroImageBrush">
                            <ImageBrush.RelativeTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="HeroScale" ScaleX="1.04" ScaleY="1.04"/>
                                    <TranslateTransform x:Name="HeroTranslate" X="0" Y="0"/>
                                </TransformGroup>
                            </ImageBrush.RelativeTransform>
                        </ImageBrush>
                    </Border.Background>
                    <Grid>
                        <!-- Global slight darkening + bottom scrim for readability -->
                        <Rectangle Fill="#33000000"/>
                        <Rectangle VerticalAlignment="Bottom" Height="220">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#99000000" Offset="0.65"/>
                                    <GradientStop Color="#CC000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- light sweep -->
                        <Rectangle x:Name="HeroSweep"
                                   Width="220"
                                   Opacity="0"
                                   IsHitTestVisible="False"
                                   RenderTransformOrigin="0.5,0.5">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                                    <GradientStop Color="#33FFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform Angle="-18"/>
                                    <TranslateTransform X="-520"/>
                                </TransformGroup>
                            </Rectangle.RenderTransform>
                        </Rectangle>

                        <Grid Margin="26">
                            <!-- Glass card with text -->
                            <Border CornerRadius="18"
                                    Background="#66FFFFFF"
                                    BorderBrush="#66FFFFFF"
                                    BorderThickness="1"
                                    Padding="18"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="8" Opacity="0.18" Color="#0F172A"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="TRAVEL AGENCY"
                                               Foreground="#0F172A"
                                               FontFamily="Segoe UI Variable Display"
                                               FontWeight="SemiBold"
                                               FontSize="12"/>
                                    <TextBlock Text="time to"
                                               Foreground="#0F172A"
                                               FontFamily="Segoe UI Variable Display"
                                               FontSize="16"
                                               Margin="0,10,0,0"
                                               Opacity="0.85"/>
                                    <TextBlock Text="TRAVEL"
                                               Foreground="#0B1220"
                                               FontFamily="Segoe UI Variable Display"
                                               FontSize="42"
                                               FontWeight="ExtraBold"
                                               Margin="0,-2,0,0"/>
                                    <TextBlock Text="Discover destinations, build packages, and manage bookings in one place."
                                               Foreground="#0F172A"
                                               FontFamily="Segoe UI Variable Text"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Opacity="0.78"
                                               Margin="0,10,0,0"
                                               MaxWidth="300"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Right content -->
                <Grid Grid.Column="1" Margin="36,28,36,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- top nav (visual) -->
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,18">
                        <TextBlock Text="Welcome"
                                   Foreground="#0F172A"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   DockPanel.Dock="Left"/>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button Content="Login"
                                    Style="{StaticResource PrimaryPill}"
                                    Height="34"
                                    Padding="14,0"
                                    Click="Login_Click"/>
                            <Button Content="Create account"
                                    Style="{StaticResource SecondaryPill}"
                                    Height="34"
                                    Padding="14,0"
                                    Margin="10,0,0,0"
                                    Click="Register_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Explore beautiful places"
                                   FontSize="30"
                                   FontWeight="Black"
                                   Foreground="#0F172A"/>

                        <TextBlock Grid.Row="1"
                                   Text="Sign in to continue, or create a client account in seconds."
                                   FontSize="14"
                                   Foreground="#475569"
                                   Margin="0,10,0,14"
                                   TextWrapping="Wrap"/>

                        <!-- Decorative search bar (visual only) -->
                        <Border Grid.Row="2"
                                Background="#FFFFFF"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="14,10"
                                Margin="0,0,0,14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="6" Opacity="0.10" Color="#0F172A"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Path Width="16"
                                      Height="16"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center"
                                      Fill="#94A3B8"
                                      Data="M10.5,10.5 L15,15 L13.8,16.2 L9.3,11.7 C8.5,12.3 7.5,12.7 6.4,12.7 C3.9,12.7 1.9,10.7 1.9,8.2 C1.9,5.7 3.9,3.7 6.4,3.7 C8.9,3.7 10.9,5.7 10.9,8.2 C10.9,9.3 10.6,10.1 10.5,10.5 Z M6.4,5.2 C4.7,5.2 3.4,6.6 3.4,8.2 C3.4,9.9 4.7,11.2 6.4,11.2 C8.1,11.2 9.4,9.9 9.4,8.2 C9.4,6.6 8.1,5.2 6.4,5.2 Z"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Where to?"
                                               Foreground="#0F172A"
                                               FontWeight="SemiBold"
                                               FontSize="12"/>
                                    <TextBlock Text="Search destinations, hotels, attractions…"
                                               Foreground="#94A3B8"
                                               FontSize="11"/>
                                </StackPanel>

                                <Border Grid.Column="2"
                                        Background="#0EA5E9"
                                        CornerRadius="14"
                                        Padding="12,8"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Search"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="12"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Decorative destination cards (visual only) -->
                        <ScrollViewer Grid.Row="3"
                                      Margin="0,0,0,8"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="VerticalOnly"
                                      IsManipulationEnabled="True"
                                      PanningDeceleration="0.002"
                                      PanningRatio="1.15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.Column="0"
                                    Background="#FFFFFF"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="12"
                                    Margin="0,0,12,12"
                                    MinHeight="86">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="5" Opacity="0.08" Color="#0F172A"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="46" Height="46" CornerRadius="14" Background="#ECFEFF">
                                        <Viewbox Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <!-- simple landmark icon -->
                                            <Path Fill="#0F172A"
                                                  Data="M10,1 L18,5 L18,7 L2,7 L2,5 Z M4,8 L6,8 L6,16 L4,16 Z M8,8 L10,8 L10,16 L8,16 Z M12,8 L14,8 L14,16 L12,16 Z M2,17 L18,17 L18,19 L2,19 Z"
                                                  Stretch="Uniform"/>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Paris" Style="{StaticResource MiniCardTitle}"/>
                                        <TextBlock Text="City break" Style="{StaticResource MiniCardMeta}" Margin="0,2,0,0"/>
                                        <Border Background="#F1F5F9" CornerRadius="10" Padding="8,3" Margin="0,8,0,0" HorizontalAlignment="Left">
                                            <TextBlock Text="$1299" Foreground="#0F172A" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1"
                                    Background="#FFFFFF"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="12"
                                    Margin="0,0,0,12"
                                    MinHeight="86">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="5" Opacity="0.08" Color="#0F172A"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="46" Height="46" CornerRadius="14" Background="#EEF2FF">
                                        <Viewbox Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <!-- simple mountain icon -->
                                            <Path Fill="#0F172A"
                                                  Data="M3,17 L9,7 L12,11 L14,8 L19,17 Z M1,17 L3,17 L3,19 L1,19 Z M19,17 L21,17 L21,19 L19,19 Z"
                                                  Stretch="Uniform"/>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Zermatt" Style="{StaticResource MiniCardTitle}"/>
                                        <TextBlock Text="Mountains" Style="{StaticResource MiniCardMeta}" Margin="0,2,0,0"/>
                                        <Border Background="#F1F5F9" CornerRadius="10" Padding="8,3" Margin="0,8,0,0" HorizontalAlignment="Left">
                                            <TextBlock Text="$1590" Foreground="#0F172A" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0"
                                    Background="#FFFFFF"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="12"
                                    Margin="0,0,12,0"
                                    MinHeight="86">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="5" Opacity="0.08" Color="#0F172A"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="46" Height="46" CornerRadius="14" Background="#F0FDF4">
                                        <Viewbox Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <!-- simple palm icon -->
                                            <Path Fill="#0F172A"
                                                  Data="M10,2 C8,2 6.5,3.2 6,5 C7.8,4.2 9.2,4.5 10,5.2 C10.8,4.5 12.2,4.2 14,5 C13.5,3.2 12,2 10,2 Z M5,6 C3.2,6.4 2,7.6 2,9.2 C3.7,8.4 5.2,8.4 6.2,9 C6,7.9 5.6,6.9 5,6 Z M15,6 C14.4,6.9 14,7.9 13.8,9 C14.8,8.4 16.3,8.4 18,9.2 C18,7.6 16.8,6.4 15,6 Z M10,6.5 C8.2,8.3 7.5,10.8 7.5,13.5 L7.5,19 L12.5,19 L12.5,13.5 C12.5,10.8 11.8,8.3 10,6.5 Z"
                                                  Stretch="Uniform"/>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Bali" Style="{StaticResource MiniCardTitle}"/>
                                        <TextBlock Text="Relax" Style="{StaticResource MiniCardMeta}" Margin="0,2,0,0"/>
                                        <Border Background="#F1F5F9" CornerRadius="10" Padding="8,3" Margin="0,8,0,0" HorizontalAlignment="Left">
                                            <TextBlock Text="$1099" Foreground="#0F172A" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                                <Border Grid.Row="1" Grid.Column="1" Background="Transparent"/>
                            </Grid>
                        </ScrollViewer>

                        <StackPanel Grid.Row="4"
                                    Orientation="Horizontal"
                                    Margin="0,14,0,0"
                                    VerticalAlignment="Center">
                            <Border Background="#F1F5F9" CornerRadius="12" Padding="10,6">
                                <TextBlock Text="{Binding CountdownText, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Foreground="#64748B"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <Button Content="Stay here"
                                    Margin="10,0,0,0"
                                    Style="{StaticResource SecondaryPill}"
                                    Height="32"
                                    Padding="14,0"
                                    FontSize="12"
                                    Visibility="{Binding IsAutoRedirectEnabled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Click="StayHere_Click"/>
                        </StackPanel>
                    </Grid>

                    <DockPanel Grid.Row="2" Margin="0,18,0,0">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="© Travel Agency"
                                   Foreground="#94A3B8"
                                   FontSize="12"/>
                        <Button DockPanel.Dock="Right"
                                Content="Exit"
                                Style="{StaticResource GhostLink}"
                                Click="Exit_Click"/>
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

