<Window x:Class="TravelAgency.WPF.Views.Common.UserConversationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Messages"
        Height="520"
        Width="440"
        MinHeight="360"
        MinWidth="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F1F5F9"
        FontFamily="Segoe UI Variable Display, Segoe UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   Text="Conversation"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#0F172A"
                   Margin="0,0,0,12"/>

        <Border Grid.Row="1"
                MinHeight="220"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10">
            <Grid>
                <ListBox x:Name="ChatList"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Focusable" Value="False"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12"
                                    Padding="12,8"
                                    MaxWidth="320">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#E0F2FE"/>
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding Body}"
                                               TextWrapping="Wrap"
                                               Foreground="#0F172A"
                                               FontSize="13.5"/>
                                    <TextBlock Text="{Binding TimeText}"
                                               FontSize="11"
                                               Foreground="#64748B"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty state: explain that this view is text-only. -->
                <TextBlock x:Name="EmptyHint"
                           Text="No text messages in this conversation yet.&#x0a;Type below and press &quot;Send&quot;.&#x0a;&#x0a;(Package images appear on package screens, not in messages.)"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="20"
                           MaxWidth="360"
                           Foreground="#64748B"
                           FontSize="13"
                           LineHeight="20"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <TextBox x:Name="DraftBox"
                 Grid.Row="2"
                 MinHeight="72"
                 Margin="0,12,0,0"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 Padding="10"
                 FontSize="13"
                 BorderBrush="#CBD5E1"
                 BorderThickness="1"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Send"
                    Width="100"
                    Height="36"
                    IsDefault="True"
                    Click="Send_Click"
                    Background="#1F5E6B"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"/>
            <Button Content="Close"
                    Width="88"
                    Height="36"
                    Margin="10,0,0,0"
                    IsCancel="True"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
