<Window x:Class="TravelAgency.WPF.Views.Common.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preview"
        Height="720"
        Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="#0B1220"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ControlTemplate x:Key="ImgPrevScrollBarVertical" TargetType="ScrollBar">
            <Grid x:Name="Root" Width="10" SnapsToDevicePixels="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="0"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="1"
                        Width="5"
                        HorizontalAlignment="Center"
                        Margin="0,6"
                        CornerRadius="3"
                        Background="#334155"/>
                <Track x:Name="PART_Track"
                       Grid.Row="1"
                       IsDirectionReversed="True"
                       Focusable="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                      Opacity="0"
                                      Height="0"
                                      IsTabStop="False"
                                      Focusable="False"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                      Opacity="0"
                                      Height="0"
                                      IsTabStop="False"
                                      Focusable="False"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb>
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border x:Name="T"
                                            Width="6"
                                            MinHeight="28"
                                            CornerRadius="3"
                                            Margin="2,0"
                                            Background="#64748B"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="T" Property="Background" Value="#94A3B8"/>
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="T" Property="Background" Value="#CBD5E1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="ImgPrevScrollBarHorizontal" TargetType="ScrollBar">
            <Grid Height="10" SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="0"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="1"
                        Height="5"
                        VerticalAlignment="Center"
                        Margin="6,0"
                        CornerRadius="3"
                        Background="#334155"/>
                <Track x:Name="PART_Track"
                       Grid.Column="1"
                       IsDirectionReversed="False"
                       Focusable="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                      Opacity="0"
                                      Width="0"
                                      IsTabStop="False"
                                      Focusable="False"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                      Opacity="0"
                                      Width="0"
                                      IsTabStop="False"
                                      Focusable="False"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb>
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border x:Name="Th"
                                            Height="6"
                                            MinWidth="36"
                                            CornerRadius="3"
                                            Margin="0,2"
                                            Background="#64748B"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Th" Property="Background" Value="#94A3B8"/>
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="Th" Property="Background" Value="#CBD5E1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template" Value="{StaticResource ImgPrevScrollBarVertical}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="Template" Value="{StaticResource ImgPrevScrollBarHorizontal}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#141B2A"
                Padding="14,10"
                BorderBrush="#22314D"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="TitleText"
                               Text="Image preview"
                               Foreground="#E5E7EB"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                    <TextBlock x:Name="SubtitleText"
                               Text=""
                               Foreground="#94A3B8"
                               FontSize="12"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="KeyboardHintsLine1"
                               Text="Esc close · Alt+click image area to close · Ctrl+scroll to zoom"
                               Foreground="#64748B"
                               FontSize="11"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="KeyboardHintsLine2"
                               Visibility="Collapsed"
                               Text="Gallery: ← / → · Page Up / Down · Home / End"
                               Foreground="#64748B"
                               FontSize="11"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel x:Name="NavPanel"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,16,0"
                            Visibility="Collapsed">
                    <Button x:Name="PrevNavButton"
                            Width="38"
                            Height="32"
                            Padding="0"
                            Background="#334155"
                            Foreground="#E2E8F0"
                            BorderBrush="#475569"
                            FontFamily="Segoe MDL2 Assets"
                            Content="&#xE72B;"
                            ToolTip="Previous image (←)"
                            Click="PrevNav_Click"/>
                    <TextBlock x:Name="PositionText"
                               MinWidth="48"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="10,0"
                               Foreground="#CBD5E1"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                    <Button x:Name="NextNavButton"
                            Width="38"
                            Height="32"
                            Padding="0"
                            Background="#334155"
                            Foreground="#E2E8F0"
                            BorderBrush="#475569"
                            FontFamily="Segoe MDL2 Assets"
                            Content="&#xE72C;"
                            ToolTip="Next image (→)"
                            Click="NextNav_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Zoom"
                               Foreground="#CBD5E1"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Slider x:Name="ZoomSlider"
                            Width="180"
                            Minimum="0.4"
                            Maximum="3.0"
                            Value="1.0"
                            SmallChange="0.1"
                            LargeChange="0.2"
                            ToolTip="1× ≈ fits the window. Drag right to zoom in (scroll to pan)."
                            ValueChanged="ZoomSlider_ValueChanged"/>
                    <Button Content="Close"
                            Margin="12,0,0,0"
                            Padding="12,6"
                            Background="#334155"
                            Foreground="#E2E8F0"
                            BorderBrush="#475569"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="#0B1220"
                Padding="18">
            <Grid>
                <ScrollViewer x:Name="Scroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              ToolTip="Hold Ctrl and scroll the mouse wheel to zoom."
                              PreviewMouseWheel="Scroller_PreviewMouseWheel">
                    <Grid>
                        <Border Background="#111827"
                                CornerRadius="18"
                                Padding="14"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Grid>
                                <Image x:Name="PreviewImage"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <!-- LayoutTransform (not RenderTransform) so zoom changes layout and ScrollViewer can pan. -->
                                    <Image.LayoutTransform>
                                        <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
                                    </Image.LayoutTransform>
                                </Image>

                                <Border x:Name="LoadingOverlay"
                                        Background="#99111827"
                                        CornerRadius="18"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Loading..."
                                                   Foreground="#E5E7EB"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>
                                        <ProgressBar IsIndeterminate="True"
                                                     Width="220"
                                                     Height="8"
                                                     Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- Prev/next over image; Grid has no Background so clicks pass through to ScrollViewer except on buttons. -->
                <Grid x:Name="GalleryOverlayNav"
                      Visibility="Collapsed">
                    <Button x:Name="OverlayPrevButton"
                            Width="48"
                            Height="48"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0"
                            Padding="0"
                            Cursor="Hand"
                            FontFamily="Segoe MDL2 Assets"
                            Content="&#xE72B;"
                            FontSize="18"
                            Foreground="#F1F5F9"
                            Background="#990F172A"
                            BorderBrush="#66E2E8F0"
                            BorderThickness="1"
                            ToolTip="Previous (←)"
                            Click="PrevNav_Click"/>
                    <Button x:Name="OverlayNextButton"
                            Width="48"
                            Height="48"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            Padding="0"
                            Cursor="Hand"
                            FontFamily="Segoe MDL2 Assets"
                            Content="&#xE72C;"
                            FontSize="18"
                            Foreground="#F1F5F9"
                            Background="#990F172A"
                            BorderBrush="#66E2E8F0"
                            BorderThickness="1"
                            ToolTip="Next image (→)"
                            Click="NextNav_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

