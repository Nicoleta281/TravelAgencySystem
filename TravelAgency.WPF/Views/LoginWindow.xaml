<Window x:Class="TravelAgency.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Login"
        Height="560"
        Width="980"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0B1220">

    <Window.Resources>
        <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="30" ShadowDepth="12" Opacity="0.22" Color="#000000"/>

        <Style x:Key="InputBox" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputPassword" TargetType="{x:Type PasswordBox}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3FFFFFFF"/>
            <Setter Property="BorderBrush" Value="#4DFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#52FFFFFF"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#66FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Background" Value="#00000000"/>
            <Setter Property="BorderBrush" Value="#4DFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1AFFFFFF"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#66FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#0FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HeroTag"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="0.9"
                                     Duration="0:0:0.90"
                                     BeginTime="0:0:0.10"
                                     EasingFunction="{StaticResource EaseOut}"/>
                    <DoubleAnimation Storyboard.TargetName="HeroTag"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="12" To="0"
                                     Duration="0:0:0.90"
                                     BeginTime="0:0:0.10"
                                     EasingFunction="{StaticResource EaseOut}"/>

                    <DoubleAnimation Storyboard.TargetName="HeroTitle"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1"
                                     Duration="0:0:1.05"
                                     BeginTime="0:0:0.30"
                                     EasingFunction="{StaticResource EaseOut}"/>
                    <DoubleAnimation Storyboard.TargetName="HeroTitle"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="18" To="0"
                                     Duration="0:0:1.05"
                                     BeginTime="0:0:0.30"
                                     EasingFunction="{StaticResource EaseOut}"/>

                    <DoubleAnimation Storyboard.TargetName="HeroSubtitle"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="0.92"
                                     Duration="0:0:1.05"
                                     BeginTime="0:0:0.60"
                                     EasingFunction="{StaticResource EaseOut}"/>
                    <DoubleAnimation Storyboard.TargetName="HeroSubtitle"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="14" To="0"
                                     Duration="0:0:1.05"
                                     BeginTime="0:0:0.60"
                                     EasingFunction="{StaticResource EaseOut}"/>

                    <DoubleAnimation Storyboard.TargetName="LoginCard"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1"
                                     Duration="0:0:0.95"
                                     BeginTime="0:0:0.45"
                                     EasingFunction="{StaticResource EaseOut}"/>
                    <DoubleAnimation Storyboard.TargetName="LoginCard"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="16" To="0"
                                     Duration="0:0:0.95"
                                     BeginTime="0:0:0.45"
                                     EasingFunction="{StaticResource EaseOut}"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>

        <!-- Subtle "breathing" motion on background image -->
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="BgScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="1" To="1.06"
                                     Duration="0:0:14"/>
                    <DoubleAnimation Storyboard.TargetName="BgScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="1" To="1.06"
                                     Duration="0:0:14"/>
                    <DoubleAnimation Storyboard.TargetName="BgTranslate"
                                     Storyboard.TargetProperty="X"
                                     From="0" To="-0.02"
                                     Duration="0:0:14"/>
                    <DoubleAnimation Storyboard.TargetName="BgTranslate"
                                     Storyboard.TargetProperty="Y"
                                     From="0" To="-0.015"
                                     Duration="0:0:14"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <!-- Background photo -->
        <Border>
            <Border.Background>
                <ImageBrush x:Name="BgBrush"
                            ImageSource="pack://application:,,,/Assets/login-bg.png"
                            Stretch="UniformToFill"
                            AlignmentX="Center"
                            AlignmentY="Center">
                    <ImageBrush.RelativeTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="BgScale" CenterX="0.5" CenterY="0.5"/>
                            <TranslateTransform x:Name="BgTranslate"/>
                        </TransformGroup>
                    </ImageBrush.RelativeTransform>
                </ImageBrush>
            </Border.Background>
        </Border>

        <!-- Readability overlays -->
        <Rectangle Fill="#5B0B1220"/>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#B30B1220" Offset="0"/>
                    <GradientStop Color="#400B1220" Offset="0.55"/>
                    <GradientStop Color="#100B1220" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="46">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="0.65*"/>
            </Grid.ColumnDefinitions>

            <!-- Left hero text -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,28,0" MaxWidth="560">
                <TextBlock x:Name="HeroTag"
                           Text="TRAVEL"
                           Foreground="#E2E8F0"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Opacity="0"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <TranslateTransform Y="12"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="HeroTitle"
                           Text="EXPLORE&#x0a;HORIZONS"
                           Foreground="White"
                           FontWeight="Black"
                           FontSize="52"
                           Margin="0,10,0,12"
                           Opacity="0"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <TranslateTransform Y="18"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="HeroSubtitle"
                           Text="Where your dream destinations become reality.&#x0a;Login to continue your journey."
                           Foreground="#E2E8F0"
                           FontSize="14"
                           Opacity="0"
                           TextWrapping="Wrap"
                           LineHeight="20"
                           MaxWidth="460"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <TranslateTransform Y="14"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </StackPanel>

            <!-- Right glass login card -->
            <Border x:Name="LoginCard"
                    Grid.Column="1"
                    CornerRadius="18"
                    Padding="26"
                    VerticalAlignment="Center"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform Y="16"/>
                </Border.RenderTransform>
                <Border.Background>
                    <SolidColorBrush Color="White" Opacity="0.18"/>
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Color="White" Opacity="0.28"/>
                </Border.BorderBrush>
                <Border.BorderThickness>1</Border.BorderThickness>
                <Border.Effect>
                    <StaticResource ResourceKey="CardShadow"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Email"
                               Foreground="#E2E8F0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputBox}"
                             Margin="0,0,0,14"/>

                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Password"
                                   Foreground="#E2E8F0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   DockPanel.Dock="Left"/>
                    </DockPanel>
                    <PasswordBox x:Name="PasswordInput"
                                 Style="{StaticResource InputPassword}"
                                 Margin="0,0,0,8"
                                 PasswordChanged="PasswordInput_PasswordChanged"/>

                    <TextBlock Text="Forgot password?"
                               Foreground="#BFDBFE"
                               FontSize="11"
                               Opacity="0.95"
                               HorizontalAlignment="Right"
                               Margin="0,0,0,14"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#FCA5A5"
                               FontSize="12"
                               Margin="0,0,0,12"
                               TextWrapping="Wrap"/>

                    <Button Content="Sign in"
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource PrimaryButton}"/>

                    <Button Content="Create account"
                            Command="{Binding OpenRegisterCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>