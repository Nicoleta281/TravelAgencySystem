<Window x:Class="TravelAgency.WPF.Views.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:TravelAgency.Core.Models;assembly=TravelAgency.Core"
        xmlns:pkg="clr-namespace:TravelAgency.Core.Models.TripPkg.Package;assembly=TravelAgency.Core"
        xmlns:c="clr-namespace:TravelAgency.WPF.Converters"
        mc:Ignorable="d"
        Title="Client Workspace"
        Height="800"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        TextOptions.TextFormattingMode="Display">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E8F4F7" Offset="0"/>
            <GradientStop Color="#F0F4F8" Offset="0.45"/>
            <GradientStop Color="#F8FAFC" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <DropShadowEffect x:Key="ClientGlassShadow"
                          BlurRadius="26"
                          ShadowDepth="1"
                          Direction="270"
                          Opacity="0.06"
                          Color="#0F172A"/>

        <c:TripPackageToImageSourceConverter x:Key="TripPackageToImageSourceConverter"/>
        <c:UrlToProxyImageSourceConverter x:Key="UrlToProxyImageConverter"/>

        <Style x:Key="SoldOutCardStyle" TargetType="{x:Type Border}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding AvailableSeats}" Value="0">
                    <Setter Property="Opacity" Value="0.55"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ClientFieldTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#0F766E"/>
            <Setter Property="SelectionBrush" Value="#99F6E4"/>
        </Style>

        <Style x:Key="ClientFieldCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <ControlTemplate x:Key="ClientScrollBarVertical" TargetType="ScrollBar">
            <Grid Width="10" SnapsToDevicePixels="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="0"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="1" Width="5" HorizontalAlignment="Center" Margin="0,6" CornerRadius="3" Background="#E2E8F0"/>
                <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True" Focusable="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Height="0" IsTabStop="False" Focusable="False"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Height="0" IsTabStop="False" Focusable="False"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb>
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border x:Name="T" Width="6" MinHeight="28" CornerRadius="3" Margin="2,0" Background="#94A3B8"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="T" Property="Background" Value="#64748B"/>
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="T" Property="Background" Value="#475569"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="ClientScrollBarHorizontal" TargetType="ScrollBar">
            <Grid Height="10" SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="0"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="1" Height="5" VerticalAlignment="Center" Margin="6,0" CornerRadius="3" Background="#E2E8F0"/>
                <Track x:Name="PART_Track" Grid.Column="1" IsDirectionReversed="False" Focusable="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Opacity="0" Width="0" IsTabStop="False" Focusable="False"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Opacity="0" Width="0" IsTabStop="False" Focusable="False"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb>
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border x:Name="Th" Height="6" MinWidth="36" CornerRadius="3" Margin="0,2" Background="#94A3B8"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Th" Property="Background" Value="#64748B"/>
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="Th" Property="Background" Value="#475569"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template" Value="{StaticResource ClientScrollBarVertical}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="Template" Value="{StaticResource ClientScrollBarHorizontal}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ClientGlassCard" TargetType="Border">
            <Setter Property="Background" Value="#FDFEFE"/>
            <Setter Property="BorderBrush" Value="#D8E8EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Effect" Value="{StaticResource ClientGlassShadow}"/>
        </Style>

        <Style x:Key="ClientGhostNavButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,0,0,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClientBrowseNavButton" TargetType="Button" BasedOn="{StaticResource ClientGhostNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding PackagesVisibility}" Value="Visible">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2B8CA3" Offset="0"/>
                                <GradientStop Color="#1F5E6B" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ClientBookingsNavButton" TargetType="Button" BasedOn="{StaticResource ClientGhostNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding BookingsVisibility}" Value="Visible">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2B8CA3" Offset="0"/>
                                <GradientStop Color="#1F5E6B" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ClientPrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2B8CA3" Offset="0"/>
                                    <GradientStop Color="#1F5E6B" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.94"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoldOutButtonStyle" TargetType="Button" BasedOn="{StaticResource ClientPrimaryButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding AvailableSeats}" Value="0">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Content" Value="Sold out"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ClientLogoutButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Lg" CornerRadius="12" BorderBrush="#B91C1C" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#EF4444" Offset="0"/>
                                    <GradientStop Color="#B91C1C" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Lg" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                BorderBrush="#99E2E8F0"
                BorderThickness="0,0,1,0"
                Background="#E8F4F7">
            <Grid Margin="0,16,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Logo / Title -->
                <StackPanel HorizontalAlignment="Stretch" Margin="18,12,18,20">
                    <Border Width="56"
                            Height="56"
                            CornerRadius="16"
                            HorizontalAlignment="Left">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2B8CA3" Offset="0"/>
                                <GradientStop Color="#1F5E6B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.28" Color="#2B8CA3"/>
                        </Border.Effect>
                        <TextBlock Text="TA"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="White"/>
                    </Border>
                    <TextBlock Text="Travel Agency"
                               Foreground="#0F172A"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,14,0,0"/>
                    <TextBlock Text="Client workspace"
                               Foreground="#64748B"
                               FontSize="12"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Menu -->
                <StackPanel Grid.Row="1" Margin="14,0,14,0">
                    <TextBlock Text="MENU"
                               Foreground="#64748B"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="10,0,0,10"/>

                    <Button Content="Browse Packages"
                            Style="{StaticResource ClientBrowseNavButton}"
                            Command="{Binding ShowPackagesCommand}"/>

                    <Button Content="My Bookings"
                            Style="{StaticResource ClientBookingsNavButton}"
                            Command="{Binding ShowBookingsCommand}"/>

                    <Button Height="44"
                            Margin="0,0,0,12"
                            Style="{StaticResource ClientGhostNavButton}"
                            BorderBrush="#33CBD5E1"
                            Command="{Binding OpenAgencyMessagesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Mesaje agenție"
                                       VerticalAlignment="Center"
                                       Foreground="#0F172A"/>
                            <Border Margin="10,0,0,0"
                                    Padding="6,2"
                                    CornerRadius="8"
                                    Background="#F59E0B"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AgencyInboxUnreadCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding AgencyInboxUnreadCount, Mode=OneWay}"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button Content="Favorites"
                            Style="{StaticResource ClientGhostNavButton}"/>

                    <Button Content="Profile / Account"
                            Style="{StaticResource ClientGhostNavButton}"/>

                    <Button Content="Logout"
                            Height="46"
                            Margin="0,20,0,0"
                            Style="{StaticResource ClientLogoutButton}"
                            Command="{Binding LogoutCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Style="{StaticResource ClientGlassCard}"
                    Padding="24"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Browse Travel Packages"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                        <TextBlock Text="Discover and book your perfect trip"
                                   FontSize="14"
                                   Foreground="#64748B"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <TextBox Grid.Column="1"
                             Height="40"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             Style="{StaticResource ClientFieldTextBox}"
                             Padding="12,0,12,0"
                             Margin="16,0,16,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                    <Button Grid.Column="2"
                            Content="My Bookings"
                            Height="40"
                            Padding="16,0"
                            FontSize="14"
                            Style="{StaticResource ClientPrimaryButton}"
                            Command="{Binding ShowBookingsCommand}"/>
                </Grid>
            </Border>

            <!-- Filters -->
            <Border Grid.Row="1"
                    Style="{StaticResource ClientGlassCard}"
                    Padding="20"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Destination"
                                   FontSize="14"
                                   Margin="0,0,0,6"
                                   Foreground="#475569"
                                   FontWeight="SemiBold"/>
                        <TextBox Height="38"
                                 FontSize="14"
                                 Style="{StaticResource ClientFieldTextBox}"
                                 Padding="10,0,10,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                        <TextBlock Text="Price Range"
                                   FontSize="14"
                                   Margin="0,0,0,6"
                                   Foreground="#475569"
                                   FontWeight="SemiBold"/>
                        <ComboBox Height="38"
                                  FontSize="14"
                                  Style="{StaticResource ClientFieldCombo}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,14,0">
                        <TextBlock Text="Trip Type"
                                   FontSize="14"
                                   Margin="0,0,0,6"
                                   Foreground="#475569"
                                   FontWeight="SemiBold"/>
                        <ComboBox Height="38"
                                  FontSize="14"
                                  Style="{StaticResource ClientFieldCombo}"/>
                    </StackPanel>

                    <Button Grid.Column="3"
                            Content="Apply Filters"
                            Height="38"
                            VerticalAlignment="Bottom"
                            Padding="16,0"
                            FontSize="14"
                            Style="{StaticResource ClientPrimaryButton}"/>
                </Grid>
            </Border>

            <!-- Main Area -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Grid>
                    <!-- Packages View -->
                    <Grid Visibility="{Binding PackagesVisibility}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Available Packages"
                   FontSize="19"
                   FontWeight="Bold"
                   Foreground="#0F172A"
                   Margin="0,0,0,16"/>

                        <Border Grid.Row="1"
                                Background="#FFFBEB"
                                BorderBrush="#F59E0B"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14"
                                Margin="0,0,0,16">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Packages.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Nu există pachete disponibile momentan. Te rugăm să revii mai târziu."
                                       Foreground="#92400E"
                                       FontSize="14"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                            <ItemsControl ItemsSource="{Binding Packages}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type pkg:TripPackage}">
                                        <Border Width="220"
                                Height="310"
                                Margin="0,0,16,16"
                                Background="#FDFEFE"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="16"
                                Effect="{StaticResource ClientGlassShadow}"
                                Style="{StaticResource SoldOutCardStyle}">
                                            <StackPanel>
                                                <Border Height="120"
                                                        CornerRadius="16,16,0,0"
                                                        ClipToBounds="True">
                                                    <Grid>
                                                        <Image Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               Source="{Binding Converter={StaticResource TripPackageToImageSourceConverter}}"/>
                                                        <Border Background="#220F172A"/>
                                                    </Grid>
                                                </Border>

                                                <StackPanel Margin="14">
                                                    <TextBlock Text="{Binding Name}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#0F172A"
                                               TextWrapping="Wrap"/>

                                                    <Border Background="#FEE2E2"
                                                            CornerRadius="10"
                                                            Padding="6,3"
                                                            HorizontalAlignment="Left"
                                                            Margin="0,8,0,0">
                                                        <Border.Style>
                                                            <Style TargetType="{x:Type Border}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding AvailableSeats}" Value="0">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="Sold out"
                                                                   Foreground="#991B1B"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12"/>
                                                    </Border>

                                                    <TextBlock FontSize="13"
                                               Foreground="#6B7280"
                                               Margin="0,6,0,0">
                                        <Run Text="{Binding TransportDisplayName}"/>
                                        <Run Text=" + "/>
                                        <Run Text="{Binding StayDisplayName}"/>
                                                    </TextBlock>

                                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="13"
                                               Foreground="#6B7280">
                                        <Run Text="Destination: "/>
                                        <Run Text="{Binding Destination, Mode=OneWay}"/>
                                                    </TextBlock>

                                                    <TextBlock Margin="0,4,0,0"
                                                               FontSize="13"
                                                               Foreground="#6B7280">
                                                        <Run Text="Seats left: "/>
                                                        <Run Text="{Binding AvailableSeats}"/>
                                                    </TextBlock>

                                                    <TextBlock Text="{Binding Price, StringFormat=€ {0:F2}}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#0F766E"
                                               Margin="0,12,0,14"/>

                                                    <Button Content="View Details"
                                            Height="36"
                                            Padding="14,0"
                                            FontSize="13"
                                            Style="{StaticResource SoldOutButtonStyle}"
                                            Tag="{Binding}"
                                            Click="ViewDetails_Click"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Bookings View -->
                    <Grid Visibility="{Binding BookingsVisibility}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="My Bookings"
                   FontSize="19"
                   FontWeight="Bold"
                   Foreground="#0F172A"
                   Margin="0,0,0,16"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                            <ItemsControl ItemsSource="{Binding MyBookings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,14"
                                Padding="16"
                                Background="#FDFEFE"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="16"
                                Effect="{StaticResource ClientGlassShadow}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding TripPackage.Name}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"/>

                                                <TextBlock Margin="0,8,0,0"
                                           FontSize="14"
                                           Foreground="#64748B"
                                           Text="{Binding BookingDate, StringFormat=Booked on: {0:dd MMM yyyy HH:mm}}"/>

                                                <TextBlock FontSize="16"
                                                           Foreground="#475569"
                                                           Margin="0,4,0,0"
                                                           Text="{Binding Status.Name, Converter={StaticResource BookingStatusRoConverter}}"/>

                                                <TextBlock Margin="0,4,0,0"
                                           FontSize="14"
                                           Foreground="#64748B"
                                           Text="{Binding BasePrice, StringFormat=Base Price: € {0:F2}}"/>

                                                <TextBlock Margin="0,4,0,0"
                                           FontSize="14"
                                           Foreground="#64748B"
                                           Text="{Binding TotalPrice, StringFormat=Total Price: € {0:F2}}"/>

                                                <ItemsControl ItemsSource="{Binding SelectedExtras}" Margin="0,10,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#ECFEFF"
                                                    CornerRadius="10"
                                                    Padding="8,4"
                                                    Margin="0,0,8,8">
                                                                <TextBlock Text="{Binding}"
                                                           FontSize="12"
                                                           Foreground="#0F766E"
                                                           FontWeight="SemiBold"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Right Details Panel -->
                <Border Grid.Column="1"
                        Style="{StaticResource ClientGlassCard}"
                        Padding="18,20,10,20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Package Details"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,0,0,16"/>

                                                <Border Height="150"
                                    CornerRadius="14"
                                    Margin="0,0,0,16"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="ClientDetailsImage_MouseLeftButtonUp">
                                <Grid>
                                    <Image Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Source="{Binding SelectedPackage, Converter={StaticResource TripPackageToImageSourceConverter}}"/>
                                    <Border Background="#220F172A"/>
                                </Grid>
                            </Border>

                                                <TextBlock Text="Images"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#475569"
                                                           Margin="0,0,0,8"/>

                                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                              VerticalScrollBarVisibility="Disabled"
                                                              Padding="0,0,0,4"
                                                              Margin="0,0,0,16">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ItemsControl ItemsSource="{Binding DestinationImageUrls}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Width="56"
                                                                            Height="56"
                                                                            CornerRadius="14"
                                                                            Margin="0,0,10,0"
                                                                            ClipToBounds="True"
                                                                            Background="#E5E7EB"
                                                                            Cursor="Hand"
                                                                            MouseLeftButtonUp="ClientThumb_MouseLeftButtonUp"
                                                                            Tag="{Binding}">
                                                                        <Image Stretch="UniformToFill"
                                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                                               Source="{Binding Converter={StaticResource UrlToProxyImageConverter}}"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <ItemsControl ItemsSource="{Binding HotelImageUrls}" Margin="6,0,0,0">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Width="56"
                                                                            Height="56"
                                                                            CornerRadius="14"
                                                                            Margin="0,0,10,0"
                                                                            ClipToBounds="True"
                                                                            Background="#E5E7EB"
                                                                            Cursor="Hand"
                                                                            MouseLeftButtonUp="ClientThumb_MouseLeftButtonUp"
                                                                            Tag="{Binding}">
                                                                        <Image Stretch="UniformToFill"
                                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                                               Source="{Binding Converter={StaticResource UrlToProxyImageConverter}}"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </ScrollViewer>

                            <TextBlock Text="{Binding SelectedPackage.Name}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,0,0,12"
                                       TextWrapping="Wrap"/>

                            <TextBlock Margin="0,3,0,0" FontSize="14" Foreground="#64748B">
                                <Run Text="Transport: " FontWeight="SemiBold" Foreground="#475569"/>
                                <Run Text="{Binding SelectedPackage.TransportDisplayName, Mode=OneWay}"/>
                            </TextBlock>

                            <TextBlock Margin="0,3,0,0" FontSize="14" Foreground="#64748B">
                                <Run Text="Stay: " FontWeight="SemiBold" Foreground="#475569"/>
                                <Run Text="{Binding SelectedPackage.StayDisplayName, Mode=OneWay}"/>
                            </TextBlock>

                            <TextBlock Margin="0,3,0,0" FontSize="14" Foreground="#64748B">
                                <Run Text="Destination: " FontWeight="SemiBold" Foreground="#475569"/>
                                <Run Text="{Binding SelectedPackage.Destination, Mode=OneWay}"/>
                            </TextBlock>

                            <TextBlock Margin="0,3,0,0" FontSize="14" Foreground="#64748B">
                                <Run Text="Country: " FontWeight="SemiBold" Foreground="#475569"/>
                                <Run Text="{Binding SelectedPackage.Country, Mode=OneWay}"/>
                            </TextBlock>

                            <TextBlock Margin="0,3,0,16" FontSize="14" Foreground="#64748B" TextWrapping="Wrap">
                                <Run Text="Description: " FontWeight="SemiBold" Foreground="#475569"/>
                                <Run Text="{Binding SelectedPackage.ShortDescription, Mode=OneWay}"/>
                            </TextBlock>

                            <!-- Extras -->
                            <TextBlock Text="Customize Your Trip"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,0,0,12"/>

                            <ItemsControl ItemsSource="{Binding AvailableExtras}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:OptionalExtra}">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Margin="0,8,0,8"
                                                  FontSize="14"
                                                  Cursor="Hand">
                                            <TextBlock>
                                                <Run Text="{Binding Name}"/>
                                                <Run Text=" (+ €"/>
                                                <Run Text="{Binding Price, StringFormat={}{0:F0}}"/>
                                                <Run Text=")"/>
                                            </TextBlock>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Price Breakdown -->
                            <Border Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="14"
                                    Margin="0,10,0,16">
                                <StackPanel>
                                    <TextBlock Text="Price Breakdown"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#0F172A"
                                               Margin="0,0,0,12"/>

                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Base Price" FontSize="14" Foreground="#64748B"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding BasePrice, StringFormat=€ {0:F2}}"
                                                   FontSize="14"
                                                   Foreground="#0F172A"
                                                   FontWeight="SemiBold"/>
                                    </Grid>

                                    <Separator Margin="0,12,0,12" Background="#E2E8F0"/>

                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Total"
                                                  FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="#0F172A"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TotalPrice, StringFormat=€ {0:F2}}"
                                                  FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="#0F766E"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Button Content="Send Request"
                                    Height="44"
                                    Padding="18,0"
                                    FontSize="15"
                                    Style="{StaticResource ClientPrimaryButton}"
                                    Command="{Binding ConfirmBookingCommand}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>