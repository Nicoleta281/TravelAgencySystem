<Window x:Class="TravelAgency.WPF.Views.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:TravelAgency.Core.Models;assembly=TravelAgency.Core"
        xmlns:pkg="clr-namespace:TravelAgency.Core.Models.TripPkg.Package;assembly=TravelAgency.Core"
        xmlns:notif="clr-namespace:TravelAgency.Core.Models.Notifications;assembly=TravelAgency.Core"
        xmlns:c="clr-namespace:TravelAgency.WPF.Converters"
        mc:Ignorable="d"
        Title="Client Workspace"
        Height="800"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        TextOptions.TextFormattingMode="Display">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E8F4F7" Offset="0"/>
            <GradientStop Color="#F0F4F8" Offset="0.45"/>
            <GradientStop Color="#F8FAFC" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <DropShadowEffect x:Key="ClientGlassShadow"
                          BlurRadius="26"
                          ShadowDepth="1"
                          Direction="270"
                          Opacity="0.06"
                          Color="#0F172A"/>

        <c:TripPackageToImageSourceConverter x:Key="TripPackageToImageSourceConverter"/>
        <c:UrlToProxyImageSourceConverter x:Key="UrlToProxyImageConverter"/>
        <c:UsernameToInitialsConverter x:Key="UsernameToInitialsConverter"/>

        <Style x:Key="SoldOutCardStyle" TargetType="{x:Type Border}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding AvailableSeats}" Value="0">
                    <Setter Property="Opacity" Value="0.55"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ClientFieldTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#0F766E"/>
            <Setter Property="SelectionBrush" Value="#99F6E4"/>
        </Style>

        <Style x:Key="ClientFieldCombo" TargetType="ComboBox">
            <!-- ComboBox popup uses ScrollViewer + ScrollBar; the window default ScrollBar style can leave
                 the item list with no height / invisible text. Reset ScrollBar styling here. -->
            <Style.Resources>
                <Style TargetType="ScrollBar">
                    <Setter Property="OverridesDefaultStyle" Value="False"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="#0F172A"/>
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="MinHeight" Value="36"/>
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
            </Style.Resources>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <ControlTemplate x:Key="ClientScrollBarVertical" TargetType="ScrollBar">
            <Grid Width="10" SnapsToDevicePixels="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="0"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="1" Width="5" HorizontalAlignment="Center" Margin="0,6" CornerRadius="3" Background="#E2E8F0"/>
                <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True" Focusable="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Height="0" IsTabStop="False" Focusable="False"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Height="0" IsTabStop="False" Focusable="False"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb>
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border x:Name="T" Width="6" MinHeight="28" CornerRadius="3" Margin="2,0" Background="#94A3B8"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="T" Property="Background" Value="#64748B"/>
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="T" Property="Background" Value="#475569"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="ClientScrollBarHorizontal" TargetType="ScrollBar">
            <Grid Height="10" SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="0"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="1" Height="5" VerticalAlignment="Center" Margin="6,0" CornerRadius="3" Background="#E2E8F0"/>
                <Track x:Name="PART_Track" Grid.Column="1" IsDirectionReversed="False" Focusable="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Opacity="0" Width="0" IsTabStop="False" Focusable="False"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Opacity="0" Width="0" IsTabStop="False" Focusable="False"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb>
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border x:Name="Th" Height="6" MinWidth="36" CornerRadius="3" Margin="0,2" Background="#94A3B8"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Th" Property="Background" Value="#64748B"/>
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="Th" Property="Background" Value="#475569"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate>

        <!-- Named style: apply only on our ScrollViewers so ComboBox popups keep system scrollbars (see App.xaml global ScrollBar). -->
        <Style x:Key="ClientScrollBarChrome" TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template" Value="{StaticResource ClientScrollBarVertical}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="Template" Value="{StaticResource ClientScrollBarHorizontal}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ClientGlassCard" TargetType="Border">
            <Setter Property="Background" Value="#FDFEFE"/>
            <Setter Property="BorderBrush" Value="#D8E8EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Effect" Value="{StaticResource ClientGlassShadow}"/>
        </Style>

        <Style x:Key="ClientGhostNavButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,0,0,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClientBrowseNavButton" TargetType="Button" BasedOn="{StaticResource ClientGhostNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBrowsePackagesSectionActive}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2B8CA3" Offset="0"/>
                                <GradientStop Color="#1F5E6B" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ClientBookingsNavButton" TargetType="Button" BasedOn="{StaticResource ClientGhostNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding BookingsVisibility}" Value="Visible">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2B8CA3" Offset="0"/>
                                <GradientStop Color="#1F5E6B" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ClientFavoritesNavButton" TargetType="Button" BasedOn="{StaticResource ClientGhostNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FavoritesVisibility}" Value="Visible">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2B8CA3" Offset="0"/>
                                <GradientStop Color="#1F5E6B" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ClientProfileNavButton" TargetType="Button" BasedOn="{StaticResource ClientGhostNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProfileVisibility}" Value="Visible">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2B8CA3" Offset="0"/>
                                <GradientStop Color="#1F5E6B" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ClientNotificationsNavButton" TargetType="Button" BasedOn="{StaticResource ClientGhostNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding NotificationsVisibility}" Value="Visible">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2B8CA3" Offset="0"/>
                                <GradientStop Color="#1F5E6B" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="BookingNotificationItemTemplate" DataType="{x:Type notif:BookingUpdateNotification}">
            <Border Margin="0,0,0,12"
                    Padding="0"
                    Background="#FDFEFE"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="14,0,0,14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#0F766E"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NewStatus}" Value="Confirmed">
                                        <Setter Property="Background" Value="#15803D"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NewStatus}" Value="Rejected">
                                        <Setter Property="Background" Value="#B91C1C"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NewStatus}" Value="Cancelled">
                                        <Setter Property="Background" Value="#64748B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,14,12,14">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"/>
                        <TextBlock Text="{Binding Detail}"
                                   FontSize="14"
                                   Foreground="#475569"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}"
                                   Foreground="#94A3B8"
                                   FontSize="12"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="View booking"
                            Margin="0,14,14,14"
                            VerticalAlignment="Top"
                            Padding="12,8"
                            FontSize="13"
                            Cursor="Hand"
                            Foreground="#0F766E"
                            Background="Transparent"
                            BorderBrush="#99CBD5E1"
                            BorderThickness="1"
                            Command="{Binding DataContext.OpenBookingFromNotificationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding BookingId}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="ClientPrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2B8CA3" Offset="0"/>
                                    <GradientStop Color="#1F5E6B" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.94"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoldOutButtonStyle" TargetType="Button" BasedOn="{StaticResource ClientPrimaryButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding AvailableSeats}" Value="0">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Content" Value="Sold out"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="TripPackageCardTemplate" DataType="{x:Type pkg:TripPackage}">
            <Border MinHeight="300"
                    MaxHeight="380"
                    Margin="0,0,14,16"
                    HorizontalAlignment="Stretch"
                    Background="#FDFEFE"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="16"
                    Effect="{StaticResource ClientGlassShadow}"
                    Style="{StaticResource SoldOutCardStyle}">
                <Grid>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="132"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                CornerRadius="16,16,0,0"
                                ClipToBounds="True"
                                Background="#E2E8F0">
                            <Grid>
                                <Image Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="{Binding Converter={StaticResource TripPackageToImageSourceConverter}}"/>
                                <Border Background="#220F172A"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="1"
                                    Margin="14,12,14,8"
                                    VerticalAlignment="Top">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       TextWrapping="Wrap"
                                       LineHeight="20"/>

                            <Border Background="#FEE2E2"
                                    CornerRadius="10"
                                    Padding="6,3"
                                    HorizontalAlignment="Left"
                                    Margin="0,8,0,0">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AvailableSeats}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="Sold out"
                                           Foreground="#991B1B"
                                           FontWeight="SemiBold"
                                           FontSize="12"/>
                            </Border>

                            <TextBlock FontSize="13"
                                       Foreground="#6B7280"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap">
                                <Run Text="{Binding TransportDisplayName}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding StayDisplayName}"/>
                            </TextBlock>

                            <TextBlock Margin="0,4,0,0"
                                       FontSize="13"
                                       Foreground="#6B7280"
                                       TextWrapping="Wrap">
                                <Run Text="Destination: "/>
                                <Run Text="{Binding Destination, Mode=OneWay}"/>
                            </TextBlock>

                            <TextBlock Margin="0,4,0,0"
                                       FontSize="13"
                                       Foreground="#6B7280">
                                <Run Text="Seats left: "/>
                                <Run Text="{Binding AvailableSeats}"/>
                            </TextBlock>

                            <TextBlock Text="{Binding Price, StringFormat={}{0:N2} €}"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="#0F766E"
                                       Margin="0,10,0,0"/>
                        </StackPanel>

                        <Border Grid.Row="2"
                                Padding="14,0,14,14"
                                Background="Transparent">
                            <Button Content="View Details"
                                    Height="38"
                                    Padding="14,0"
                                    FontSize="13"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource SoldOutButtonStyle}"
                                    Tag="{Binding}"
                                    Click="ViewDetails_Click"/>
                        </Border>
                    </Grid>
                    <Button Panel.ZIndex="4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,8,8,0"
                            Width="36"
                            Height="32"
                            Padding="0"
                            Cursor="Hand"
                            ToolTip="Add or remove from favorites"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            Command="{Binding DataContext.TogglePackageFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="♡"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter Property="Content" Value="♥"/>
                                        <Setter Property="Foreground" Value="#B91C1C"/>
                                        <Setter Property="Background" Value="#FEE2E2"/>
                                        <Setter Property="BorderBrush" Value="#FECACA"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="ClientLogoutButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Lg" CornerRadius="12" BorderBrush="#B91C1C" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#EF4444" Offset="0"/>
                                    <GradientStop Color="#B91C1C" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Lg" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                BorderBrush="#99E2E8F0"
                BorderThickness="0,0,1,0"
                Background="#E8F4F7">
            <Grid Margin="0,16,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Logo / Title -->
                <StackPanel HorizontalAlignment="Stretch" Margin="18,12,18,20">
                    <Border Width="56"
                            Height="56"
                            CornerRadius="16"
                            HorizontalAlignment="Left">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2B8CA3" Offset="0"/>
                                <GradientStop Color="#1F5E6B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.28" Color="#2B8CA3"/>
                        </Border.Effect>
                        <TextBlock Text="TA"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="White"/>
                    </Border>
                    <TextBlock Text="Travel Agency"
                               Foreground="#0F172A"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,14,0,0"/>
                    <TextBlock Text="Client workspace"
                               Foreground="#64748B"
                               FontSize="12"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Menu -->
                <StackPanel Grid.Row="1" Margin="14,0,14,0">
                    <TextBlock Text="MENU"
                               Foreground="#64748B"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="10,0,0,10"/>

                    <Button Content="Browse Packages"
                            Style="{StaticResource ClientBrowseNavButton}"
                            Command="{Binding ShowPackagesCommand}"/>

                    <Button Content="My Bookings"
                            Style="{StaticResource ClientBookingsNavButton}"
                            Command="{Binding ShowBookingsCommand}"/>

                    <Button Style="{StaticResource ClientNotificationsNavButton}"
                            Command="{Binding ShowNotificationsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Notifications"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <Border Margin="8,0,0,0"
                                    Padding="6,2"
                                    CornerRadius="8"
                                    Background="#F59E0B"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UnreadBookingNotificationCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding UnreadBookingNotificationCount, Mode=OneWay}"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button Height="44"
                            Margin="0,0,0,12"
                            Style="{StaticResource ClientGhostNavButton}"
                            BorderBrush="#33CBD5E1"
                            Command="{Binding OpenAgencyMessagesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Agency messages"
                                       VerticalAlignment="Center"
                                       Foreground="#0F172A"/>
                            <Border Margin="10,0,0,0"
                                    Padding="6,2"
                                    CornerRadius="8"
                                    Background="#F59E0B"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AgencyInboxUnreadCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding AgencyInboxUnreadCount, Mode=OneWay}"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ClientFavoritesNavButton}"
                            Command="{Binding ShowFavoritesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Favorite" VerticalAlignment="Center"/>
                            <Border Margin="8,0,0,0"
                                    Padding="6,2"
                                    CornerRadius="8"
                                    Background="#F59E0B"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FavoriteCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding FavoriteCount, Mode=OneWay}"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button Content="Profile / Account"
                            Style="{StaticResource ClientProfileNavButton}"
                            Command="{Binding ShowProfileCommand}"/>

                    <Button Content="Logout"
                            Height="46"
                            Margin="0,20,0,0"
                            Style="{StaticResource ClientLogoutButton}"
                            Command="{Binding LogoutCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Style="{StaticResource ClientGlassCard}"
                    Padding="24"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Visibility="{Binding PackagesVisibility}">
                        <TextBlock Text="Browse Travel Packages"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                        <TextBlock Text="Discover and book your perfect trip"
                                   FontSize="14"
                                   Foreground="#64748B"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding BookingsVisibility}">
                        <TextBlock Text="My bookings"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                        <TextBlock Text="Your booking requests — select one for package details"
                                   FontSize="14"
                                   Foreground="#64748B"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding FavoritesVisibility}">
                        <TextBlock Text="Favorite packages"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                        <TextBlock FontSize="14"
                                   Foreground="#64748B"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap">
                            <Run Text="Saved to your account. You can submit a booking request like in Browse Packages."/>
                            <LineBreak/>
                            <Run Text="Tap the heart on a card to remove it from favorites."/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowProfileChrome, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Account profile"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                        <TextBlock Text="Contact details, account status, and return to packages."
                                   FontSize="14"
                                   Foreground="#64748B"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowNotificationsChrome, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Notifications"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                        <TextBlock Text="Booking updates appear here automatically when a request status changes."
                                   FontSize="14"
                                   Foreground="#64748B"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBox Grid.Column="1"
                             Height="40"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             Style="{StaticResource ClientFieldTextBox}"
                             Padding="12,0,12,0"
                             Margin="16,0,16,0"
                             Visibility="{Binding IsBrowsePackagesSectionActive, Converter={StaticResource BoolToVisibilityConverter}}"
                             ToolTip="Search by destination, country, or package name"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                    <Button Grid.Column="2"
                            Content="My bookings"
                            Height="40"
                            Padding="16,0"
                            FontSize="14"
                            Style="{StaticResource ClientPrimaryButton}"
                            Visibility="{Binding IsBrowsePackagesSectionActive, Converter={StaticResource BoolToVisibilityConverter}}"
                            Command="{Binding ShowBookingsCommand}"/>

                    <Button Grid.Column="2"
                            Content="Back to packages"
                            Height="40"
                            Padding="16,0"
                            FontSize="14"
                            Style="{StaticResource ClientPrimaryButton}"
                            Visibility="{Binding ShowBackToPackagesHeaderButton, Converter={StaticResource BoolToVisibilityConverter}}"
                            Command="{Binding ShowPackagesCommand}"/>
                </Grid>
            </Border>

            <!-- Filters (packages browse only) -->
            <Border Grid.Row="1"
                    Padding="20"
                    Margin="0,0,0,16">
                <Border.Style>
                    <Style BasedOn="{StaticResource ClientGlassCard}" TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BookingsVisibility}" Value="Visible">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding FavoritesVisibility}" Value="Visible">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ProfileVisibility}" Value="Visible">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NotificationsVisibility}" Value="Visible">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" MinWidth="260"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Destination"
                                   FontSize="14"
                                   Margin="0,0,0,6"
                                   Foreground="#475569"
                                   FontWeight="SemiBold"/>
                        <TextBox Height="38"
                                 FontSize="14"
                                 Style="{StaticResource ClientFieldTextBox}"
                                 Padding="10,0,10,0"
                                 ToolTip="Match destination, country, or package name (substring)."
                                 Text="{Binding FilterDestination, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                        <TextBlock Text="Price Range"
                                   FontSize="14"
                                   Margin="0,0,0,6"
                                   Foreground="#475569"
                                   FontWeight="SemiBold"/>
                        <ComboBox Height="38"
                                  FontSize="14"
                                  Style="{StaticResource ClientFieldCombo}"
                                  ItemsSource="{Binding PriceRangeOptions}"
                                  SelectedItem="{Binding SelectedPriceRange, Mode=TwoWay}"
                                  VirtualizingPanel.IsVirtualizing="False"
                                  ScrollViewer.CanContentScroll="False"
                                  MaxDropDownHeight="320"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,14,0">
                        <TextBlock Text="Trip Type"
                                   FontSize="14"
                                   Margin="0,0,0,6"
                                   Foreground="#475569"
                                   FontWeight="SemiBold"/>
                        <ComboBox Height="38"
                                  FontSize="14"
                                  Style="{StaticResource ClientFieldCombo}"
                                  ItemsSource="{Binding TripTypeFilterOptions}"
                                  SelectedItem="{Binding SelectedTripTypeFilter, Mode=TwoWay}"
                                  VirtualizingPanel.IsVirtualizing="False"
                                  ScrollViewer.CanContentScroll="False"
                                  MaxDropDownHeight="320"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom">
                        <Button Content="Apply Filters"
                                Height="38"
                                Padding="16,0"
                                FontSize="14"
                                Style="{StaticResource ClientPrimaryButton}"
                                Command="{Binding ApplyFiltersCommand}"/>
                        <Button Content="Reset"
                                Height="38"
                                MinWidth="88"
                                Margin="10,0,0,0"
                                Padding="14,0"
                                FontSize="14"
                                Cursor="Hand"
                                Foreground="#475569"
                                Background="#F1F5F9"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                Command="{Binding ClearFiltersCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Area -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.75*"/>
                    <ColumnDefinition Width="1.15*"/>
                </Grid.ColumnDefinitions>

                <Grid>
                    <!-- Packages View -->
                    <Grid Visibility="{Binding PackagesVisibility}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Available Packages"
                   FontSize="19"
                   FontWeight="Bold"
                   Foreground="#0F172A"
                   Margin="0,0,0,16"/>

                        <Border Grid.Row="1"
                                Background="#FFFBEB"
                                BorderBrush="#F59E0B"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14"
                                Margin="0,0,0,16">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Packages.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="No packages are available right now. Please check back later."
                                       Foreground="#92400E"
                                       FontSize="14"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ClientScrollBarChrome}"/>
                            </ScrollViewer.Resources>
                            <ItemsControl ItemsSource="{Binding Packages}"
                                          ItemTemplate="{StaticResource TripPackageCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"
                                                     HorizontalAlignment="Stretch"
                                                     SnapsToDevicePixels="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Bookings View -->
                    <Grid Visibility="{Binding BookingsVisibility}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Booking history"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,8"/>

                        <Grid Grid.Row="1">
                            <Border Padding="28,36"
                                    CornerRadius="18"
                                    Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasNoBookings, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                                    <TextBlock Text="No bookings yet"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="#0F172A"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="After you submit a request from packages, your bookings will appear here."
                                               FontSize="14"
                                               Foreground="#64748B"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding MyBookings}"
                                     SelectedItem="{Binding SelectedBooking, Mode=TwoWay}"
                                     Visibility="{Binding HasBookings, Converter={StaticResource BoolToVisibilityConverter}}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0,0,6,0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ClientScrollBarChrome}"/>
                                </ListBox.Resources>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,14"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Background="{TemplateBinding Background}"
                                                            SnapsToDevicePixels="True">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                            <Border CornerRadius="18"
                                                    Background="#FDFEFE"
                                                    Padding="0"
                                                    Effect="{StaticResource ClientGlassShadow}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#0F766E"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="5"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" CornerRadius="3,0,0,3" Margin="0,14,0,14">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#94A3B8"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status.Name}" Value="Confirmed">
                                                                        <Setter Property="Background" Value="#0F766E"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status.Name}" Value="Pending">
                                                                        <Setter Property="Background" Value="#F59E0B"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status.Name}" Value="Cancelled">
                                                                        <Setter Property="Background" Value="#64748B"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status.Name}" Value="Rejected">
                                                                        <Setter Property="Background" Value="#DC2626"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="16,16,18,16">
                                                        <TextBlock Text="{Binding TripPackage.Name, TargetNullValue=—, FallbackValue=—}"
                                                                   FontSize="17"
                                                                   FontWeight="Bold"
                                                                   Foreground="#0F172A"
                                                                   TextWrapping="Wrap"/>

                                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                            <Border CornerRadius="20"
                                                                    Padding="10,4"
                                                                    VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status.Name}" Value="Confirmed">
                                                                                <Setter Property="Background" Value="#CCFBF1"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status.Name}" Value="Pending">
                                                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status.Name}" Value="Cancelled">
                                                                                <Setter Property="Background" Value="#E2E8F0"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status.Name}" Value="Rejected">
                                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Text="{Binding Status.Name, TargetNullValue=—, FallbackValue=—}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="#475569"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status.Name}" Value="Confirmed">
                                                                                    <Setter Property="Foreground" Value="#0F766E"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status.Name}" Value="Pending">
                                                                                    <Setter Property="Foreground" Value="#B45309"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status.Name}" Value="Rejected">
                                                                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                            <TextBlock VerticalAlignment="Center"
                                                                       Margin="12,0,0,0"
                                                                       FontSize="13"
                                                                       Foreground="#64748B"
                                                                       Text="{Binding BookingDate, StringFormat=Booked on {0:dd MMM yyyy · HH:mm}, Mode=OneWay}"/>
                                                        </StackPanel>

                                                        <Grid Margin="0,14,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0"
                                                                    Margin="0,0,8,0"
                                                                    Background="#F8FAFC"
                                                                    BorderBrush="#E2E8F0"
                                                                    BorderThickness="1"
                                                                    CornerRadius="12"
                                                                    Padding="12,10">
                                                                <StackPanel>
                                                                    <TextBlock Text="Base price"
                                                                               FontSize="12"
                                                                               Foreground="#64748B"/>
                                                                    <TextBlock Margin="0,4,0,0"
                                                                               FontSize="16"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#0F172A"
                                                                               Text="{Binding BasePrice, StringFormat={}{0:N2} €}"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Grid.Column="1"
                                                                    Margin="8,0,0,0"
                                                                    Background="#ECFEFF"
                                                                    BorderBrush="#99F6E4"
                                                                    BorderThickness="1"
                                                                    CornerRadius="12"
                                                                    Padding="12,10">
                                                                <StackPanel>
                                                                    <TextBlock Text="Total"
                                                                               FontSize="12"
                                                                               Foreground="#0F766E"/>
                                                                    <TextBlock Margin="0,4,0,0"
                                                                               FontSize="16"
                                                                               FontWeight="Bold"
                                                                               Foreground="#0F766E"
                                                                               Text="{Binding TotalPrice, StringFormat={}{0:N2} €}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>

                                                        <ItemsControl ItemsSource="{Binding SelectedExtras}"
                                                                      Margin="0,12,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="#ECFEFF"
                                                                            CornerRadius="10"
                                                                            Padding="8,4"
                                                                            Margin="0,0,8,8">
                                                                        <TextBlock Text="{Binding}"
                                                                                   FontSize="12"
                                                                                   Foreground="#0F766E"
                                                                                   FontWeight="SemiBold"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>

                    <!-- Favorite packages -->
                    <Grid Visibility="{Binding FavoritesVisibility}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Your favorites"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,16"/>

                        <Border Grid.Row="1"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="18"
                                Margin="0,0,0,16"
                                Visibility="{Binding HasNoFavoritePackages, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" MaxWidth="440">
                                <TextBlock Text="You have not saved any packages yet."
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A"
                                           TextAlignment="Center"/>
                                <TextBlock Text="Browse packages and tap the heart on a card to add it here."
                                           FontSize="14"
                                           Foreground="#64748B"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,10,0,0"
                                           LineHeight="22"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="0,0,6,0"
                                      Visibility="{Binding HasFavoritePackages, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ClientScrollBarChrome}"/>
                            </ScrollViewer.Resources>
                            <ItemsControl ItemsSource="{Binding FavoritePackages}"
                                          ItemTemplate="{StaticResource TripPackageCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"
                                                     HorizontalAlignment="Stretch"
                                                     SnapsToDevicePixels="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Booking notifications -->
                <Grid Grid.ColumnSpan="2"
                      Panel.ZIndex="6"
                      Visibility="{Binding NotificationsVisibility}">
                    <Border Style="{StaticResource ClientGlassCard}"
                            Padding="24,20"
                            MaxWidth="820"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0"
                                    Content="Clear list"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,12"
                                    Padding="14,8"
                                    FontSize="13"
                                    Cursor="Hand"
                                    Background="#F1F5F9"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    Command="{Binding ClearBookingNotificationsCommand}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasBookingNotifications}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Border Grid.Row="1"
                                    Padding="40,56"
                                    CornerRadius="16"
                                    Background="#FAFBFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    VerticalAlignment="Stretch"
                                    Visibility="{Binding HasNoBookingNotifications, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                                    <TextBlock Text="No notifications yet"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="#0F172A"
                                               TextAlignment="Center"/>
                                    <TextBlock Text="Booking updates will appear here automatically."
                                               FontSize="14"
                                               Foreground="#64748B"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Margin="0,12,0,0"
                                               LineHeight="22"/>
                                </StackPanel>
                            </Border>
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="0,0,6,0"
                                          Visibility="{Binding HasBookingNotifications, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ClientScrollBarChrome}"/>
                                </ScrollViewer.Resources>
                                <ItemsControl ItemsSource="{Binding BookingNotifications}"
                                              ItemTemplate="{StaticResource BookingNotificationItemTemplate}"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Right Details Panel -->
                <Border Grid.Column="1"
                        Panel.ZIndex="0"
                        Visibility="{Binding ShowClientRightPanel, Converter={StaticResource BoolToVisibilityConverter}}"
                        Style="{StaticResource ClientGlassCard}"
                        Padding="18,20,10,20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ClientScrollBarChrome}"/>
                        </ScrollViewer.Resources>
                        <StackPanel>
                            <TextBlock Text="Package details"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,0,0,16"
                                       Visibility="{Binding ShowClientPackageFlowChrome, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <TextBlock Text="Booking &amp; package"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,0,0,16"
                                       Visibility="{Binding BookingsVisibility}"/>

                            <Border Padding="22,28"
                                    Margin="0,0,0,8"
                                    CornerRadius="16"
                                    Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    Visibility="{Binding ShowPackageBrowseEmptyState, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="No package selected"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="#0F172A"
                                               TextAlignment="Center"/>
                                    <TextBlock Text="Pick a package from the list and tap &quot;View Details&quot; for the description, EUR price summary, and optional extras."
                                               FontSize="14"
                                               Foreground="#64748B"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Margin="0,10,0,0"
                                               LineHeight="22"/>
                                </StackPanel>
                            </Border>

                            <Border Padding="22,28"
                                    Margin="0,0,0,8"
                                    CornerRadius="16"
                                    Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    Visibility="{Binding ShowFavoritesDetailsPlaceholder, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Select a favorite"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="#0F172A"
                                               TextAlignment="Center"/>
                                    <TextBlock Text="Tap &quot;View Details&quot; on a card in your favorites for details and booking."
                                               FontSize="14"
                                               Foreground="#64748B"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Margin="0,10,0,0"
                                               LineHeight="22"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Visibility="{Binding HasPackageDetails, Converter={StaticResource BoolToVisibilityConverter}}">

                            <Border Height="150"
                                    CornerRadius="14"
                                    Margin="0,0,0,16"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="ClientDetailsImage_MouseLeftButtonUp">
                                <Grid>
                                    <Image Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Source="{Binding SelectedPackage, Converter={StaticResource TripPackageToImageSourceConverter}}"/>
                                    <Border Background="#220F172A"/>
                                </Grid>
                            </Border>

                            <StackPanel Margin="0,0,0,16"
                                        Visibility="{Binding HasDestinationGalleryImages, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Destination — images"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#475569"
                                           Margin="0,0,0,8"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              Padding="0,0,0,4">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ClientScrollBarChrome}"/>
                                    </ScrollViewer.Resources>
                                    <ItemsControl ItemsSource="{Binding DestinationImageUrls}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="56"
                                                        Height="56"
                                                        CornerRadius="14"
                                                        Margin="0,0,10,0"
                                                        ClipToBounds="True"
                                                        Background="#E5E7EB"
                                                        Cursor="Hand"
                                                        MouseLeftButtonUp="ClientThumb_MouseLeftButtonUp"
                                                        Tag="{Binding}">
                                                    <Image Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Source="{Binding Converter={StaticResource UrlToProxyImageConverter}}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,16"
                                        Visibility="{Binding HasHotelGalleryImages, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Accommodation — hotels"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#475569"
                                           Margin="0,0,0,8"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              Padding="0,0,0,4">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ClientScrollBarChrome}"/>
                                    </ScrollViewer.Resources>
                                    <ItemsControl ItemsSource="{Binding HotelImageUrls}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="56"
                                                        Height="56"
                                                        CornerRadius="14"
                                                        Margin="0,0,10,0"
                                                        ClipToBounds="True"
                                                        Background="#E5E7EB"
                                                        Cursor="Hand"
                                                        MouseLeftButtonUp="ClientThumb_MouseLeftButtonUp"
                                                        Tag="{Binding}">
                                                    <Image Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Source="{Binding Converter={StaticResource UrlToProxyImageConverter}}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>

                            <TextBlock Text="{Binding SelectedPackage.Name}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,0,0,12"
                                       TextWrapping="Wrap"/>

                            <TextBlock Margin="0,3,0,0" FontSize="14" Foreground="#64748B">
                                <Run Text="Transport: " FontWeight="SemiBold" Foreground="#475569"/>
                                <Run Text="{Binding SelectedPackage.TransportDisplayName, Mode=OneWay}"/>
                            </TextBlock>

                            <TextBlock Margin="0,3,0,0" FontSize="14" Foreground="#64748B">
                                <Run Text="Stay: " FontWeight="SemiBold" Foreground="#475569"/>
                                <Run Text="{Binding SelectedPackage.StayDisplayName, Mode=OneWay}"/>
                            </TextBlock>

                            <TextBlock Margin="0,3,0,0" FontSize="14" Foreground="#64748B">
                                <Run Text="Destination: " FontWeight="SemiBold" Foreground="#475569"/>
                                <Run Text="{Binding SelectedPackage.Destination, Mode=OneWay}"/>
                            </TextBlock>

                            <TextBlock Margin="0,3,0,0" FontSize="14" Foreground="#64748B">
                                <Run Text="Country: " FontWeight="SemiBold" Foreground="#475569"/>
                                <Run Text="{Binding SelectedPackage.Country, Mode=OneWay}"/>
                            </TextBlock>

                            <TextBlock Margin="0,3,0,16" FontSize="14" Foreground="#64748B" TextWrapping="Wrap">
                                <Run Text="Description: " FontWeight="SemiBold" Foreground="#475569"/>
                                <Run Text="{Binding SelectedPackage.ShortDescription, Mode=OneWay}"/>
                            </TextBlock>

                            <!-- Price breakdown (also visible for bookings when a package is selected) -->
                            <Border Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="14"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Price summary"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#0F172A"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="All amounts are in euros (EUR) with the € symbol."
                                               FontSize="12"
                                               Foreground="#64748B"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12"/>

                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Base package price" FontSize="14" Foreground="#64748B"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding BasePrice, StringFormat={}{0:N2} €}"
                                                   FontSize="14"
                                                   Foreground="#0F172A"
                                                   FontWeight="SemiBold"/>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding AvailableExtras}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:OptionalExtra}">
                                                <Grid Margin="0,4,0,4">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="14" Foreground="#64748B" TextWrapping="Wrap">
                                                        <Run Text="Extra: " FontWeight="SemiBold" Foreground="#475569"/>
                                                        <Run Text="{Binding Name, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="1"
                                                               VerticalAlignment="Top"
                                                               Text="{Binding Price, StringFormat={}{0:N2} €}"
                                                               FontSize="14"
                                                               Foreground="#0F172A"
                                                               FontWeight="SemiBold"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Margin="0,8,0,4"
                                          Visibility="{Binding HasSelectedExtrasForPriceBreakdown, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Selected extras subtotal" FontSize="13" Foreground="#64748B" FontStyle="Italic"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SelectedExtrasSubtotal, StringFormat={}{0:N2} €}"
                                                   FontSize="13"
                                                   Foreground="#0F172A"
                                                   FontWeight="SemiBold"
                                                   FontStyle="Italic"/>
                                    </Grid>

                                    <Separator Margin="0,12,0,12" Background="#E2E8F0"/>

                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Total"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="#0F172A"/>
                                            <TextBlock Text="(final order total)"
                                                       FontSize="11"
                                                       Foreground="#94A3B8"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding TotalPrice, StringFormat={}{0:N2} €}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="#0F766E"/>
                                    </Grid>

                                    <Border Margin="0,12,0,0"
                                            Padding="10,8"
                                            CornerRadius="10"
                                            Background="#FFFBEB"
                                            BorderBrush="#FDE68A"
                                            BorderThickness="1"
                                            Visibility="{Binding ShowBookingTotalDisclaimer, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Foreground="#92400E">
                                            <Run Text="Note: " FontWeight="SemiBold"/>
                                            <Run Text="this booking total may not exactly match &quot;base price + extras&quot; above (for example discounts or surcharges at booking time). The correct amount is the Total (EUR) figure."/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <StackPanel Visibility="{Binding ShowClientPackageFlowChrome, Converter={StaticResource BoolToVisibilityConverter}}">
                            <!-- Extras -->
                            <TextBlock Text="Customize your trip"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,0,0,12"/>

                            <ItemsControl ItemsSource="{Binding AvailableExtras}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:OptionalExtra}">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Margin="0,8,0,8"
                                                  FontSize="14"
                                                  Cursor="Hand"
                                                  IsEnabled="{Binding DataContext.DetailsExtrasEditable, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <TextBlock>
                                                <Run Text="{Binding Name}"/>
                                                <Run Text=" (+"/>
                                                <Run Text="{Binding Price, StringFormat={}{0:N2}}"/>
                                                <Run Text=" €)"/>
                                            </TextBlock>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="Submit request"
                                    Height="44"
                                    Padding="18,0"
                                    FontSize="15"
                                    Style="{StaticResource ClientPrimaryButton}"
                                    Command="{Binding ConfirmBookingCommand}"/>
                            </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Profile: covers list + right panel -->
                <Border Grid.ColumnSpan="2"
                        Panel.ZIndex="10"
                        Visibility="{Binding ProfileVisibility}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,8,16">
                        <Border Style="{StaticResource ClientGlassCard}"
                                Padding="28,26"
                                MaxWidth="1040"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Margin="0,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="260"/>
                                    <ColumnDefinition Width="*" MinWidth="320"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Row="0"
                                        Grid.ColumnSpan="2"
                                        Background="#FEE2E2"
                                        BorderBrush="#FECACA"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="12,10"
                                        Margin="0,0,0,18"
                                        Visibility="{Binding ProfileIsBlocked, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding ProfileStatusHint}"
                                               FontSize="14"
                                               Foreground="#991B1B"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <!-- Left column: identity, status, stats, shortcuts -->
                                <StackPanel Grid.Row="1"
                                            Grid.Column="0"
                                            Margin="0,0,28,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="88"
                                                Height="88"
                                                CornerRadius="44"
                                                VerticalAlignment="Top">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#2B8CA3" Offset="0"/>
                                                    <GradientStop Color="#1F5E6B" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="{Binding ProfileUsername, Converter={StaticResource UsernameToInitialsConverter}}"
                                                       FontSize="28"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="18,8,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProfileUsername}"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0F172A"/>
                                            <TextBlock Text="{Binding ProfileRoleDisplay}"
                                                       FontSize="14"
                                                       Foreground="#64748B"
                                                       Margin="0,2,0,8"/>
                                            <Border CornerRadius="16"
                                                    Padding="10,4"
                                                    HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ProfileIsBlocked}" Value="True">
                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="12"
                                                           FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Active account"/>
                                                            <Setter Property="Foreground" Value="#166534"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ProfileIsBlocked}" Value="True">
                                                                    <Setter Property="Text" Value="Account blocked"/>
                                                                    <Setter Property="Foreground" Value="#991B1B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Text="{Binding ProfileAccountSummaryLine}"
                                               FontSize="13"
                                               Foreground="#64748B"
                                               TextWrapping="Wrap"
                                               Margin="0,14,0,0"/>

                                    <TextBlock Text="Activity"
                                               FontWeight="SemiBold"
                                               Foreground="#334155"
                                               FontSize="14"
                                               Margin="0,22,0,10"/>

                                    <UniformGrid Columns="3"
                                                 Margin="0,0,0,8">
                                        <Border Background="#F8FAFC"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="10,12"
                                                Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ProfileBookingsCount}"
                                                           FontSize="22"
                                                           FontWeight="SemiBold"
                                                           Foreground="#0F766E"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="Bookings"
                                                           FontSize="12"
                                                           Foreground="#64748B"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#F8FAFC"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="10,12"
                                                Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ProfileFavoritesCount}"
                                                           FontSize="22"
                                                           FontWeight="SemiBold"
                                                           Foreground="#B45309"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="Favorite"
                                                           FontSize="12"
                                                           Foreground="#64748B"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#F8FAFC"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="10,12">
                                            <StackPanel>
                                                <TextBlock Text="{Binding AgencyInboxUnreadCount}"
                                                           FontSize="22"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1D4ED8"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="Unread messages"
                                                           FontSize="12"
                                                           Foreground="#64748B"
                                                           HorizontalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <TextBlock Text="Shortcuts"
                                               FontWeight="SemiBold"
                                               Foreground="#334155"
                                               FontSize="14"
                                               Margin="0,18,0,10"/>

                                    <StackPanel>
                                        <Button Content="Open my bookings"
                                                Height="42"
                                                Padding="14,0"
                                                Margin="0,0,0,8"
                                                HorizontalAlignment="Stretch"
                                                FontSize="14"
                                                Style="{StaticResource ClientGhostNavButton}"
                                                Command="{Binding ShowBookingsCommand}"/>
                                        <Button Content="Open favorites"
                                                Height="42"
                                                Padding="14,0"
                                                Margin="0,0,0,8"
                                                HorizontalAlignment="Stretch"
                                                FontSize="14"
                                                Style="{StaticResource ClientGhostNavButton}"
                                                Command="{Binding ShowFavoritesCommand}"/>
                                        <Button Content="Messages with agency"
                                                Height="42"
                                                Padding="14,0"
                                                HorizontalAlignment="Stretch"
                                                FontSize="14"
                                                Style="{StaticResource ClientGhostNavButton}"
                                                Command="{Binding OpenAgencyMessagesCommand}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right column: editable contact -->
                                <StackPanel Grid.Row="1"
                                            Grid.Column="1">
                                    <TextBlock Text="Contact details"
                                               FontWeight="SemiBold"
                                               Foreground="#0F172A"
                                               FontSize="16"
                                               Margin="0,0,0,14"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="E-mail"
                                                   FontWeight="SemiBold"
                                                   Foreground="#475569"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,12"/>
                                        <TextBox Grid.Row="0"
                                                 Grid.Column="1"
                                                 Height="40"
                                                 FontSize="14"
                                                 Style="{StaticResource ClientFieldTextBox}"
                                                 Padding="10,0,10,0"
                                                 Margin="0,0,0,12"
                                                 Text="{Binding ProfileEmail, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock Grid.Row="1"
                                                   Text="Phone"
                                                   FontWeight="SemiBold"
                                                   Foreground="#475569"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>
                                        <TextBox Grid.Row="1"
                                                 Grid.Column="1"
                                                 Height="40"
                                                 FontSize="14"
                                                 Style="{StaticResource ClientFieldTextBox}"
                                                 Padding="10,0,10,0"
                                                 Text="{Binding ProfilePhone, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>

                                    <TextBlock Text="Password cannot be changed from this profile. Use &quot;Forgot password?&quot; on the sign-in screen — the same secure email/link flow."
                                               FontSize="13"
                                               Foreground="#64748B"
                                               TextWrapping="Wrap"
                                               Margin="0,14,0,0"/>

                                    <Button Content="Save changes"
                                            Height="44"
                                            Padding="20,0"
                                            FontSize="15"
                                            Margin="0,20,0,0"
                                            HorizontalAlignment="Left"
                                            Command="{Binding SaveProfileCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ClientPrimaryButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ProfileIsBlocked}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>