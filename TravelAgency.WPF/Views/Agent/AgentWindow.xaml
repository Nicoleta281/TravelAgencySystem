<Window x:Class="TravelAgency.WPF.Views.Agent.AgentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent Workspace"
        Height="800"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#EEF1F8"
        FontFamily="Segoe UI">

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="28"
                          ShadowDepth="4"
                          Direction="270"
                          Opacity="0.09"
                          Color="#0F172A"/>

        <Style x:Key="ElevatedPanel" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="RoundedBarButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,0,0,0"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBg" Property="Background" Value="#1E3A5F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0B1526" Offset="0"/>
                    <GradientStop Color="#132F52" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Logo / Title -->
                <StackPanel Grid.Row="0" Margin="20,28,20,24" HorizontalAlignment="Stretch">
                    <Border Width="56"
                            Height="56"
                            CornerRadius="16"
                            HorizontalAlignment="Left"
                            Background="#1D4ED8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.35" Color="#2563EB"/>
                        </Border.Effect>
                        <TextBlock Text="TA"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="White"/>
                    </Border>
                    <TextBlock Text="Travel Agency"
                               Foreground="#F8FAFC"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,16,0,0"/>
                    <TextBlock Text="Agent workspace"
                               Foreground="#94A3B8"
                               FontSize="12"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1" Margin="14,0,14,20">
                    <TextBlock Text="MENU"
                               Foreground="#64748B"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="10,0,0,10"/>

                    <Button Content="Dashboard"
                            Style="{StaticResource SidebarButtonStyle}"
                            Background="#2563EB"
                            Foreground="White"
                            Command="{Binding ShowDashboardCommand}"/>

                    <Button Content="Packages"
                            Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding ShowPackagesCommand}"/>

                    <Button Content="Bookings"
                            Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding ShowBookingsCommand}"/>

                    <Button Content="Clients"
                            Style="{StaticResource SidebarButtonStyle}"/>

                    <Button Content="Reports"
                            Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding ShowReportsCommand}"/>

                    <Border Height="1" Background="#1E3A5F" Margin="8,16,8,12"/>

                    <Button Content="Logout"
                            Height="46"
                            Margin="0,4,0,0"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Command="{Binding LogoutCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Lg"
                                        Background="#DC2626"
                                        CornerRadius="12">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Lg" Property="Background" Value="#B91C1C"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
       
        <!-- Main Content -->
        <Grid Grid.Column="1"
      Margin="24"
      Visibility="{Binding PackagesVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="120"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            

            <!-- Header -->
            <Border Grid.Row="0"
                    Style="{StaticResource ElevatedPanel}"
                    Padding="26,22"
                    Margin="0,0,0,20"
                    Grid.ColumnSpan="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Travel Packages"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                        <TextBlock Text="Manage offers and bookings in one place"
                                   FontSize="14"
                                   Foreground="#64748B"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Margin="16,0,16,0"
                            VerticalAlignment="Center"
                            Background="#F8FAFC"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="12"
                            Height="44"
                            Padding="2,0,12,0">
                        <Grid>
                            <TextBox x:Name="SearchBox"
                                     Margin="14,0,12,0"
                                     Height="40"
                                     Padding="0,0,0,0"
                                     VerticalContentAlignment="Center"
                                     FontSize="14"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Search packages…"
                                       Margin="16,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#94A3B8"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Button Content="Create Package"
                                Style="{StaticResource RoundedBarButton}"
                                Background="#2563EB"
                                Foreground="White"
                                BorderThickness="0"
                                Margin="0,0,10,0"
                                Click="CreatePackage_Click"/>

                        <Button Content="Quick Create"
                                Style="{StaticResource RoundedBarButton}"
                                Background="#059669"
                                Foreground="White"
                                BorderThickness="0"
                                Click="QuickCreatePackage_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Stats -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ElevatedPanel}" Padding="0">
                    <Grid>
                        <Border Height="3" Background="#2563EB" CornerRadius="16,16,0,0" VerticalAlignment="Top"/>
                        <StackPanel Margin="22,18,22,20">
                            <TextBlock Text="Total packages" FontSize="13" Foreground="#64748B"/>
                            <TextBlock Text="{Binding TotalPackagesCount}"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource ElevatedPanel}" Padding="0">
                    <Grid>
                        <Border Height="3" Background="#059669" CornerRadius="16,16,0,0" VerticalAlignment="Top"/>
                        <StackPanel Margin="22,18,22,20">
                            <TextBlock Text="Active offers" FontSize="13" Foreground="#64748B"/>
                            <TextBlock Text="{Binding ActiveOffersCount}"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource ElevatedPanel}" Padding="0">
                    <Grid>
                        <Border Height="3" Background="#D97706" CornerRadius="16,16,0,0" VerticalAlignment="Top"/>
                        <StackPanel Margin="22,18,22,20">
                            <TextBlock Text="Average price" FontSize="13" Foreground="#64748B"/>
                            <TextBlock Text="{Binding AveragePriceText, StringFormat=€ {0}}"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="6" Style="{StaticResource ElevatedPanel}" Padding="0">
                    <Grid>
                        <Border Height="3" Background="#7C3AED" CornerRadius="16,16,0,0" VerticalAlignment="Top"/>
                        <StackPanel Margin="22,18,22,20">
                            <TextBlock Text="Total value" FontSize="13" Foreground="#64748B"/>
                            <TextBlock Text="{Binding TotalValueText, StringFormat=€ {0}}"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Main Area -->
            <Grid Grid.Row="2"
                  Grid.ColumnSpan="3"
                  Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*" MinWidth="320"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1.15*" MinWidth="300"/>
                </Grid.ColumnDefinitions>

                <!-- Recent + booking requests -->
                <Grid Grid.Column="0" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: RECENT PACKAGES -->
                    <Border Grid.Column="0"
                            Style="{StaticResource ElevatedPanel}"
                            Padding="22"
                            HorizontalAlignment="Stretch"
                            MaxWidth="520">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="246*"/>
                                <ColumnDefinition Width="49*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Recent packages"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#0F172A"
                       Margin="0,0,0,4" Grid.ColumnSpan="2"/>
                            <TextBlock Text="Click a card to see details on the right"
                       FontSize="12"
                       Foreground="#64748B"
                       Margin="0,0,0,14" Grid.ColumnSpan="2"/>

                            <ListBox
                     ItemsSource="{Binding TripsView}"
                     SelectedItem="{Binding SelectedTrip, Mode=TwoWay}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     HorizontalContentAlignment="Stretch" Grid.ColumnSpan="2" Margin="0,52,0,0" Grid.RowSpan="2">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>

                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,12,12"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="OuterBorder"
                                            Background="Transparent"
                                            CornerRadius="14">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="OuterBorder" Property="Background" Value="#DBEAFE"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="210"
                                Background="#FFFFFF"
                                CornerRadius="14"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1">
                                            <StackPanel>
                                                <Border Height="95"
                                        Background="#DCEBFA"
                                        CornerRadius="14,14,0,0"/>

                                                <StackPanel Margin="12">
                                                    <TextBlock Text="{Binding Name}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#1F2937"
                                               TextWrapping="Wrap"/>

                                                    <TextBlock Text="{Binding TransportName, StringFormat=Transport: {0}}"
                                               Margin="0,4,0,2"
                                               FontSize="12"
                                               Foreground="#6B7280"/>

                                                    <TextBlock Text="{Binding StayName, StringFormat=Accommodation: {0}}"
                                               Margin="0,0,0,6"
                                               FontSize="12"
                                               Foreground="#64748B"/>

                                                    <TextBlock Text="{Binding Price, StringFormat=€ {0:F2}}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#1F2937"
                                               Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- MIDDLE: BOOKING REQUESTS -->
                    <Border Grid.Column="2"
                            Style="{StaticResource ElevatedPanel}"
                            Padding="22"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Stretch"
                            MaxWidth="520">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="122*"/>
                                <ColumnDefinition Width="137*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="41.62"/>
                                <RowDefinition Height="28.263"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Margin="0,0,0,16" Grid.RowSpan="2" Grid.ColumnSpan="2">
                                <TextBlock Text="Booking requests"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>
                                <TextBlock Text="Review and manage pending bookings"
                           FontSize="12"
                           Foreground="#64748B"
                           Margin="0,6,0,0"/>
                            </StackPanel>

                            <ListBox Grid.Row="2"
         ItemsSource="{Binding PendingBookings}"
         SelectedItem="{Binding SelectedBooking, Mode=TwoWay}"
         BorderThickness="0"
         Background="Transparent"
         ScrollViewer.VerticalScrollBarVisibility="Auto"
         HorizontalContentAlignment="Stretch"
Margin="0,0,0,0"
Grid.RowSpan="1"
         Grid.ColumnSpan="2">

                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,12"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="OuterBorder"
                                Background="Transparent"
                                CornerRadius="12">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="OuterBorder" Property="Background" Value="#EAF2FF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="14"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12"
                Background="#FAFBFF"
                Opacity="1">
                                            <Border.RenderTransform>
                                                <TranslateTransform X="0"/>
                                            </Border.RenderTransform>

                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBeingRemoved}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.35"/>

                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="80"
                                                         Duration="0:0:0.35"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <StackPanel>
                                                <TextBlock Text="{Binding TripPackage.Name}"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#1F2937"/>

                                                <TextBlock Margin="0,8,0,0"
                           Text="{Binding Client.Username, StringFormat=Client: {0}}"
                           Foreground="#374151"/>

                                                <TextBlock Margin="0,4,0,0"
                           Text="{Binding BookingDate, StringFormat=Booked on: {0:dd MMM yyyy HH:mm}}"
                           Foreground="#374151"/>

                                                <TextBlock Margin="0,4,0,0"
                           Text="{Binding Status.Name, StringFormat=Status: {0}}"
                           Foreground="#374151"/>

                                                <TextBlock Margin="0,4,0,0"
                           Text="{Binding TotalPrice, StringFormat=Total Price: € {0:F2}}"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"/>

                                                <ItemsControl ItemsSource="{Binding SelectedExtras}"
                              Margin="0,10,0,0"
                              IsHitTestVisible="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#E5EDFF"
                                    CornerRadius="8"
                                    Padding="8,4"
                                    Margin="0,0,8,8"
                                    HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding}"
                                           Foreground="#2F5BD1"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Grid Grid.Row="3" Margin="0,16,0,0" Grid.ColumnSpan="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                        Content="Refresh"
                        Style="{StaticResource RoundedBarButton}"
                        Background="#F1F5F9"
                        Foreground="#0F172A"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Command="{Binding RefreshPendingBookingsCommand}"/>

                                <Button Grid.Column="2"
                        Content="Approve"
                        Style="{StaticResource RoundedBarButton}"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Command="{Binding ApproveBookingCommand}"/>

                                <Button Grid.Column="4"
                        Content="Reject"
                        Style="{StaticResource RoundedBarButton}"
                        Background="#DC2626"
                        Foreground="White"
                        BorderThickness="0"
                        Command="{Binding RejectBookingCommand}"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                <!-- Right section -->
                <Border Grid.Column="2"
                        Style="{StaticResource ElevatedPanel}"
                        Padding="22"
                        HorizontalAlignment="Stretch"
                        Margin="0,16,0,0"
                        MaxWidth="440">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="#F8FAFC"
        BorderBrush="#E2E8F0"
        BorderThickness="1"
        CornerRadius="14"
        Padding="24"
        Margin="0,0,0,16"
        MinHeight="120"
        HorizontalAlignment="Stretch">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTrip}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="No package selected"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#1F2937"
                   HorizontalAlignment="Center"/>
                                    <TextBlock Text="Select a package from the list to see its details here."
                   FontSize="14"
                   Foreground="#6B7280"
                   Margin="0,8,0,0"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Width="250"/>
                                </StackPanel>
                            </Border>


                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTrip}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>


                                <!-- Top banner -->
                                <Border Height="170"
                    CornerRadius="14"
                    Margin="0,0,0,18">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#DBEAFE" Offset="0"/>
                                            <GradientStop Color="#BFDBFE" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <TextBlock Text="{Binding SelectedTrip.Name, TargetNullValue=NO PACKAGE}"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#1F3A5F"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="12"/>
                                    </Grid>
                                </Border>

                                <!-- Title -->
                                <TextBlock Text="{Binding SelectedTrip.Name, TargetNullValue=No package selected}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#1F2937"/>

                                <TextBlock Text="{Binding SelectedTrip.Season.Name, TargetNullValue=No season}"
                       FontSize="15"
                       Foreground="#6B7280"
                       Margin="0,6,0,16"/>

                                <!-- Price -->
                                <Border Background="#F3F8FF"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Price"
                               FontSize="14"
                               Foreground="#6B7280"/>
                                        <TextBlock Text="{Binding SelectedTrip.Price, StringFormat=€ {0:F2}, TargetNullValue=-}"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#1F2937"
                               Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Details -->
                                <Border Background="#FAFBFF"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Package Details"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               Margin="0,0,0,12"/>

                                        <TextBlock Margin="0,0,0,8">
                        <Run Text="Transport: "/>
                        <Run Text="{Binding SelectedTrip.TransportName, Mode=OneWay, TargetNullValue=N/A}"/>
                                        </TextBlock>

                                        <TextBlock Margin="0,0,0,8">
                        <Run Text="Accommodation: "/>
                        <Run Text="{Binding SelectedTrip.StayName, Mode=OneWay, TargetNullValue=N/A}"/>
                                        </TextBlock>

                                        <TextBlock Margin="0,0,0,8">
                        <Run Text="Season: "/>
                        <Run Text="{Binding SelectedTrip.Season.Name, TargetNullValue=N/A}"/>
                                        </TextBlock>

                                        <TextBlock Margin="0,0,0,8">
                        <Run Text="Start Date: "/>
                        <Run Text="{Binding SelectedTrip.Season.StartDate, StringFormat={}{0:dd MMM yyyy}, TargetNullValue=-}"/>
                                        </TextBlock>

                                        <TextBlock Margin="0,0,0,8">
                        <Run Text="End Date: "/>
                        <Run Text="{Binding SelectedTrip.Season.EndDate, StringFormat={}{0:dd MMM yyyy}, TargetNullValue=-}"/>
                                        </TextBlock>

                                        <TextBlock>
                        <Run Text="Days Count: "/>
                        <Run Text="{Binding SelectedTrip.DaysCount, Mode=OneWay, TargetNullValue=0}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Extra services -->
                                <Border Background="#FAFBFF"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="Extra Services"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               Margin="0,0,0,10"/>

                                        <ItemsControl ItemsSource="{Binding SelectedTrip.ExtraServiceNames}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#E5EDFF"
                                        CornerRadius="8"
                                        Padding="8,4"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding}"
                                               Foreground="#2F5BD1"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="No extra services"
                               Foreground="#6B7280">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedTrip.ExtraServices.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedTrip}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
            Content="Edit"
            Style="{StaticResource RoundedBarButton}"
            Background="#F1F5F9"
            Foreground="#0F172A"
            BorderBrush="#CBD5E1"
            BorderThickness="1"
            Click="EditPackage_Click"/>

                                    <Button Grid.Column="2"
            Content="Clone"
            Style="{StaticResource RoundedBarButton}"
            Background="#2563EB"
            Foreground="White"
            BorderThickness="0"
            Command="{Binding CloneCommand}"/>

                                    <Button Grid.Column="4"
            Content="Delete"
            Style="{StaticResource RoundedBarButton}"
            Background="#DC2626"
            Foreground="White"
            BorderThickness="0"
            Command="{Binding DeleteCommand}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- REPORTS -->
        <Grid Grid.Column="1"
      Margin="24"
      Visibility="{Binding ReportsVisibility}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
            Background="White"
            CornerRadius="16"
            Padding="24">
                <StackPanel>
                    <TextBlock Text="Generate Reports"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#1F2937"/>

                    <TextBlock Text="Export booking reports in PDF, CSV or TXT format"
                       FontSize="14"
                       Foreground="#6B7280"
                       Margin="0,6,0,20"/>

                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="250"
                          Height="40"
                          Margin="0,0,12,0"
                          ItemsSource="{Binding ReportTypes}"
                          SelectedItem="{Binding SelectedReportType}"/>

                        <ComboBox Width="140"
                          Height="40"
                          Margin="0,0,12,0"
                          ItemsSource="{Binding ExportFormats}"
                          SelectedItem="{Binding SelectedExportFormat}"/>

                        <Button Content="Generate"
                        Width="120"
                        Height="40"
                        Background="#2F80ED"
                        Foreground="White"
                        BorderBrush="Transparent"
                        FontWeight="SemiBold"
                        Command="{Binding GenerateReportCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
            Background="White"
            CornerRadius="16"
            Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Pending Bookings Preview"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#1F2937"/>

                        <TextBlock Text="These are the booking requests currently loaded for report generation"
                           FontSize="14"
                           Foreground="#6B7280"
                           Margin="0,6,0,18"/>
                    </StackPanel>

                    <ListBox Grid.Row="1"
         ItemsSource="{Binding ReportPreviewBookings}"
         BorderThickness="0"
         Background="Transparent"
         HorizontalContentAlignment="Stretch"
         ScrollViewer.VerticalScrollBarVisibility="Auto"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,12"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="12"
                    Background="#FAFBFF">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TripPackage.Name}"
                               FontSize="16"
                               FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Client.Username, StringFormat=Client: {0}}"/>
                                        <TextBlock Text="{Binding BookingDate, StringFormat=Booked on: {0:dd MMM yyyy HH:mm}}"/>
                                        <TextBlock Text="{Binding Status.Name, StringFormat=Status: {0}}"/>
                                        <TextBlock Text="{Binding TotalPrice, StringFormat=Total Price: € {0:F2}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Column="1"
      Margin="24"
      Visibility="{Binding IsBookingsVisible, Converter={StaticResource BoolToVisibilityConverter}}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Bookings"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#1F2937"/>

                <TextBlock Text="Manage and filter booking requests"
                   FontSize="14"
                   Foreground="#6B7280"
                   Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Filters -->
            <StackPanel Grid.Row="1"
            Orientation="Horizontal"
            Margin="0,0,0,16">
                <Button Content="All"
            Width="100"
            Height="40"
            Margin="0,0,10,0"
            Background="#F3F4F6"
            Foreground="#1F2937"
            BorderBrush="#D1D5DB"
            FontWeight="SemiBold"
            Command="{Binding ShowAllBookingsCommand}"/>

                <Button Content="Pending"
            Width="100"
            Height="40"
            Margin="0,0,10,0"
            Background="#F3F4F6"
            Foreground="#1F2937"
            BorderBrush="#D1D5DB"
            FontWeight="SemiBold"
            Command="{Binding ShowPendingBookingsCommand}"/>

                <Button Content="Confirmed"
            Width="110"
            Height="40"
            Margin="0,0,10,0"
            Background="#F3F4F6"
            Foreground="#1F2937"
            BorderBrush="#D1D5DB"
            FontWeight="SemiBold"
            Command="{Binding ShowConfirmedBookingsCommand}"/>

                <Button Content="Rejected"
            Width="110"
            Height="40"
            Background="#F3F4F6"
            Foreground="#1F2937"
            BorderBrush="#D1D5DB"
            FontWeight="SemiBold"
            Command="{Binding ShowRejectedBookingsCommand}"/>
            </StackPanel>

            <!-- List -->
            <ListBox Grid.Row="2"
         ItemsSource="{Binding AgentBookings}"
         SelectedItem="{Binding SelectedBooking, Mode=TwoWay}"
         BorderThickness="0"
         Background="Transparent"
         HorizontalContentAlignment="Stretch"
         ScrollViewer.VerticalScrollBarVisibility="Auto">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,12"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="OuterBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="14"
                                Padding="2">
                                        <ContentPresenter/>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="OuterBorder" Property="Background" Value="#EAF2FF"/>
                                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#2F80ED"/>
                                        </Trigger>

                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="OuterBorder" Property="Background" Value="#F3F8FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="12"
                    Background="#FAFBFF">
                            <StackPanel>
                                <TextBlock Text="{Binding TripPackage.Name}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#1F2937"/>

                                <TextBlock Text="{Binding Client.Username, StringFormat=Client: {0}}"
                               Margin="0,8,0,0"
                               Foreground="#374151"/>

                                <TextBlock Text="{Binding BookingDate, StringFormat=Booked on: {0:dd.MM.yyyy HH:mm}}"
                               Margin="0,4,0,0"
                               Foreground="#374151"/>

                                <TextBlock Text="{Binding StatusName, StringFormat=Status: {0}}"
                               Margin="0,4,0,0"
                               Foreground="#374151"/>

                                <TextBlock Text="{Binding TotalPrice, StringFormat=Total: € {0:F2}}"
                               Margin="0,4,0,0"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Actions -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                Content="Approve"
                Height="42"
                Background="#2F80ED"
                Foreground="White"
                BorderBrush="Transparent"
                FontWeight="SemiBold"
                Command="{Binding ApproveBookingCommand}"/>

                <Button Grid.Column="2"
                Content="Reject"
                Height="42"
                Background="#E74C3C"
                Foreground="White"
                BorderBrush="Transparent"
                FontWeight="SemiBold"
                Command="{Binding RejectBookingCommand}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>