<Window x:Class="TravelAgency.WPF.Views.Agent.AgentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:TravelAgency.WPF.Converters"
        Title="Spațiu agent"
        Height="800"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#E2E8F0"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>

        <!-- Siluetă avion mică pentru stratul „cer” -->
        <Geometry x:Key="AgentSkyPlaneGeometry">M2,18 L36,11 L44,11 L38,19 L28,17 L2,21 Z</Geometry>

        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <c:StringEqualsConverter x:Key="StringEqualsConverter"/>
        <c:TripPackageToImageSourceConverter x:Key="TripPackageToImageSourceConverter"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="22"
                          ShadowDepth="2"
                          Direction="270"
                          Opacity="0.06"
                          Color="#1E293B"/>

        <!-- Umbră discretă pentru carduri „sticlă” -->
        <DropShadowEffect x:Key="GlassCardShadow"
                          BlurRadius="26"
                          ShadowDepth="1"
                          Direction="270"
                          Opacity="0.055"
                          Color="#0F172A"/>

        <DropShadowEffect x:Key="GlassShadow"
                          BlurRadius="34"
                          ShadowDepth="10"
                          Direction="270"
                          Opacity="0.18"
                          Color="#020617"/>

        <!-- Minimal scrollbars (C) -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid SnapsToDevicePixels="True"
                              Background="Transparent">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineUpCommand"
                                                  Opacity="0"
                                                  Focusable="False"
                                                  IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb"
                                           Margin="2"
                                           Background="#66FFFFFF">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="10"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineDownCommand"
                                                  Opacity="0"
                                                  Focusable="False"
                                                  IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="Thumb" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Background" Value="#99FFFFFF"/>
                            </Trigger>
                            <Trigger SourceName="Thumb" Property="IsDragging" Value="True">
                                <Setter TargetName="Thumb" Property="Background" Value="#CCFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollViewer}">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style x:Key="ElevatedPanel" TargetType="Border">
            <Setter Property="Background" Value="#88FFFFFF"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#A6FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect" Value="{StaticResource GlassCardShadow}"/>
        </Style>

        <!-- Dashboard: sticlă mai pronunțată -->
        <Style x:Key="DashboardPanel" TargetType="Border">
            <Setter Property="Background" Value="#88FFFFFF"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="#A6FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect" Value="{StaticResource GlassCardShadow}"/>
        </Style>

        <!-- KPI: fără animație translate (evită tăieri la cifre / simbol €) -->
        <Style x:Key="DashboardKpiCard" TargetType="Border" BasedOn="{StaticResource DashboardPanel}"/>

        <!-- Kept key name for XAML; same light surface as dashboard (was dark glass — poor contrast) -->
        <Style x:Key="DashboardDarkCard" TargetType="Border">
            <Setter Property="Background" Value="#88FFFFFF"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="#A6FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect" Value="{StaticResource GlassCardShadow}"/>
        </Style>

        <Style x:Key="DashboardDarkInset" TargetType="Border">
            <Setter Property="Background" Value="#70D6EEF3"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#85A9CCD6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="RoundedBarButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.94"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AgentSecondaryOnDarkButton" TargetType="Button" BasedOn="{StaticResource RoundedBarButton}">
            <Setter Property="Background" Value="#14263F"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="DashboardTabButton" TargetType="Button" BasedOn="{StaticResource RoundedBarButton}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#D6EEF3"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#A9CCD6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Butoane secundare: aceeași familie cromatică ca primarul (indigo discret) -->
        <Style x:Key="AgentSecondaryButton" TargetType="Button" BasedOn="{StaticResource RoundedBarButton}">
            <Setter Property="Background" Value="#D6EEF3"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#A9CCD6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="AgentPrimaryButton" TargetType="Button" BasedOn="{StaticResource RoundedBarButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <!-- modern teal -> indigo -->
                        <GradientStop Color="#2B8CA3" Offset="0"/>
                        <GradientStop Color="#1F5E6B" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pachete: butoane din header (glass + accent din fundal) -->
        <Style x:Key="PackagesHeaderPrimaryButton" TargetType="Button" BasedOn="{StaticResource RoundedBarButton}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2B8CA3" Offset="0"/>
                        <GradientStop Color="#1F5E6B" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PackagesHeaderSecondaryButton" TargetType="Button" BasedOn="{StaticResource RoundedBarButton}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#A9CCD6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#55FFFFFF"/>
        </Style>

        <Style x:Key="AgentDangerButton" TargetType="Button" BasedOn="{StaticResource RoundedBarButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <!-- warm coral -> amber (less harsh than pure red) -->
                        <GradientStop Color="#F43F5E" Offset="0"/>
                        <GradientStop Color="#F59E0B" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small modern icon actions (for cards) -->
        <Style x:Key="AgentIconActionButtonBase" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CFE3EA"/>
            <Setter Property="Background" Value="#F3F8FF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#EAF2FF"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#A9CCD6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#DDEBFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AgentIconPrimaryButton" TargetType="Button" BasedOn="{StaticResource AgentIconActionButtonBase}">
            <Setter Property="Background" Value="#E8F7FA"/>
            <Setter Property="BorderBrush" Value="#BFE4EC"/>
            <Setter Property="Foreground" Value="#0B3A44"/>
            <Setter Property="ToolTipService.ShowDuration" Value="8000"/>
        </Style>

        <Style x:Key="AgentIconSecondaryButton" TargetType="Button" BasedOn="{StaticResource AgentIconActionButtonBase}">
            <Setter Property="ToolTipService.ShowDuration" Value="8000"/>
        </Style>

        <Style x:Key="AgentIconDangerButton" TargetType="Button" BasedOn="{StaticResource AgentIconActionButtonBase}">
            <Setter Property="Background" Value="#FFF1F2"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="Foreground" Value="#9F1239"/>
            <Setter Property="ToolTipService.ShowDuration" Value="8000"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE4E6"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FECDD3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Show action bar only on hover of the element itself -->
        <Style x:Key="AgentHoverActionsBar" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="6"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform Y="0"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,0,0,0"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Active item -->
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource StringEqualsConverter}">
                                        <Binding RelativeSource="{RelativeSource Self}" Path="Tag"/>
                                        <Binding Path="NavSection"/>
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="NavBg" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#2B8CA3" Offset="0"/>
                                            <GradientStop Color="#1F5E6B" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="NavBg" Property="BorderBrush" Value="#33FFFFFF"/>
                                <Setter TargetName="NavBg" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="18"
                                                          ShadowDepth="0"
                                                          Opacity="0.35"
                                                          Color="#2B8CA3"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>

                            <!-- Hover (only when NOT active) -->
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource StringEqualsConverter}" ConverterParameter="Invert">
                                        <Binding RelativeSource="{RelativeSource Self}" Path="Tag"/>
                                        <Binding Path="NavSection"/>
                                        <Binding RelativeSource="{RelativeSource Self}" Path="IsMouseOver"/>
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter TargetName="NavBg" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="NavBg" Property="BorderBrush" Value="#CBD5E1"/>
                            </DataTrigger>

                            <!-- Pressed (only when NOT active) -->
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource StringEqualsConverter}" ConverterParameter="Invert">
                                        <Binding RelativeSource="{RelativeSource Self}" Path="Tag"/>
                                        <Binding Path="NavSection"/>
                                        <Binding RelativeSource="{RelativeSource Self}" Path="IsPressed"/>
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter TargetName="NavBg" Property="Background" Value="#E2E8F0"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.01"
                                                 Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.01"
                                                 Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1"
                                                 Duration="0:0:0.16"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1"
                                                 Duration="0:0:0.16"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <!-- Fundal: „Ken Burns” discret -->
                    <DoubleAnimation Storyboard.TargetName="AgentBgScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="1"
                                     To="1.03"
                                     Duration="0:0:24"
                                     AutoReverse="True">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="AgentBgScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="1"
                                     To="1.03"
                                     Duration="0:0:24"
                                     AutoReverse="True">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="AgentBgPan"
                                     Storyboard.TargetProperty="X"
                                     From="-8"
                                     To="10"
                                     Duration="0:0:30"
                                     AutoReverse="True">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="AgentBgPan"
                                     Storyboard.TargetProperty="Y"
                                     From="-5"
                                     To="6"
                                     Duration="0:0:27"
                                     AutoReverse="True">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <!-- Wash discret care pulsează -->
                    <DoubleAnimation Storyboard.TargetName="AmbWashLayer"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.88"
                                     To="1"
                                     Duration="0:0:5"
                                     AutoReverse="True">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <!-- Logo sidebar -->
                    <DoubleAnimation Storyboard.TargetName="SidebarLogoFloat"
                                     Storyboard.TargetProperty="Y"
                                     From="0"
                                     To="-3"
                                     Duration="0:0:2.6"
                                     AutoReverse="True">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <!-- Avioane -->
                    <DoubleAnimation Storyboard.TargetName="SkyPlane1"
                                     Storyboard.TargetProperty="(Canvas.Left)"
                                     From="-100"
                                     To="1500"
                                     Duration="0:0:42"
                                     RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="SkyPlane2"
                                     Storyboard.TargetProperty="(Canvas.Left)"
                                     From="-120"
                                     To="1500"
                                     Duration="0:0:58"
                                     BeginTime="0:0:14"
                                     RepeatBehavior="Forever"/>
                    <!-- „Nor” discret -->
                    <DoubleAnimation Storyboard.TargetName="SkyCloudDrift"
                                     Storyboard.TargetProperty="X"
                                     From="0"
                                     To="40"
                                     Duration="0:0:45"
                                     AutoReverse="True">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Fundal: Uniform = proporții corecte, fără Max — imaginea se scalează la maxim în fereastră -->
        <Grid Grid.ColumnSpan="2" IsHitTestVisible="False">
            <Image x:Name="AgentBgImage"
                   Source="pack://application:,,,/TravelAgency.WPF;component/Assets/agent-bg-marseille.jpg"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Opacity="0.88"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SnapsToDevicePixels="True"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="AgentBgScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="AgentBgPan" X="0" Y="0"/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
            <Border x:Name="AmbWashLayer">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#28E8EDF4" Offset="0"/>
                        <GradientStop Color="#34EEF2F7" Offset="0.5"/>
                        <GradientStop Color="#42F4F6FA" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                BorderBrush="#99E2E8F0"
                BorderThickness="0,0,1,0"
                Background="#C0FAFCFF">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Logo / Title -->
                <StackPanel Grid.Row="0" Margin="20,28,20,24" HorizontalAlignment="Stretch">
                    <Border x:Name="SidebarLogoChrome"
                            Width="56"
                            Height="56"
                            CornerRadius="16"
                            HorizontalAlignment="Left"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="SidebarLogoFloat" Y="0"/>
                        </Border.RenderTransform>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2B8CA3" Offset="0"/>
                                <GradientStop Color="#1F5E6B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.35" Color="#2B8CA3"/>
                        </Border.Effect>
                        <TextBlock Text="TA"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="White"/>
                    </Border>
                    <TextBlock Text="Agenție de turism"
                               Foreground="#0F172A"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,16,0,0"/>
                    <TextBlock Text="Spațiu agent"
                               Foreground="#475569"
                               FontSize="12"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1" Margin="14,0,14,20">
                    <TextBlock Text="MENIU"
                               Foreground="#475569"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="10,0,0,10"/>

                    <Button Content="Tablou de bord"
                            Style="{StaticResource SidebarButtonStyle}"
                            Tag="Dashboard"
                            Command="{Binding ShowDashboardCommand}"/>

                    <Button Content="Pachete"
                            Style="{StaticResource SidebarButtonStyle}"
                            Tag="Packages"
                            Command="{Binding ShowPackagesCommand}"/>

                    <Button Content="Rezervări"
                            Style="{StaticResource SidebarButtonStyle}"
                            Tag="Bookings"
                            Command="{Binding ShowBookingsCommand}"/>

                    <Button Content="Clienți"
                            Style="{StaticResource SidebarButtonStyle}"
                            Tag="Clients"
                            Command="{Binding ShowClientsCommand}"/>

                    <Button Content="Rapoarte"
                            Style="{StaticResource SidebarButtonStyle}"
                            Tag="Reports"
                            Command="{Binding ShowReportsCommand}"/>

                    <Border Height="1" Background="#E2E8F0" Margin="8,16,8,12"/>

                    <Button Content="Ieșire"
                            Height="46"
                            Margin="0,4,0,0"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Command="{Binding LogoutCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Lg"
                                        CornerRadius="12"
                                        BorderBrush="#334155"
                                        BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#475569" Offset="0"/>
                                            <GradientStop Color="#1E293B" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Lg" Property="Opacity" Value="0.92"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Lg" Property="Opacity" Value="0.86"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Conținut principal: strat animat „cer” + module -->
        <Grid Grid.Column="1">
            <Canvas x:Name="AmbientSkyCanvas"
                    Panel.ZIndex="0"
                    IsHitTestVisible="False"
                    ClipToBounds="True"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Margin="0">
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="SkyCloudDrift" X="0" Y="0"/>
                </Canvas.RenderTransform>
                <Ellipse Canvas.Left="120"
                         Canvas.Top="36"
                         Width="120"
                         Height="28"
                         Fill="#FFFFFF"
                         Opacity="0.14"/>
                <Ellipse Canvas.Left="420"
                         Canvas.Top="72"
                         Width="90"
                         Height="22"
                         Fill="#FFFFFF"
                         Opacity="0.1"/>
                <Viewbox x:Name="SkyPlane1"
                         Width="52"
                         Height="28"
                         Canvas.Top="28"
                         Canvas.Left="-80"
                         Opacity="0.28"
                         Stretch="Uniform">
                    <Path Data="{StaticResource AgentSkyPlaneGeometry}"
                          Fill="#475569"
                          Stroke="#94A3B8"
                          StrokeThickness="0.6"
                          StrokeLineJoin="Round"/>
                </Viewbox>
                <Viewbox x:Name="SkyPlane2"
                         Width="36"
                         Height="20"
                         Canvas.Top="88"
                         Canvas.Left="-120"
                         Opacity="0.2"
                         Stretch="Uniform">
                    <Path Data="{StaticResource AgentSkyPlaneGeometry}"
                          Fill="#1F5E6B"
                          Stroke="#A9CCD6"
                          StrokeThickness="0.5"
                          StrokeLineJoin="Round"/>
                </Viewbox>
            </Canvas>

        <!-- DASHBOARD -->
        <ScrollViewer Panel.ZIndex="1"
                      Margin="24"
                      Visibility="{Binding DashboardVisibility}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border Background="Transparent" Padding="18">
            <Grid TextElement.FontSize="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Style="{StaticResource DashboardPanel}"
                        Padding="0"
                        Margin="0,0,0,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                CornerRadius="14,14,0,0"
                                Height="5"
                                VerticalAlignment="Top">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#2B8CA3" Offset="0"/>
                                    <GradientStop Color="#1F5E6B" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="26,18,26,22">
                            <TextBlock Text="Spațiu agent"
                                       FontSize="12.5"
                                       Foreground="#475569"/>
                            <TextBlock Text="Tablou de bord"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,8,0,0"/>
                            <TextBlock Text="Rezumat rezervări, clienți și activitate"
                                       FontSize="14"
                                       Foreground="#475569"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KPI row -->
                <Grid Grid.Row="1" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource DashboardKpiCard}" Padding="18,16,18,18" MinHeight="118" ClipToBounds="False">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="În așteptare" Foreground="#475569" FontSize="11"/>
                            <TextBlock Text="{Binding PendingBookings.Count}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,10,0,4"
                                       TextOptions.TextFormattingMode="Display"
                                       LineStackingStrategy="BlockLineHeight"
                                       LineHeight="30"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource DashboardKpiCard}" Padding="18,16,18,18" MinHeight="118" ClipToBounds="False">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Toate rezervările" Foreground="#475569" FontSize="11"/>
                            <TextBlock Text="{Binding AllBookings.Count}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,10,0,4"
                                       TextOptions.TextFormattingMode="Display"
                                       LineStackingStrategy="BlockLineHeight"
                                       LineHeight="30"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource DashboardKpiCard}" Padding="18,16,18,18" MinHeight="118" ClipToBounds="False">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Pachete" Foreground="#475569" FontSize="11"/>
                            <TextBlock Text="{Binding TotalPackagesCount}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,10,0,4"
                                       TextOptions.TextFormattingMode="Display"
                                       LineStackingStrategy="BlockLineHeight"
                                       LineHeight="30"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Style="{StaticResource DashboardKpiCard}" Padding="18,16,18,20" MinHeight="120" ClipToBounds="False">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Valoare totală" Foreground="#475569" FontSize="11"/>
                            <TextBlock Text="{Binding TotalValueText, StringFormat=€ {0}}"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,10,0,6"
                                       TextOptions.TextFormattingMode="Display"
                                       LineStackingStrategy="BlockLineHeight"
                                       LineHeight="30"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Middle row: bookings / clients / notifications -->
                <Grid Grid.Row="2" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Recent bookings -->
                    <Border Grid.Column="0" Style="{StaticResource DashboardPanel}" Padding="18" MinHeight="440" Height="440">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Rezervări recente"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Content="Vezi tot"
                                        Style="{StaticResource AgentSecondaryButton}"
                                        Height="36"
                                        MinWidth="100"
                                        Padding="14,0"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Command="{Binding ShowBookingsCommand}"/>
                            </Grid>

                            <!-- Tabs -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,0">
                                <Button Content="Toate"
                                        Padding="14,7"
                                        Margin="0,0,10,0"
                                        Command="{Binding SetDashboardBookingFilterCommand}"
                                        CommandParameter="All">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource DashboardTabButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DashboardBookingFilter}" Value="All">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#2B8CA3" Offset="0"/>
                                                                <GradientStop Color="#1F5E6B" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="În așteptare"
                                        Padding="14,7"
                                        Margin="0,0,10,0"
                                        Command="{Binding SetDashboardBookingFilterCommand}"
                                        CommandParameter="Pending">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource DashboardTabButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DashboardBookingFilter}" Value="Pending">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#2B8CA3" Offset="0"/>
                                                                <GradientStop Color="#1F5E6B" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="Confirmate"
                                        Padding="14,7"
                                        Margin="0,0,10,0"
                                        Command="{Binding SetDashboardBookingFilterCommand}"
                                        CommandParameter="Confirmed">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource DashboardTabButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DashboardBookingFilter}" Value="Confirmed">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#2B8CA3" Offset="0"/>
                                                                <GradientStop Color="#1F5E6B" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="Anulate"
                                        Padding="14,7"
                                        Command="{Binding SetDashboardBookingFilterCommand}"
                                        CommandParameter="Cancelled">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource DashboardTabButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DashboardBookingFilter}" Value="Cancelled">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#2B8CA3" Offset="0"/>
                                                                <GradientStop Color="#1F5E6B" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <DataGrid Grid.Row="3"
                                      FontSize="14"
                                      ItemsSource="{Binding DashboardBookings}"
                                      AutoGenerateColumns="False"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      RowHeaderWidth="0"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#99E2E8F0"
                                      AlternationCount="2"
                                      RowBackground="#55FFFFFF"
                                      AlternatingRowBackground="#7AF1F5F9"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#C8E2E8F0"/>
                                        <Setter Property="Foreground" Value="#1E293B"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="Padding" Value="14,12"/>
                                        <Setter Property="BorderBrush" Value="#99CBD5E1"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="MinHeight" Value="50"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="14,12"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="64" MinWidth="52"/>
                                    <DataGridTextColumn Header="Client" Binding="{Binding Client.Username}" Width="*" MinWidth="96">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="14"/>
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Pachet" Binding="{Binding TripPackage.Name}" Width="*" MinWidth="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="14"/>
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Data" Binding="{Binding BookingDate, StringFormat=dd.MM.yyyy}" Width="112" MinWidth="100"/>
                                    <DataGridTextColumn Header="Stare"
                                                        Binding="{Binding Status.Name, Converter={StaticResource BookingStatusRoConverter}}"
                                                        Width="130"
                                                        MinWidth="108"/>
                                    <DataGridTextColumn Header="Valoare" Binding="{Binding TotalPrice, StringFormat=€ {0:F0}}" Width="120" MinWidth="108"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Recent clients -->
                    <Border Grid.Column="2" Style="{StaticResource DashboardDarkCard}" Padding="18" MinHeight="440" Height="440">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Clienți recenți"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,0,0,12"
                                       VerticalAlignment="Center"/>

                            <Border Grid.Row="1"
                                    Style="{StaticResource DashboardDarkInset}"
                                    Height="38"
                                    Padding="12,0,12,0"
                                    Margin="0,0,0,10"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <TextBox x:Name="ClientSearchBox"
                                             Background="Transparent"
                                         BorderThickness="0"
                                         VerticalContentAlignment="Center"
                                         FontSize="13"
                                             Foreground="#0F172A"
                                             CaretBrush="#0F172A"
                                             Text="{Binding ClientSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             />
                                    <TextBlock Text="Caută clienți…"
                                               Margin="2,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="#475569"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=ClientSearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="2"
                                     ItemsSource="{Binding RecentClients}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#B0FFFFFF" CornerRadius="12" BorderBrush="#8AE2E8F0" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Width="40"
                                                        Height="40"
                                                        CornerRadius="20"
                                                        BorderBrush="#BFDBFE"
                                                        BorderThickness="1"
                                                        VerticalAlignment="Top">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#E0F2FE" Offset="0"/>
                                                            <GradientStop Color="#D6EEF3" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <TextBlock Text="CL"
                                                               Foreground="#0369A1"
                                                               FontWeight="Bold"
                                                               FontSize="12"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding Username}"
                                                               FontWeight="SemiBold"
                                                               Foreground="#0F172A"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Email}"
                                                               Foreground="#64748B"
                                                               FontSize="12"
                                                               Margin="0,4,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Notifications -->
                    <Border Grid.Column="4" Style="{StaticResource DashboardDarkCard}" Padding="18" MinHeight="440" Height="440">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Notificări"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,0,0,12"
                                       VerticalAlignment="Center"/>

                            <Grid Grid.Row="1">
                                <ListBox ItemsSource="{Binding Notifications}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#B0FFFFFF" CornerRadius="12" BorderBrush="#8AE2E8F0" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{Binding AccentColor}" CornerRadius="3"/>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                        <TextBlock Text="{Binding Message}" Foreground="#64748B" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}" Foreground="#64748B" FontSize="11" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Background="#B0FFFFFF"
                                        CornerRadius="14"
                                        BorderBrush="#8AFFFFFF"
                                        BorderThickness="1"
                                        Padding="22,28"
                                        MinHeight="120"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Notifications.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Nicio notificare încă"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#0F172A"/>
                                        <TextBlock Text="Actualizările rezervărilor vor apărea aici automat."
                                                   Foreground="#334155"
                                                   FontSize="13"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Bottom row: quick actions / tasks / top packages -->
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource DashboardDarkCard}" Padding="18" Margin="0,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Acțiuni rapide" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="Creează pachet" Style="{StaticResource AgentPrimaryButton}" Click="CreatePackage_Click"/>
                                <Button Grid.Column="2" Content="Creare rapidă" Style="{StaticResource AgentSecondaryButton}" Click="QuickCreatePackage_Click"/>
                                <Button Grid.Column="4" Content="Reîmprospătare cereri" Style="{StaticResource AgentSecondaryButton}" Command="{Binding RefreshPendingBookingsCommand}"/>
                                <Button Grid.Column="6" Content="Rapoarte" Style="{StaticResource AgentSecondaryButton}" Command="{Binding ShowReportsCommand}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource DashboardDarkCard}" Padding="18" Height="220">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Sarcini astăzi" FontSize="17" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>
                            <StackPanel Grid.Row="1">
                                    <Border Background="#B0FFFFFF" CornerRadius="12" BorderBrush="#8AE2E8F0" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="11:00" Foreground="#64748B" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="Verifică cererile de rezervare" Foreground="#0F172A" FontWeight="SemiBold"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="#B0FFFFFF" CornerRadius="12" BorderBrush="#8AE2E8F0" BorderThickness="1" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="15:30" Foreground="#64748B" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="Verifică plățile și confirmările" Foreground="#0F172A" FontWeight="SemiBold"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource DashboardDarkCard}" Padding="18" Height="220">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Pachete populare" FontSize="17" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding TripsView}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#B0FFFFFF" CornerRadius="12" BorderBrush="#8AE2E8F0" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Price, StringFormat=€ {0:F0}}" Foreground="#64748B" FontSize="12" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
            </Border>
        </ScrollViewer>

        <!-- CLIENTS -->
        <ScrollViewer Panel.ZIndex="1"
                      Margin="24"
                      Visibility="{Binding ClientsVisibility}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border Background="Transparent" Padding="18">
                <Border Style="{StaticResource DashboardDarkCard}" Padding="22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Clienți"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                        <TextBlock Grid.Row="1"
                                   Text="Lista rapidă a clienților recenți"
                                   FontSize="14"
                                   Foreground="#475569"
                                   Margin="0,8,0,16"/>

                        <Border Grid.Row="2"
                                Style="{StaticResource DashboardDarkInset}"
                                Height="40"
                                Padding="10,0,10,0"
                                Margin="0,0,0,12">
                            <Grid>
                                <TextBox x:Name="ClientsPageSearch"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         VerticalContentAlignment="Center"
                                         FontSize="13"
                                         Foreground="#0F172A"
                                         CaretBrush="#0F172A"
                                         Text="{Binding ClientSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Caută clienți…"
                                           Margin="2,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#475569"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=ClientsPageSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <ListBox Grid.Row="3"
                                 ItemsSource="{Binding RecentClients}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#B0FFFFFF"
                                            CornerRadius="14"
                                            BorderBrush="#8AE2E8F0"
                                            BorderThickness="1"
                                            Padding="14"
                                            Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="44"
                                                    Height="44"
                                                    CornerRadius="22"
                                                    BorderBrush="#BFDBFE"
                                                    BorderThickness="1"
                                                    VerticalAlignment="Top">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#E0F2FE" Offset="0"/>
                                                        <GradientStop Color="#D6EEF3" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="CL"
                                                           Foreground="#0369A1"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Username}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#0F172A"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Email}"
                                                           Foreground="#64748B"
                                                           FontSize="12"
                                                           Margin="0,6,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding PhoneNumber, StringFormat=Phone: {0}}"
                                                           Foreground="#94A3B8"
                                                           FontSize="12"
                                                           Margin="0,4,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Border>
        </ScrollViewer>

        <!-- PACKAGES -->
        <ScrollViewer Panel.ZIndex="1"
                      Margin="24"
                      Visibility="{Binding PackagesVisibility}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="120"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            

            <!-- Header -->
            <Border Grid.Row="0"
                    Style="{StaticResource ElevatedPanel}"
                    Padding="26,22"
                    Margin="0,0,0,20"
                    Grid.ColumnSpan="3">
                <Border.Background>
                    <!-- Sharper header surface (B) -->
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#D9FFFFFF" Offset="0"/>
                        <GradientStop Color="#BFFFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Pachete de călătorie"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                        <TextBlock Text="Gestionează ofertele și rezervările într-un singur loc"
                                   FontSize="14"
                                   Foreground="#475569"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Margin="16,0,16,0"
                            VerticalAlignment="Center"
                            Background="#CCF8FAFC"
                            BorderBrush="#66CBD5E1"
                            BorderThickness="1"
                            CornerRadius="12"
                            Height="44"
                            Padding="2,0,12,0">
                        <Grid>
                            <TextBox x:Name="SearchBox"
                                     Margin="14,0,12,0"
                                     Height="40"
                                     Padding="0,0,0,0"
                                     VerticalContentAlignment="Center"
                                     FontSize="14"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Search packages…"
                                       Margin="16,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#475569"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Button Content="Creează pachet"
                                Style="{StaticResource PackagesHeaderPrimaryButton}"
                                Margin="0,0,10,0"
                                Click="CreatePackage_Click"/>

                        <Button Content="Creare rapidă"
                                Style="{StaticResource PackagesHeaderSecondaryButton}"
                                Click="QuickCreatePackage_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Stats -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ElevatedPanel}" Padding="0">
                    <Grid>
                        <Border Height="3" Background="#2563EB" CornerRadius="16,16,0,0" VerticalAlignment="Top"/>
                        <Grid Margin="22,18,22,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Total packages" FontSize="13" Foreground="#475569"/>
                                <TextBlock Text="{Binding TotalPackagesCount}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="44"
                                    Height="44"
                                    CornerRadius="22"
                                    Margin="14,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="#1A2563EB"
                                    BorderBrush="#332563EB"
                                    BorderThickness="1">
                                <TextBlock Text="PK"
                                           Foreground="#2563EB"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource ElevatedPanel}" Padding="0">
                    <Grid>
                        <Border Height="3" Background="#059669" CornerRadius="16,16,0,0" VerticalAlignment="Top"/>
                        <Grid Margin="22,18,22,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Active offers" FontSize="13" Foreground="#475569"/>
                                <TextBlock Text="{Binding ActiveOffersCount}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="44"
                                    Height="44"
                                    CornerRadius="22"
                                    Margin="14,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="#1A059669"
                                    BorderBrush="#33059669"
                                    BorderThickness="1">
                                <TextBlock Text="ON"
                                           Foreground="#059669"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource ElevatedPanel}" Padding="0">
                    <Grid>
                        <Border Height="3" Background="#D97706" CornerRadius="16,16,0,0" VerticalAlignment="Top"/>
                        <Grid Margin="22,18,22,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Average price" FontSize="13" Foreground="#475569"/>
                                <TextBlock Text="{Binding AveragePriceText, StringFormat=€ {0}}"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="44"
                                    Height="44"
                                    CornerRadius="22"
                                    Margin="14,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="#1AD97706"
                                    BorderBrush="#33D97706"
                                    BorderThickness="1">
                                <TextBlock Text="AVG"
                                           Foreground="#D97706"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="6" Style="{StaticResource ElevatedPanel}" Padding="0">
                    <Grid>
                        <Border Height="3" Background="#7C3AED" CornerRadius="16,16,0,0" VerticalAlignment="Top"/>
                        <Grid Margin="22,18,22,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Total value" FontSize="13" Foreground="#475569"/>
                                <TextBlock Text="{Binding TotalValueText, StringFormat=€ {0}}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="44"
                                    Height="44"
                                    CornerRadius="22"
                                    Margin="14,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="#1A7C3AED"
                                    BorderBrush="#337C3AED"
                                    BorderThickness="1">
                                <TextBlock Text="€"
                                           Foreground="#7C3AED"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Main Area (single column + page scroll) -->
            <StackPanel Grid.Row="2"
                        Grid.ColumnSpan="3"
                        Margin="0,16,0,0">

                <!-- Recent packages (left) -->
                <Border Style="{StaticResource ElevatedPanel}"
                        Padding="22"
                        Height="520"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Recent packages"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="Scroll inside the list"
                                           FontSize="12"
                                           Foreground="#64748B"/>
                            </StackPanel>

                            <!-- Debug/status line from AgentViewModel (e.g. Covers: 12/30) -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Status}"
                                       Margin="12,2,0,0"
                                       VerticalAlignment="Top"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="360"/>
                        </Grid>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding TripsView}"
                                 SelectedItem="{Binding SelectedTrip, Mode=TwoWay}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,14,14"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="OuterBorder"
                                                        Background="Transparent"
                                                        CornerRadius="14">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="OuterBorder" Property="Background" Value="#DBEAFE"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#72FFFFFF"
                                            x:Name="PackageCard"
                                            CornerRadius="14"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            MinHeight="200"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <TranslateTransform Y="0"/>
                                        </Border.RenderTransform>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18"
                                                              ShadowDepth="6"
                                                              Direction="270"
                                                              Opacity="0.14"
                                                              Color="#0F172A"/>
                                        </Border.Effect>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="#93C5FD"/>
                                                        <Setter Property="Background" Value="#FFFFFF"/>
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                                     To="-3"
                                                                                     Duration="0:0:0.12"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                                     To="0"
                                                                                     Duration="0:0:0.16"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid Margin="14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="96"/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Image (not ImageBrush): BitmapImage loads async; ImageBrush often stays blank until a full repaint. -->
                                            <Border Grid.Row="0"
                                                    CornerRadius="14"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Image Stretch="UniformToFill"
                                                           HorizontalAlignment="Stretch"
                                                           VerticalAlignment="Stretch"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Source="{Binding Converter={StaticResource TripPackageToImageSourceConverter}}"/>
                                                    <!-- subtle overlay for readability / glass vibe -->
                                                    <Border Background="#220F172A" CornerRadius="14"/>

                                                    <!-- DRAFT badge (PricingNotes == "DRAFT") -->
                                                    <Border HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Margin="10,10,0,0"
                                                            CornerRadius="10"
                                                            Background="#FCD34D"
                                                            Padding="8,3"
                                                            Opacity="0"
                                                            IsHitTestVisible="False">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PricingNotes}" Value="DRAFT">
                                                                        <Setter Property="Opacity" Value="1"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="DRAFT"
                                                                   Foreground="#0F172A"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"/>
                                                    </Border>

                                                    <!-- (Removed) Banner shimmer: it was hiding fallback images when CoverImageUrl is empty. -->
                                                </Grid>
                                            </Border>

                                            <!-- Per-card actions (hover) -->
                                            <Border Grid.Row="0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="0,2,2,0"
                                                    CornerRadius="12"
                                                    Background="#80FFFFFF"
                                                    BorderBrush="#55FFFFFF"
                                                    BorderThickness="1"
                                                    Padding="8">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource AgentHoverActionsBar}">
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <Binding ElementName="PackageCard" Path="IsMouseOver"/>
                                                                </DataTrigger.Binding>
                                                                <Setter Property="Opacity" Value="1"/>
                                                                <Setter Property="IsHitTestVisible" Value="True"/>
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <TranslateTransform Y="0"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource AgentIconSecondaryButton}"
                                                            ToolTip="Edit"
                                                            Click="EditPackage_Click"
                                                            Tag="{Binding}"
                                                            Margin="0,0,8,0">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;"/>
                                                    </Button>

                                                    <Button Style="{StaticResource AgentIconPrimaryButton}"
                                                            ToolTip="Copy"
                                                            Command="{Binding DataContext.CloneCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"
                                                            Margin="0,0,8,0">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;"/>
                                                    </Button>

                                                    <Button Style="{StaticResource AgentIconDangerButton}"
                                                            ToolTip="Delete"
                                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;"/>
                                                    </Button>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="#1F2937"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="38"/>

                                            <TextBlock Grid.Row="3"
                                                       Text="{Binding TransportName, StringFormat=Transport: {0}}"
                                                       Margin="0,8,0,0"
                                                       FontSize="11.5"
                                                       Foreground="#64748B"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Grid.Row="4"
                                                       Text="{Binding StayName, StringFormat=Stay: {0}}"
                                                       Margin="0,2,0,0"
                                                       FontSize="11.5"
                                                       Foreground="#64748B"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Grid.Row="5"
                                                       Text="{Binding Price, StringFormat=€ {0:F2}}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="#0F172A"
                                                       Margin="0,10,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Booking requests (right) with sticky actions -->
                <Border Style="{StaticResource ElevatedPanel}"
                        Padding="22"
                        Height="520"
                        Margin="0,0,0,16">
                    <DockPanel LastChildFill="True">
                        <!-- Action rail (vertical, sticky) -->
                        <Border DockPanel.Dock="Right"
                                Margin="14,0,0,0"
                                Background="#55FFFFFF"
                                BorderBrush="#A9CCD6"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="10"
                                VerticalAlignment="Top">
                            <StackPanel>
                                <Button Style="{StaticResource AgentIconSecondaryButton}"
                                        ToolTip="Refresh"
                                        Command="{Binding RefreshPendingBookingsCommand}"
                                        Margin="0,0,0,10">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;"/>
                                </Button>

                                <Button Style="{StaticResource AgentIconPrimaryButton}"
                                        ToolTip="Approve"
                                        Command="{Binding ApproveBookingCommand}"
                                        Margin="0,0,0,10">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;"/>
                                </Button>

                                <Button Style="{StaticResource AgentIconDangerButton}"
                                        ToolTip="Reject"
                                        Command="{Binding RejectBookingCommand}">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <TextBlock Text="Booking requests"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"/>
                            <TextBlock Text="Scroll inside the list (buttons stay visible)"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                        <ListBox ItemsSource="{Binding PendingBookings}"
                                 SelectedItem="{Binding SelectedBooking, Mode=TwoWay}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,12"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="OuterBorder"
                                                        Background="Transparent"
                                                        CornerRadius="12">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="OuterBorder" Property="Background" Value="#EAF2FF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14"
                                            BorderBrush="#A9CCD6"
                                            BorderThickness="6,1,1,1"
                                            CornerRadius="14"
                                            Background="#72FFFFFF"
                                            Opacity="1"
                                            MinHeight="150">
                                        <StackPanel>
                                            <TextBlock Text="{Binding TripPackage.Name}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="#1F2937"/>

                                            <TextBlock Margin="0,8,0,0"
                                                       Text="{Binding Client.Username, StringFormat=Client: {0}}"
                                                       Foreground="#374151"/>

                                            <TextBlock Margin="0,4,0,0"
                                                       Text="{Binding BookingDate, StringFormat=Booked on: {0:dd MMM yyyy HH:mm}}"
                                                       Foreground="#374151"/>

                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="#374151"
                                                       Text="{Binding Status.Name, Converter={StaticResource BookingStatusRoConverter}, StringFormat='Stare: {0}'}"/>

                                            <TextBlock Margin="0,4,0,0"
                                                       Text="{Binding TotalPrice, StringFormat=Total Price: € {0:F2}}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1F2937"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Details panel removed (actions are per-card now) -->
            </StackPanel>
        </Grid>
        </ScrollViewer>

        <!-- REPORTS -->
        <Grid Panel.ZIndex="1"
              Margin="24"
              Visibility="{Binding ReportsVisibility}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
            Background="White"
            CornerRadius="16"
            Padding="24">
                <StackPanel>
                    <TextBlock Text="Generate Reports"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#1F2937"/>

                    <TextBlock Text="Export booking reports in PDF, CSV or TXT format"
                       FontSize="14"
                       Foreground="#6B7280"
                       Margin="0,6,0,20"/>

                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="250"
                          Height="40"
                          Margin="0,0,12,0"
                          ItemsSource="{Binding ReportTypes}"
                          SelectedItem="{Binding SelectedReportType}"/>

                        <ComboBox Width="140"
                          Height="40"
                          Margin="0,0,12,0"
                          ItemsSource="{Binding ExportFormats}"
                          SelectedItem="{Binding SelectedExportFormat}"/>

                        <Button Content="Generate"
                        Width="120"
                        Height="40"
                        Background="#2F80ED"
                        Foreground="White"
                        BorderBrush="Transparent"
                        FontWeight="SemiBold"
                        Command="{Binding GenerateReportCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
            Background="White"
            CornerRadius="16"
            Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Pending Bookings Preview"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#1F2937"/>

                        <TextBlock Text="These are the booking requests currently loaded for report generation"
                           FontSize="14"
                           Foreground="#6B7280"
                           Margin="0,6,0,18"/>
                    </StackPanel>

                    <ListBox Grid.Row="1"
         ItemsSource="{Binding ReportPreviewBookings}"
         BorderThickness="0"
         Background="Transparent"
         HorizontalContentAlignment="Stretch"
         ScrollViewer.VerticalScrollBarVisibility="Auto"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,12"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="12"
                    Background="#FAFBFF">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TripPackage.Name}"
                               FontSize="16"
                               FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Client.Username, StringFormat=Client: {0}}"/>
                                        <TextBlock Text="{Binding BookingDate, StringFormat=Booked on: {0:dd MMM yyyy HH:mm}}"/>
                                        <TextBlock Text="{Binding Status.Name, Converter={StaticResource BookingStatusRoConverter}, StringFormat='Stare: {0}'}"/>
                                        <TextBlock Text="{Binding TotalPrice, StringFormat=Total Price: € {0:F2}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </Grid>
            </Border>
        </Grid>

        <Grid Panel.ZIndex="1"
              Margin="24"
              Visibility="{Binding IsBookingsVisible, Converter={StaticResource BoolToVisibilityConverter}}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Bookings"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#1F2937"/>

                <TextBlock Text="Manage and filter booking requests"
                   FontSize="14"
                   Foreground="#6B7280"
                   Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Filters -->
            <StackPanel Grid.Row="1"
            Orientation="Horizontal"
            Margin="0,0,0,16">
                <Button Content="All"
            Width="100"
            Height="40"
            Margin="0,0,10,0"
            Background="#F3F4F6"
            Foreground="#1F2937"
            BorderBrush="#D1D5DB"
            FontWeight="SemiBold"
            Command="{Binding ShowAllBookingsCommand}"/>

                <Button Content="Pending"
            Width="100"
            Height="40"
            Margin="0,0,10,0"
            Background="#F3F4F6"
            Foreground="#1F2937"
            BorderBrush="#D1D5DB"
            FontWeight="SemiBold"
            Command="{Binding ShowPendingBookingsCommand}"/>

                <Button Content="Confirmed"
            Width="110"
            Height="40"
            Margin="0,0,10,0"
            Background="#F3F4F6"
            Foreground="#1F2937"
            BorderBrush="#D1D5DB"
            FontWeight="SemiBold"
            Command="{Binding ShowConfirmedBookingsCommand}"/>

                <Button Content="Rejected"
            Width="110"
            Height="40"
            Background="#F3F4F6"
            Foreground="#1F2937"
            BorderBrush="#D1D5DB"
            FontWeight="SemiBold"
            Command="{Binding ShowRejectedBookingsCommand}"/>
            </StackPanel>

            <!-- List -->
            <ListBox Grid.Row="2"
         ItemsSource="{Binding AgentBookings}"
         SelectedItem="{Binding SelectedBooking, Mode=TwoWay}"
         BorderThickness="0"
         Background="Transparent"
         HorizontalContentAlignment="Stretch"
         ScrollViewer.VerticalScrollBarVisibility="Auto">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,12"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="OuterBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="14"
                                Padding="2">
                                        <ContentPresenter/>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="OuterBorder" Property="Background" Value="#EAF2FF"/>
                                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#2F80ED"/>
                                        </Trigger>

                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="OuterBorder" Property="Background" Value="#F3F8FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="12"
                    Background="#FAFBFF">
                            <StackPanel>
                                <TextBlock Text="{Binding TripPackage.Name}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#1F2937"/>

                                <TextBlock Text="{Binding Client.Username, StringFormat=Client: {0}}"
                               Margin="0,8,0,0"
                               Foreground="#374151"/>

                                <TextBlock Text="{Binding BookingDate, StringFormat=Booked on: {0:dd.MM.yyyy HH:mm}}"
                               Margin="0,4,0,0"
                               Foreground="#374151"/>

                                <TextBlock Margin="0,4,0,0"
                                           Foreground="#374151"
                                           Text="{Binding StatusName, Converter={StaticResource BookingStatusRoConverter}, StringFormat='Stare: {0}'}"/>

                                <TextBlock Text="{Binding TotalPrice, StringFormat=Total: € {0:F2}}"
                               Margin="0,4,0,0"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Actions -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                Content="Approve"
                Height="42"
                Background="#2F80ED"
                Foreground="White"
                BorderBrush="Transparent"
                FontWeight="SemiBold"
                Command="{Binding ApproveBookingCommand}"/>

                <Button Grid.Column="2"
                Content="Reject"
                Height="42"
                Background="#E74C3C"
                Foreground="White"
                BorderBrush="Transparent"
                FontWeight="SemiBold"
                Command="{Binding RejectBookingCommand}"/>
            </Grid>
        </Grid>

        </Grid>
    </Grid>
</Window>