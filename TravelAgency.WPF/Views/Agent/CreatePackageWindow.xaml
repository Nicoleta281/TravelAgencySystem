<Window x:Class="TravelAgency.WPF.Views.Agent.CreatePackageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create New Package"
        Height="740"
        Width="1120"
        MinWidth="960"
        WindowStartupLocation="CenterScreen">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E8F4F7" Offset="0"/>
            <GradientStop Color="#F0F4F8" Offset="0.45"/>
            <GradientStop Color="#F8FAFC" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <DropShadowEffect x:Key="CreatePkgGlassShadow"
                          BlurRadius="28"
                          ShadowDepth="1"
                          Direction="270"
                          Opacity="0.07"
                          Color="#0F172A"/>

        <Style x:Key="CreatePkgFieldTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="CaretBrush" Value="#0F766E"/>
            <Setter Property="SelectionBrush" Value="#99F6E4"/>
        </Style>

        <Style x:Key="CreatePkgFieldCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <!-- ScrollBar discret doar în această fereastră (înlocuiește stilul global „avion”) -->
        <ControlTemplate x:Key="CreatePkgScrollBarVertical" TargetType="ScrollBar">
            <Grid x:Name="Root" Width="10" SnapsToDevicePixels="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="0"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="1"
                        Width="5"
                        HorizontalAlignment="Center"
                        Margin="0,6"
                        CornerRadius="3"
                        Background="#E2E8F0"/>
                <Track x:Name="PART_Track"
                       Grid.Row="1"
                       IsDirectionReversed="True"
                       Focusable="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                      Opacity="0"
                                      Height="0"
                                      IsTabStop="False"
                                      Focusable="False"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                      Opacity="0"
                                      Height="0"
                                      IsTabStop="False"
                                      Focusable="False"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb>
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border x:Name="T"
                                            Width="6"
                                            MinHeight="28"
                                            CornerRadius="3"
                                            Margin="2,0"
                                            Background="#94A3B8"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="T" Property="Background" Value="#64748B"/>
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="T" Property="Background" Value="#475569"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="CreatePkgScrollBarHorizontal" TargetType="ScrollBar">
            <Grid Height="10" SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="0"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="1"
                        Height="5"
                        VerticalAlignment="Center"
                        Margin="6,0"
                        CornerRadius="3"
                        Background="#E2E8F0"/>
                <Track x:Name="PART_Track"
                       Grid.Column="1"
                       IsDirectionReversed="False"
                       Focusable="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                      Opacity="0"
                                      Width="0"
                                      IsTabStop="False"
                                      Focusable="False"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                      Opacity="0"
                                      Width="0"
                                      IsTabStop="False"
                                      Focusable="False"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb>
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border x:Name="Th"
                                            Height="6"
                                            MinWidth="36"
                                            CornerRadius="3"
                                            Margin="0,2"
                                            Background="#94A3B8"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Th" Property="Background" Value="#64748B"/>
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="Th" Property="Background" Value="#475569"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template" Value="{StaticResource CreatePkgScrollBarVertical}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="Template" Value="{StaticResource CreatePkgScrollBarHorizontal}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Border Background="#FDFEFE"
                CornerRadius="20"
                Padding="26,24"
                BorderBrush="#D8E8EC"
                BorderThickness="1"
                Effect="{StaticResource CreatePkgGlassShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,6">
                    <Border Height="4"
                            CornerRadius="2"
                            HorizontalAlignment="Left"
                            Width="56"
                            Margin="0,0,0,14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#2B8CA3" Offset="0"/>
                                <GradientStop Color="#5EEAD4" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="Create New Package"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"/>
                    <TextBlock Text="Fill in the travel package details step by step"
                               FontSize="14"
                               Foreground="#64748B"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               MaxWidth="720"/>
                </StackPanel>

                <!-- Steps (culori aliniate cu tabloul agent — code-behind actualizează pașii) -->
                <Grid Grid.Row="1" Margin="0,4,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                HorizontalAlignment="Center"
                                Cursor="Hand"
                                Background="Transparent"
                                ToolTip="Go to step 1 — Basic info"
                                MouseLeftButtonUp="WizardStepIndicator_MouseLeftButtonUp"
                                Tag="1">
                        <Border x:Name="Step1Circle" Width="40" Height="40" CornerRadius="20" BorderThickness="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2B8CA3" Offset="0"/>
                                    <GradientStop Color="#1F5E6B" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="1"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="Step1Label"
                                   Text="Basic Info"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#0F766E"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Center"
                                Cursor="Hand"
                                Background="Transparent"
                                ToolTip="Go to step 2 — Destination &amp; dates"
                                MouseLeftButtonUp="WizardStepIndicator_MouseLeftButtonUp"
                                Tag="2">
                        <Border x:Name="Step2Circle" Width="40" Height="40" CornerRadius="20" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1">
                            <TextBlock Text="2"
                                       Foreground="#64748B"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="Step2Label"
                                   Text="Destination &amp; Dates"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="140"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                HorizontalAlignment="Center"
                                Cursor="Hand"
                                Background="Transparent"
                                ToolTip="Go to step 3 — Transport &amp; accommodation"
                                MouseLeftButtonUp="WizardStepIndicator_MouseLeftButtonUp"
                                Tag="3">
                        <Border x:Name="Step3Circle" Width="40" Height="40" CornerRadius="20" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1">
                            <TextBlock Text="3"
                                       Foreground="#64748B"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="Step3Label"
                                   Text="Transport &amp; Accommodation"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="150"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3"
                                HorizontalAlignment="Center"
                                Cursor="Hand"
                                Background="Transparent"
                                ToolTip="Go to step 4 — Pricing"
                                MouseLeftButtonUp="WizardStepIndicator_MouseLeftButtonUp"
                                Tag="4">
                        <Border x:Name="Step4Circle" Width="40" Height="40" CornerRadius="20" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1">
                            <TextBlock Text="4"
                                       Foreground="#64748B"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="Step4Label"
                                   Text="Pricing"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4"
                                HorizontalAlignment="Center"
                                Cursor="Hand"
                                Background="Transparent"
                                ToolTip="Go to step 5 — Review"
                                MouseLeftButtonUp="WizardStepIndicator_MouseLeftButtonUp"
                                Tag="5">
                        <Border x:Name="Step5Circle" Width="40" Height="40" CornerRadius="20" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1">
                            <TextBlock Text="5"
                                       Foreground="#64748B"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="Step5Label"
                                   Text="Review"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Main content -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" MinWidth="300"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*" MinWidth="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- Preview card (client-facing card metaphor) -->
                    <Border Grid.Column="0"
                            Background="#F8FAFC"
                            BorderBrush="#C5D9E0"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="0"
                            Effect="{StaticResource CreatePkgGlassShadow}">
                        <!-- Coloana de previzualizare împarte înălțimea cu formularul; fără scroll vertical se taie cardul de jos -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,4,0">
                        <StackPanel Margin="0,0,0,8">
                            <Border Padding="14,14,14,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#ECFEFF"
                                            BorderBrush="#99F6E4"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,4">
                                        <TextBlock Text="LIVE PREVIEW"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="#0F766E"/>
                                    </Border>
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE722;"
                                               FontSize="14"
                                               Foreground="#94A3B8"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               ToolTip="How clients may see this offer"/>
                                </StackPanel>
                            </Border>
                            <Border Height="208"
                                    Margin="14,10,14,0"
                                    CornerRadius="16"
                                    ClipToBounds="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#E0F2FE" Offset="0"/>
                                        <GradientStop Color="#CCFBF1" Offset="0.55"/>
                                        <GradientStop Color="#BAE6FD" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Border x:Name="PreviewImageOverlay"
                                            Background="Transparent"
                                            Opacity="1"
                                            CornerRadius="16"
                                            MouseLeftButtonUp="PreviewImageOverlay_MouseLeftButtonUp"
                                            Cursor="Hand"
                                            ToolTip="Click to open full size (zoom in the preview window)."/>
                                    <!-- Must not capture mouse: sits above the image and would block clicks to PreviewImageOverlay. -->
                                    <Border x:Name="PreviewImageDimmer"
                                            CornerRadius="16"
                                            Opacity="0"
                                            IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0"/>
                                                <GradientStop Color="#7F0F172A" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock x:Name="PreviewDestinationCodeText"
                                               Text="PARIS"
                                               FontSize="32"
                                               FontWeight="Bold"
                                               Foreground="#0C4A6E"
                                               Opacity="0.92"
                                               IsHitTestVisible="False"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.25" Color="#FFFFFF"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <ScrollViewer x:Name="DestinationImagesStripHost"
                                          Margin="14,12,14,0"
                                          MinHeight="52"
                                          HorizontalScrollBarVisibility="Visible"
                                          VerticalScrollBarVisibility="Disabled"
                                          VerticalContentAlignment="Center"
                                          Visibility="Collapsed"
                                          CanContentScroll="False"
                                          PanningMode="HorizontalOnly">
                                <ItemsControl x:Name="DestinationImagesStrip"
                                              HorizontalAlignment="Left">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border Margin="14,16,14,14"
                                    CornerRadius="14"
                                    Background="#FDFEFE"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    Padding="14,14">
                                <StackPanel>
                                    <TextBlock x:Name="PreviewPackageNameText"
                                               Text="Paris Getaway"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="#0F172A"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock x:Name="PreviewDescriptionText"
                                               Text="Sample preview for the package card"
                                               FontSize="13"
                                               Foreground="#64748B"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap"
                                               MaxHeight="56"
                                               TextTrimming="CharacterEllipsis"/>

                                    <Rectangle Height="1" Fill="#E2E8F0" Margin="0,12,0,10"/>

                                    <TextBlock x:Name="PreviewTransportStayText"
                                               Text="Flight + Hotel"
                                               FontSize="13"
                                               Foreground="#334155"
                                               FontWeight="SemiBold"/>

                                    <TextBlock x:Name="PreviewPriceText"
                                               Text="€850"
                                               FontSize="26"
                                               FontWeight="Bold"
                                               Foreground="#0F766E"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Form -->
                    <Border Grid.Column="2"
                            Background="#FAFCFD"
                            BorderBrush="#D0DDE4"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,6,0">
                            <Grid Margin="24,20,18,40">
                                <!-- STEP 1 -->
                            <StackPanel x:Name="Step1Panel">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="#ECFEFF" BorderBrush="#5EEAD4" BorderThickness="1">
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE716;"
                                                   FontSize="18"
                                                   Foreground="#0D9488"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Step 1"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#64748B"/>
                                        <TextBlock Text="Basic information"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Foreground="#0F172A"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="Package name"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#475569"/>
                                <TextBox x:Name="PackageNameTextBox"
                                         Style="{StaticResource CreatePkgFieldTextBox}"
                                         Height="44"
                                         Margin="0,8,0,18"
                                         FontSize="14"/>

                                <TextBlock Text="Trip type"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#475569"/>
                                <ComboBox x:Name="TripTypeComboBox"
                                          Style="{StaticResource CreatePkgFieldCombo}"
                                          Height="44"
                                          Margin="0,8,0,18"
                                          FontSize="14">
                                    <ComboBoxItem Content="City Break"/>
                                    <ComboBoxItem Content="Beach Holiday"/>
                                    <ComboBoxItem Content="Adventure"/>
                                    <ComboBoxItem Content="Cultural Tour"/>
                                </ComboBox>

                                <TextBlock Text="Category"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#475569"/>
                                <ComboBox x:Name="CategoryComboBox"
                                          Style="{StaticResource CreatePkgFieldCombo}"
                                          Height="44"
                                          Margin="0,8,0,18"
                                          FontSize="14">
                                    <ComboBoxItem Content="Standard"/>
                                    <ComboBoxItem Content="Premium"/>
                                    <ComboBoxItem Content="Luxury"/>
                                </ComboBox>

                                <TextBlock Text="Short description"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#475569"/>
                                <TextBox x:Name="ShortDescriptionTextBox"
                                         Style="{StaticResource CreatePkgFieldTextBox}"
                                         Height="132"
                                         Margin="0,8,0,8"
                                         FontSize="14"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <!-- STEP 2 -->
                            <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                                <TextBlock Text="Step 2: Destination &amp; Dates"
               FontSize="24"
               FontWeight="Bold"
               Foreground="#1F2937"
               Margin="0,0,0,18"/>

                                <TextBlock Text="Country"
               FontSize="14"
               FontWeight="SemiBold"
               Foreground="#374151"/>
                                <ComboBox x:Name="CountryComboBox"
             Height="42"
             Margin="0,8,0,0"
             FontSize="14"
             IsEditable="True"
             IsTextSearchEnabled="False"
             StaysOpenOnEdit="True"
             TextBoxBase.TextChanged="CountryComboBox_TextChanged"
             KeyDown="CountryComboBox_KeyDown"
             SelectionChanged="CountryComboBox_SelectionChanged"/>

                                <TextBlock Text="Destination"
               FontSize="14"
               FontWeight="SemiBold"
               Foreground="#374151"/>
                                    <ComboBox x:Name="DestinationComboBox"
          Height="42"
          Margin="0,8,0,16"
          FontSize="14"
          IsEditable="True"
          IsTextSearchEnabled="False"
          StaysOpenOnEdit="True"
          TextBoxBase.TextChanged="DestinationComboBox_TextChanged"
          SelectionChanged="DestinationComboBox_SelectionChanged"
          KeyUp="DestinationComboBox_KeyUp"/>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Start Date"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#374151"/>
                                        <DatePicker x:Name="StartDatePicker"
                        Height="42"
                        Margin="0,8,0,0"
                        FontSize="14"
                        SelectedDateChanged="DatesChanged"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="End Date"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#374151"/>
                                        <DatePicker x:Name="EndDatePicker"
                        Height="42"
                        Margin="0,8,0,0"
                        FontSize="14"
                        SelectedDateChanged="DatesChanged"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Number of Days"
               FontSize="14"
               FontWeight="SemiBold"
               Foreground="#374151"/>
                                <TextBox x:Name="NumberOfDaysTextBox"
             Height="42"
             Margin="0,8,0,0"
             FontSize="14"
             Padding="12,0"
             IsReadOnly="True"/>
                            </StackPanel>
                            <!--STEP 3-->
                            <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="#ECFEFF" BorderBrush="#5EEAD4" BorderThickness="1">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE809;" FontSize="18" Foreground="#0D9488"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Step 3" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                                        <TextBlock Text="Transport &amp; accommodation" FontSize="22" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Transport -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="16,14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Transport" FontSize="13" FontWeight="SemiBold" Foreground="#0F766E" Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Transport type" FontSize="13" FontWeight="SemiBold" Foreground="#475569"/>
                                                <ComboBox x:Name="TransportTypeComboBox"
                                                          Style="{StaticResource CreatePkgFieldCombo}"
                                                          Height="44" Margin="0,8,0,0" FontSize="14">
                                                    <ComboBoxItem Content="Flight"/>
                                                    <ComboBoxItem Content="Bus"/>
                                                    <ComboBoxItem Content="Train"/>
                                                    <ComboBoxItem Content="Own Transport"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Departure city" FontSize="13" FontWeight="SemiBold" Foreground="#475569"/>
                                                <TextBox x:Name="DepartureCityTextBox"
                                                         Style="{StaticResource CreatePkgFieldTextBox}"
                                                         Height="44" Margin="0,8,0,0" FontSize="14"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Căutare cazare -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="16,14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Accommodation search" FontSize="13" FontWeight="SemiBold" Foreground="#0F766E" Margin="0,0,0,10"/>
                                        <TextBlock Text="Selected property name" FontSize="13" FontWeight="SemiBold" Foreground="#475569"/>
                                        <TextBox x:Name="AccommodationNameTextBox"
                                                 Style="{StaticResource CreatePkgFieldTextBox}"
                                                 Height="44" Margin="0,8,0,0" FontSize="14"/>
                                        <TextBlock Text="Search area (city, country)" Margin="0,14,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#475569"/>
                                        <TextBox x:Name="HotelSearchLocationTextBox"
                                                 Style="{StaticResource CreatePkgFieldTextBox}"
                                                 Height="44" Margin="0,8,0,0" FontSize="14"
                                                 ToolTip="Defaults to destination and country from Step 2. Change if you want to search another area."
                                                 TextChanged="HotelSearchLocationTextBox_TextChanged"/>
                                        <Button x:Name="SearchHotelsButton"
                                                Content="Search accommodation"
                                                Height="42" MinWidth="200" MaxWidth="360" Margin="0,12,0,0" HorizontalAlignment="Left"
                                                Padding="20,0" Background="#2B8CA3" Foreground="White" FontWeight="SemiBold" Cursor="Hand"
                                                Click="SearchHotelsButton_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- Rezultate -->
                                <Border Background="#FDFEFE" BorderBrush="#D0DDE4" BorderThickness="1" CornerRadius="14" Padding="16,14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Results" FontSize="13" FontWeight="SemiBold" Foreground="#0F766E" Margin="0,0,0,8"/>
                                        <TextBlock Text="Filter by name or description" FontSize="13" FontWeight="SemiBold" Foreground="#475569"/>
                                        <TextBox x:Name="HotelResultsFilterTextBox"
                                                 Style="{StaticResource CreatePkgFieldTextBox}"
                                                 Height="40" Margin="0,8,0,0" FontSize="14"
                                                 ToolTip="Filters the last search results (client-side)."
                                                 TextChanged="HotelResultsFilterTextBox_TextChanged"/>
                                        <ListBox x:Name="HotelsListBox"
                                                 Margin="0,12,0,0"
                                                 MinHeight="120" MaxHeight="200"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 SelectionChanged="HotelsListBox_SelectionChanged"
                                                 MouseDoubleClick="HotelsListBox_MouseDoubleClick">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="10" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Background="#FAFCFD">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="68"/>
                                                                <ColumnDefinition Width="10"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" CornerRadius="10" Background="#EEF2FF" ClipToBounds="True">
                                                                <Image Stretch="UniformToFill" Source="{Binding ThumbnailUrl}"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="#0F172A" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Description}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#64748B" FontSize="13" MaxHeight="48" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" Foreground="#0F766E" FontSize="13"
                                                                           Text="{Binding PricePerNight, StringFormat=From €{0} / night}"/>
                                                                <TextBlock Foreground="#64748B" FontSize="12" Margin="0,2,0,0"
                                                                           Text="{Binding HotelClass, StringFormat=Class: {0}}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>

                                <!-- Masă & locuri -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="16,14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Meals &amp; capacity" FontSize="13" FontWeight="SemiBold" Foreground="#0F766E" Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Meal plan" FontSize="13" FontWeight="SemiBold" Foreground="#475569"/>
                                                <ComboBox x:Name="MealPlanComboBox"
                                                          Style="{StaticResource CreatePkgFieldCombo}"
                                                          Height="44" Margin="0,8,0,0" FontSize="14">
                                                    <ComboBoxItem Content="Breakfast"/>
                                                    <ComboBoxItem Content="Half Board"/>
                                                    <ComboBoxItem Content="Full Board"/>
                                                    <ComboBoxItem Content="All Inclusive"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Available seats" FontSize="13" FontWeight="SemiBold" Foreground="#475569"/>
                                                <TextBox x:Name="AvailableSeatsTextBox"
                                                         Style="{StaticResource CreatePkgFieldTextBox}"
                                                         Height="44" Margin="0,8,0,0" FontSize="14"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Servicii incluse -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="16,14" Margin="0,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Included services" FontSize="13" FontWeight="SemiBold" Foreground="#0F766E" Margin="0,0,0,10"/>
                                        <UniformGrid Columns="2" Margin="0,0,0,0">
                                            <CheckBox x:Name="AirportTransferCheckBox" Content="Airport transfer" Margin="0,0,12,10" FontSize="14" Foreground="#334155"/>
                                            <CheckBox x:Name="TravelInsuranceCheckBox" Content="Travel insurance" Margin="0,0,12,10" FontSize="14" Foreground="#334155"/>
                                            <CheckBox x:Name="TourGuideCheckBox" Content="Tour guide" Margin="0,0,12,10" FontSize="14" Foreground="#334155"/>
                                            <CheckBox x:Name="FreeCancellationCheckBox" Content="Free cancellation" Margin="0,0,12,10" FontSize="14" Foreground="#334155"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!--STEP 4-->
                            <StackPanel x:Name="Step4Panel" Visibility="Collapsed">
                                <TextBlock Text="Step 4: Pricing"
               FontSize="24"
               FontWeight="Bold"
               Foreground="#1F2937"
               Margin="0,0,0,18"/>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Base Price"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#374151"/>
                                        <TextBox x:Name="BasePriceTextBox"
                     Height="42"
                     Margin="0,8,0,0"
                     FontSize="14"
                     Padding="12,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Discount (%)"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#374151"/>
                                        <TextBox x:Name="DiscountTextBox"
                     Height="42"
                     Margin="0,8,0,0"
                     FontSize="14"
                     Padding="12,0"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="VAT (%)"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#374151"/>
                                        <TextBox x:Name="VatTextBox"
                     Height="42"
                     Margin="0,8,0,0"
                     FontSize="14"
                     Padding="12,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Extra Charges"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#374151"/>
                                        <TextBox x:Name="ExtraChargesTextBox"
                     Height="42"
                     Margin="0,8,0,0"
                     FontSize="14"
                     Padding="12,0"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="#F3F8FF"
            CornerRadius="14"
            Padding="18"
            Margin="0,10,0,18">
                                    <StackPanel>
                                            <TextBlock x:Name="EstimatedFinalPriceText"
           Text="€ 0.00"
           FontSize="34"
           FontWeight="Bold"
           Foreground="#1F2937"/>
                                        </StackPanel>
                                </Border>

                                <TextBlock Text="Pricing Notes"
               FontSize="14"
               FontWeight="SemiBold"
               Foreground="#374151"/>
                                <TextBox x:Name="PricingNotesTextBox"
             Height="100"
             Margin="0,8,0,0"
             FontSize="14"
             TextWrapping="Wrap"
             AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto"
             Padding="12"/>
                            </StackPanel>
                            <!--STEP 5-->
                            <StackPanel x:Name="Step5Panel" Visibility="Collapsed">
                                <TextBlock Text="Step 5: Review"
               FontSize="24"
               FontWeight="Bold"
               Foreground="#1F2937"
               Margin="0,0,0,18"/>

                                <Border Background="#FAFBFF"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="14"
            Padding="18"
            Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock Text="Basic Information"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"
                           Margin="0,0,0,12"/>

                                            <TextBlock Text="Package Name:"
                           FontSize="14"
                           Foreground="#6B7280"/>
                                            <TextBlock x:Name="ReviewPackageNameText"
                           FontSize="14"
                           Foreground="#374151"
                           Margin="0,0,0,8"/>

                                            <TextBlock Text="Trip Type:"
                           FontSize="14"
                           Foreground="#6B7280"/>
                                            <TextBlock x:Name="ReviewTripTypeText"
                           FontSize="14"
                           Foreground="#374151"
                           Margin="0,0,0,8"/>

                                            <TextBlock Text="Category:"
                           FontSize="14"
                           Foreground="#6B7280"/>
                                            <TextBlock x:Name="ReviewCategoryText"
                           FontSize="14"
                           Foreground="#374151"
                           Margin="0,0,0,8"/>

                                            <TextBlock Text="Description:"
                           FontSize="14"
                           Foreground="#6B7280"/>
                                            <TextBlock x:Name="ReviewDescriptionText"
                           FontSize="14"
                           Foreground="#374151"
                           TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Destination &amp; Dates"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"
                           Margin="0,0,0,12"/>

                                            <TextBlock Text="Destination:"
                           FontSize="14"
                           Foreground="#6B7280"/>
                                            <TextBlock x:Name="ReviewDestinationText"
                           FontSize="14"
                           Foreground="#374151"
                           Margin="0,0,0,8"/>

                                            <TextBlock Text="Country:"
                           FontSize="14"
                           Foreground="#6B7280"/>
                                            <TextBlock x:Name="ReviewCountryText"
                           FontSize="14"
                           Foreground="#374151"
                           Margin="0,0,0,8"/>

                                            <TextBlock Text="Start Date:"
                           FontSize="14"
                           Foreground="#6B7280"/>
                                            <TextBlock x:Name="ReviewStartDateText"
                           FontSize="14"
                           Foreground="#374151"
                           Margin="0,0,0,8"/>

                                            <TextBlock Text="End Date:"
                           FontSize="14"
                           Foreground="#6B7280"/>
                                            <TextBlock x:Name="ReviewEndDateText"
                           FontSize="14"
                           Foreground="#374151"
                           Margin="0,0,0,8"/>

                                            <TextBlock Text="Number of Days:"
                           FontSize="14"
                           Foreground="#6B7280"/>
                                            <TextBlock x:Name="ReviewNumberOfDaysText"
                           FontSize="14"
                           Foreground="#374151"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Background="#FAFBFF"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="14"
            Padding="18"
            Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock Text="Transport &amp; Accommodation"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"
                           Margin="0,0,0,12"/>

                                            <TextBlock Text="Transport:"
                           FontSize="14"
                           Foreground="#6B7280"/>
                                            <TextBlock x:Name="ReviewTransportText"
                           FontSize="14"
                           Foreground="#374151"
                           Margin="0,0,0,8"/>

                                            <TextBlock Text="Departure City:"
                           FontSize="14"
                           Foreground="#6B7280"/>
                                            <TextBlock x:Name="ReviewDepartureCityText"
                           FontSize="14"
                           Foreground="#374151"
                           Margin="0,0,0,8"/>

                                            <TextBlock Text="Stay (category):"
                           FontSize="14"
                           Foreground="#6B7280"/>
                                            <TextBlock x:Name="ReviewAccommodationTypeText"
                           FontSize="14"
                           Foreground="#374151"
                           Margin="0,0,0,8"/>

                                            <TextBlock Text="Accommodation name:"
                           FontSize="14"
                           Foreground="#6B7280"/>
                                            <TextBlock x:Name="ReviewAccommodationNameText"
                           FontSize="14"
                           Foreground="#374151"
                           Margin="0,0,0,8"/>

                                            <TextBlock Text="Meal Plan:"
                           FontSize="14"
                           Foreground="#6B7280"/>
                                            <TextBlock x:Name="ReviewMealPlanText"
                           FontSize="14"
                           Foreground="#374151"
                           Margin="0,0,0,8"/>

                                            <TextBlock Text="Available Seats:"
                           FontSize="14"
                           Foreground="#6B7280"/>
                                            <TextBlock x:Name="ReviewAvailableSeatsText"
                           FontSize="14"
                           Foreground="#374151"
                           Margin="0,0,0,8"/>

                                            <TextBlock Text="Included Services:"
                           FontSize="14"
                           Foreground="#6B7280"/>
                                            <TextBlock x:Name="ReviewServicesText"
                           FontSize="14"
                           Foreground="#374151"
                           TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Pricing Summary"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"
                           Margin="0,0,0,12"/>

                                            <TextBlock Text="Base Price:"
                           FontSize="14"
                           Foreground="#6B7280"/>
                                            <TextBlock x:Name="ReviewBasePriceText"
                           FontSize="14"
                           Foreground="#374151"
                           Margin="0,0,0,8"/>

                                            <TextBlock Text="Discount:"
                           FontSize="14"
                           Foreground="#6B7280"/>
                                            <TextBlock x:Name="ReviewDiscountText"
                           FontSize="14"
                           Foreground="#374151"
                           Margin="0,0,0,8"/>

                                            <TextBlock Text="VAT:"
                           FontSize="14"
                           Foreground="#6B7280"/>
                                            <TextBlock x:Name="ReviewVatText"
                           FontSize="14"
                           Foreground="#374151"
                           Margin="0,0,0,8"/>

                                            <TextBlock Text="Extra Charges:"
                           FontSize="14"
                           Foreground="#6B7280"/>
                                            <TextBlock x:Name="ReviewExtraChargesText"
                           FontSize="14"
                           Foreground="#374151"
                           Margin="0,0,0,8"/>

                                            <TextBlock Text="Final Price:"
                           FontSize="14"
                           Foreground="#6B7280"/>
                                            <TextBlock x:Name="ReviewFinalPriceText"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#1F2937"
                           Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Background="#F3F8FF"
            CornerRadius="14"
            Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="Ready to create package"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#1F2937"/>

                                        <TextBlock Text="Review the details above, then press Finish to create the travel package."
                       FontSize="14"
                       Foreground="#6B7280"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Bottom buttons -->
                <Grid Grid.Row="3" Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="SaveDraftButton"
                            Grid.Column="1"
                            Content="Save draft"
                            MinWidth="128"
                            Height="44"
                            Padding="18,0"
                            Background="#F1F5F9"
                            Foreground="#334155"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="SaveDraftButton_Click"/>

                    <Button x:Name="BackButton"
                            Grid.Column="3"
                            Content="Back"
                            MinWidth="108"
                            Height="44"
                            Padding="18,0"
                            Background="#E2E8F0"
                            Foreground="#64748B"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            IsEnabled="False"
                            Click="BackButton_Click"/>

                    <Button x:Name="NextButton"
                            Grid.Column="5"
                            Content="Next"
                            MinWidth="132"
                            Height="44"
                            Padding="22,0"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="NextButton_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2B8CA3" Offset="0"/>
                                <GradientStop Color="#1F5E6B" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </Grid>

                <!-- Toast (non-blocking feedback) -->
                <Border x:Name="ToastHost"
                        Grid.RowSpan="4"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,8"
                        CornerRadius="14"
                        Background="#0F172A"
                        Opacity="0"
                        Padding="14,10"
                        Panel.ZIndex="50"
                        IsHitTestVisible="False"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ToastTranslate" Y="16"/>
                    </Border.RenderTransform>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ToastIcon"
                                   FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE73E;"
                                   Foreground="#FFFFFF"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="ToastText"
                                   Foreground="#FFFFFF"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Text="Saved."
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="720"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
